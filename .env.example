# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# Athena production transport safety (server deployments)
# Direct Node HTTPS uses TLS 1.2+ with modern ciphers. Reverse proxy deployments
# must terminate HTTPS/WSS and send X-Forwarded-Proto only from a trusted proxy.
#PUBLIC_APP_URL="https://athena.example.com"
#ATHENA_ALLOWED_ORIGINS="https://athena.example.com"
#TRUST_PROXY="true"
#FORCE_HTTPS="true"
#ATHENA_HSTS_HEADER="max-age=15552000; includeSubDomains"
# Production password authentication requires a shared protected pepper file.
#ATHENA_PASSWORD_PEPPER_FILE="/run/secrets/athena_password_pepper"

# Athena AI Operations Plane (production compose overlay)
#ATHENA_OPERATIONS_SHADOW_AGENTS_ENABLED="false"
#ATHENA_OPERATIONS_SHADOW_INTERVAL_MS="60000"
#ATHENA_OPERATIONS_SHADOW_LOOKBACK_MS="900000"
#ATHENA_OPERATIONS_SHADOW_COST_THRESHOLD_MICROS="25000000"
#ATHENA_OPERATIONS_SHADOW_TOKEN_THRESHOLD="5000000"
#ATHENA_OPERATIONS_ACTIONS_ENABLED="false"
#ATHENA_OTEL_ENABLED="true"
#OTEL_SERVICE_NAME="athena-server"
#OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://otel-collector:4318/v1/traces"
#OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://otel-collector:4318/v1/logs"
#ATHENA_METRICS_TOKEN_FILE="/secure/host/path/athena-metrics-token"
#ATHENA_GRAFANA_ADMIN_USER="athena_admin"
#ATHENA_GRAFANA_ADMIN_PASSWORD="replace-with-a-long-random-secret"
#ATHENA_GRAFANA_PORT="53000"

# Athena iOS native app version policy (optional bootstrap metadata)
#ATHENA_IOS_MIN_SUPPORTED_APP_VERSION=""
#ATHENA_IOS_RECOMMENDED_APP_VERSION=""
#ATHENA_IOS_BUNDLE_ID="com.example.athena"
#ATHENA_IOS_TEAM_ID=""
#ATHENA_IOS_APP_ID_PREFIX=""
#ATHENA_IOS_UNIVERSAL_LINK_PATHS="/,/workspace/*,/reader/*,/agent/*"
#PASSKEY_RP_NAME="Athena"
#PASSKEY_RP_ID="athena.example.com"
# Authentication compatibility changes are explicit. Ordinary releases must
# keep these values stable; raise the minimum only for an incompatible auth
# protocol migration.
#ATHENA_AUTH_EPOCH="1"
#ATHENA_MINIMUM_AUTH_EPOCH="1"
#ATHENA_WEB_PROTOCOL_VERSION="1"
#ATHENA_MINIMUM_WEB_PROTOCOL_VERSION="1"
#ATHENA_AUTH_FORCE_REAUTH="false"
#PASSKEY_ORIGIN="https://athena.example.com"
#ATHENA_IOS_APNS_ENABLED="false"
#ATHENA_IOS_APNS_ENVIRONMENT="development"
#ATHENA_IOS_APNS_KEY_ID=""
#ATHENA_IOS_APNS_KEY_PATH=""

# Athena managed Responses Runtime (DeepSeek flash Chat/Agent only)
# Keep cutover disabled until the independent runtime and its contracts are ready.
#ATHENA_RESPONSES_RUNTIME_CUTOVER="false"
#ATHENA_RESPONSES_RUNTIME_URL="https://responses-runtime.internal:3034"
#ATHENA_RESPONSES_RUNTIME_TIMEOUT_MS="300000"
#ATHENA_RESPONSES_MAINTENANCE_INTERVAL_MS="3600000"
#ATHENA_RESPONSES_MAINTENANCE_TIMEOUT_MS="300000"
#ATHENA_RESPONSES_DATABASE_URL="postgresql://athena_responses_runtime:replace-me@postgresql:5432/athena_main?schema=public"
#RESPONSES_RUNTIME_PORT="3034"

# Athena outward-facing authenticated MCP resource server. Disabled by default.
#ATHENA_EXTERNAL_MCP_ENABLED="false"
#ATHENA_EXTERNAL_MCP_ISSUER="https://athena.example.com"
#ATHENA_EXTERNAL_MCP_UPSTREAM="https://external-mcp-gateway.internal:3043"
#EXTERNAL_MCP_GATEWAY_PORT="3043"

# Athena 3D Center durable session memory (owned by Chat Runtime)
#ATHENA_3D_MEMORY_ENABLED="true"
#ATHENA_3D_MEMORY_CONTEXT_BUDGET_TOKENS="950000"
#ATHENA_3D_MEMORY_COMPRESSION_TRIGGER_TOKENS="850000"
#ATHENA_3D_MEMORY_HARD_GATE_TOKENS="920000"
#ATHENA_3D_MEMORY_COMPRESSION_TRIGGER_TURNS="512"
#ATHENA_3D_MEMORY_CHECKPOINT_MAX_TOKENS="24000"
# 3D Center Memory Fast Lane: direct JSON, no AICP/signature/encryption.
# Bind loopback for a shared process namespace; in containers use the private
# service-network address and never publish this port externally.
#ATHENA_3D_FAST_LANE_ENABLED="true"
#ATHENA_3D_FAST_LANE_HOST="127.0.0.1"
#ATHENA_3D_MEMORY_FAST_LANE_PORT="3116"
#ATHENA_3D_MEMORY_FAST_LANE_URL="http://127.0.0.1:3116"
#ATHENA_3D_MEMORY_STATE_WINDOW_MAX_TOKENS="128000"
#ATHENA_3D_MEMORY_JOB_LEASE_MS="120000"
#ATHENA_3D_MEMORY_JOB_MAX_ATTEMPTS="5"
#ATHENA_3D_LONG_TERM_MEMORY_JOB_MAX_ATTEMPTS="3"
#ATHENA_3D_LONG_TERM_MEMORY_CONTEXT_MAX_TOKENS="32000"
#ATHENA_3D_MEMORY_MAINTENANCE_INTERVAL_MS="5000"
#ATHENA_MODEL_GATEWAY_MAX_REQUEST_BYTES="8388608"
#ATHENA_MODEL_GATEWAY_JSON_LIMIT="10mb"
