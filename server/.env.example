SERVER_PORT=3001
APP_ENV=production # production | development
# Unified cross-device state tree. Enable after applying Prisma migrations.
ATHENA_SYNC_V2_ENABLED=false
# Internal shadow state-tree Outbox dispatch is independent of client rollout.
# Keep enabled to avoid durable event accumulation while cohorts are at 0%.
ATHENA_SYNC_V2_OUTBOX_DISPATCH=true
# SYNC_V2_OUTBOX_INTERVAL_MS=5000 # Default: 250ms active clients, 5s shadow-only.
ATHENA_SYNC_V2_DOMAINS=core # Optional staged domains: security,memory,cognition,agents,meetings,documents,tasks,workflows,notifications,entitlements,integrations.
# ATHENA_SYNC_V2_ROLLOUT_PERCENT=0 # Deterministic user+device cohort; raise gradually.
# ATHENA_SYNC_V2_DOMAIN_ROLLOUTS=security:0,chat:10,core:25
# ATHENA_SYNC_V2_RETENTION_MS=2592000000 # 30 days
# ATHENA_SYNC_V2_HASH_SAMPLE_PERCENT=1 # Daily deterministic domain Hash verification sample.
# ATHENA_SYNC_MUTATION_BATCH_CONCURRENCY=4 # Independent nodes run in parallel; same-node mutations remain ordered. Set 1 to roll back.
JWT_SECRET="my-random-string-for-seeding" # Please generate random string at least 12 chars long.
# JWT_EXPIRY="30d" # (optional) https://docs.anythingllm.com/configuration#custom-ttl-for-sessions
SIG_KEY='passphrase' # Please generate random string at least 32 chars long.
SIG_SALT='salt' # Please generate random string at least 32 chars long.

# Security encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=
# Required in production. Mount the same protected 32+ byte pepper file for
# every runtime that reads the shared auth database (mode 0400 or 0600).
# ATHENA_PASSWORD_PEPPER_FILE=/run/secrets/athena_password_pepper
# Key Custody provider: env-file (default), secret-file, or environment.
# For Docker/Kubernetes prefer a mounted 0400/0600 secret file:
# ATHENA_KEY_PROVIDER=secret-file
# ATHENA_MASTER_KEY_FILE=/run/secrets/athena_master_key

# Crypto Gate.io read-only probe
# Gate API credentials must be encrypted with server/utils/security saveSecret().
# Never expose raw keys to the frontend, logs, git diffs, or API responses.
GATE_CRYPTO_ENABLED=false
GATE_API_ENV=production
GATE_API_READONLY=true
GATE_API_KEY_ENCRYPTED=
GATE_API_SECRET_ENCRYPTED=
GATE_PROBE_SPOT_PAIR=BTC_USDT
# Account-scoped private crypto access is the default. Legacy process-level
# credentials remain read-only fallback for the unique Primary Owner only
# during migration and must not start a shared private background runtime.
ATHENA_CRYPTO_ACCOUNT_SCOPED=true
ATHENA_CRYPTO_LEGACY_FALLBACK=true
CRYPTO_HUB_LEGACY_BACKGROUND_ENABLED=false

# Default read-only Agent market data tools.
# Values must be encrypted with server/utils/security saveSecret().
QWEATHER_API_KEY_ENCRYPTED=
JUHE_STOCK_API_KEY_ENCRYPTED=
JUHE_FOREX_API_KEY_ENCRYPTED=

