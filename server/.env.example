# AGENT_SEARCHAPI_ENGINE=google

#------ Serper.dev ----------- https://serper.dev/
# AGENT_SERPER_DEV_KEY=

#------ Bing Search ----------- https://portal.azure.com/
# AGENT_BING_SEARCH_API_KEY=

#------ Baidu Search ----------- https://cloud.baidu.com/doc/qianfan-api/s/Wmbq4z7e5
# AGENT_BAIDU_SEARCH_API_KEY=

#------ Serply.io ----------- https://serply.io/
# AGENT_SERPLY_API_KEY=

#------ SearXNG ----------- https://github.com/searxng/searxng
# AGENT_SEARXNG_API_URL=

#------ Tavily ----------- https://www.tavily.com/
# AGENT_TAVILY_API_KEY=

#------ Exa Search ----------- https://www.exa.ai/
# AGENT_EXA_API_KEY=

#------ Perplexity Search ----------- [https://console.perplexity.ai](https://console.perplexity.ai)
# AGENT_PERPLEXITY_API_KEY=

###########################################
######## Other Configurations ############
###########################################

# Disable viewing chat history from the UI and frontend APIs.
# See https://docs.anythingllm.com/configuration#disable-view-chat-history for more information.
# DISABLE_VIEW_CHAT_HISTORY=1

# Set to false to roll back to full chat Hash Chain rebuilds after each append.
CHAT_HISTORY_INCREMENTAL_CHAIN_APPEND=true

# Set to false to rebuild the full chain after edits, deletes, and chat moves.
CHAT_HISTORY_SUFFIX_CHAIN_REBUILD=true

# Enable simple SSO passthrough to pre-authenticate users from a third party service.
# See https://docs.anythingllm.com/configuration#simple-sso-passthrough for more information.
# SIMPLE_SSO_ENABLED=1
# SIMPLE_SSO_NO_LOGIN=1
# SIMPLE_SSO_NO_LOGIN_REDIRECT=https://your-custom-login-url.com (optional)

# Allow scraping of any IP address in collector - must be string "true" to be enabled
# See https://docs.anythingllm.com/configuration#local-ip-address-scraping for more information.
# COLLECTOR_ALLOW_ANY_IP="true"

# Optional override for the internal document collector endpoint.
# Default is http://localhost:8888 in development and http://0.0.0.0:8888 in production.
# COLLECTOR_ENDPOINT=http://localhost:8888
# Distributed production service identities. Enabling this flag is fail-closed:
# Collector, Realtime Gateway, and Background Worker require TLS 1.3 mTLS
# certificates with URI SAN spiffe://athena/<environment>/<role>.
# ATHENA_SERVICE_MTLS_REQUIRED=false
# ATHENA_SERVICE_ID=spiffe://athena/production/api
# ATHENA_API_MTLS_CA_FILE=/run/secrets/athena_service_ca.pem
# ATHENA_API_MTLS_CERT_FILE=/run/secrets/athena_api_client.pem
# ATHENA_API_MTLS_KEY_FILE=/run/secrets/athena_api_client.key
# ATHENA_API_MTLS_NEXT_CERT_FILE=/run/secrets/athena_api_client_next.pem
# ATHENA_API_MTLS_NEXT_KEY_FILE=/run/secrets/athena_api_client_next.key
# ATHENA_API_MTLS_SERVER_NAME=collector.internal
# ATHENA_MTLS_MIN_REMAINING_MS=300000
# ATHENA_MTLS_ROTATION_SWITCH_MS=86400000
# Apple App Attest binds the registered P-256, ML-DSA-65 and hybrid KEM keys
# to an authentic iOS/iPadOS application instance. The verifier is an internal
# mTLS service; raw Apple attestation objects are never written to Athena DBs.
# ATHENA_DEVICE_ATTESTATION_MODE=off # off | observe | required
# ATHENA_APP_ATTEST_APP_ID=TEAMID.com.example.athena
# ATHENA_APP_ATTEST_VERIFIER_URL=https://app-attest-verifier.internal/v1/verify
# Key rotation requires a distinct approver in production. This controls only
# the approval-window duration and never disables maker-checker enforcement.
# ATHENA_KEY_ROTATION_APPROVAL_TTL_MS=3600000
# Phase 4 enforces a 30-day production minimum regardless of a lower value.
# Development defaults to 24 hours; tests may explicitly set zero.
# ATHENA_KEY_DECRYPT_ONLY_OBSERVATION_MS=2592000000
# Closure evidence is valid for at most seven days in production.
# ATHENA_KEY_CLOSURE_EVIDENCE_MAX_AGE_MS=604800000
# Athena managed Responses Runtime (DeepSeek flash Chat/Agent only)
# ATHENA_RESPONSES_RUNTIME_CUTOVER=false
# ATHENA_RESPONSES_RUNTIME_URL=https://responses-runtime.internal:3034
# ATHENA_RESPONSES_RUNTIME_TIMEOUT_MS=300000
# ATHENA_RESPONSES_MAINTENANCE_INTERVAL_MS=3600000
# ATHENA_RESPONSES_MAINTENANCE_TIMEOUT_MS=300000
# ATHENA_RESPONSES_DATABASE_URL=postgresql://athena_responses_runtime:replace-me@postgresql:5432/athena_main?schema=public
# RESPONSES_RUNTIME_PORT=3034

# Production audit/release hybrid signatures require Node 24 and separately
# provisioned ML-DSA-65 keys. Existing classical keys are never overwritten.
# The enterprise release gate refuses to start on Node 18/22 or on a Node 24
# build without all four declared provider capabilities.
# ATHENA_REQUIRE_NODE24_PQ_PROBE=true
# ATHENA_PQ_RUNTIME_EXPECTED_CAPABILITIES=ml_kem_768,ml_dsa_65,encapsulation_api,classical_provider_baseline
# ATHENA_AUDIT_HYBRID_SIGNATURES=required
# ATHENA_AUDIT_MLDSA65_KEY_ID=audit-mldsa65-primary
# ATHENA_AUDIT_MLDSA65_PRIVATE_KEY_FILE=/run/secrets/audit_mldsa65_private.pem
# ATHENA_AUDIT_MLDSA65_PUBLIC_KEY_FILE=/run/secrets/audit_mldsa65_public.pem
# ATHENA_AUDIT_MLDSA65_HARDWARE_PROTECTION=hsm-or-kms
# ATHENA_RELEASE_EVIDENCE_HYBRID_REQUIRED=true
# ATHENA_EDGE_SECURITY_EVIDENCE_FILE=/run/evidence/edge.json
# ATHENA_EDGE_SECURITY_EVIDENCE_PUBLIC_KEY_FILE=/run/evidence/edge-ed25519.pem
# ATHENA_EDGE_SECURITY_EVIDENCE_MLDSA65_PUBLIC_KEY_FILE=/run/evidence/edge-mldsa65.pem
# ATHENA_DR_EVIDENCE_FILE=/run/evidence/dr.json
# ATHENA_DR_EVIDENCE_PUBLIC_KEY_FILE=/run/evidence/dr-ed25519.pem
# ATHENA_DR_EVIDENCE_MLDSA65_PUBLIC_KEY_FILE=/run/evidence/dr-mldsa65.pem
# ATHENA_IOS_HIGH_RISK_PQ_REQUIRED=true
# ATHENA_EXTERNAL_AGENT_MLDSA_REQUIRED=true
# ATHENA_AGENT_MLDSA65_KEY_ID=agent-registry-mldsa65-primary
# ATHENA_AGENT_MLDSA65_PRIVATE_KEY_FILE=/run/secrets/agent_mldsa65_private.pem
# ATHENA_AGENT_MLDSA65_PUBLIC_KEY_FILE=/run/secrets/agent_mldsa65_public.pem

# Optional overrides for the official OpenClaw Weixin connector.
# OPENCLAW_BIN=openclaw
# OPENCLAW_WEIXIN_HOME=/Users/you/.openclaw/openclaw-weixin

# Specify the target languages for when using OCR to parse images and PDFs.
# This is a comma separated list of language codes as a string. Unsupported languages will be ignored.
# Default is English. See https://tesseract-ocr.github.io/tessdoc/Data-Files-in-different-versions.html for a list of valid language codes.
# TARGET_OCR_LANG=eng,deu,ita,spa,fra,por,rus,nld,tur,hun,pol,ita,spa,fra,por,rus,nld,tur,hun,pol

# Runtime flags for built-in pupeeteer Chromium instance
# This is only required on Linux machines running AnythingLLM via Docker
# and do not want to use the --cap-add=SYS_ADMIN docker argument
# ANYTHINGLLM_CHROMIUM_ARGS="--no-sandbox,--disable-setuid-sandbox"

# This enables HTTP request/response logging in development. Set value to a truthy string to enable, leave empty value or comment out to disable.
# ENABLE_HTTP_LOGGER=""
# This enables timestamps for the HTTP Logger. Set value to a truthy string to enable, leave empty value or comment out to disable.
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""

# Disable Swagger API documentation endpoint.
# Set to "true" to disable the /api/docs endpoint (recommended for production deployments).
# DISABLE_SWAGGER_DOCS="true"

# Disable MCP cooldown timer for agent calls
# this can lead to infinite recursive calls of the same function
# for some model/provider combinations
# MCP_NO_COOLDOWN="true

# Allow native tool calling for specific providers.
# This can VASTLY improve performance and speed of agent calls.
# Check code for supported providers who can be enabled here via this flag
# PROVIDER_SUPPORTS_NATIVE_TOOL_CALLING="generic-openai,bedrock,localai,groq,litellm,openrouter"

# (optional) Maximum number of tools an agent can chain for a single response.
# This prevents some lower-end models from infinite recursive tool calls.
# AGENT_MAX_TOOL_CALLS=10

# Enable agent tool reranking to reduce token usage by selecting only the most relevant tools
# for each query. Uses the native embedding reranker to score tools against the user's prompt.
# Set to "true" to enable. This can reduce token costs by 80% when you have
# many tools/MCP servers enabled.
# AGENT_SKILL_RERANKER_ENABLED="true"
# AGENT_SKILL_RERANKER_TOP_N=15 # (optional) Number of top tools to keep after reranking (default: 15)

# (optional) Maximum number of scheduled jobs that can run concurrently.
# Default is 1. Increase if using a cloud LLM provider with high rate limits.
# SCHEDULED_JOB_MAX_CONCURRENT=1

# (optional) Maximum time in milliseconds a scheduled job can run before being terminated.
# Default is 5 minutes (300000ms).
# SCHEDULED_JOB_TIMEOUT_MS=300000

# Knowledge Graph repair worker.
# The worker restores graph health only. It does not change retrieval behavior
# and does not automatically re-embed documents.
# KNOWLEDGE_GRAPH_REPAIR_ENABLED=true
# KNOWLEDGE_GRAPH_REPAIR_INTERVAL=6hr
# KNOWLEDGE_GRAPH_REPAIR_BATCH_SIZE=25
# KNOWLEDGE_GRAPH_REPAIR_SCAN_LIMIT=100
# KNOWLEDGE_GRAPH_REPAIR_TOKEN_BUDGET=60000

# Thread compaction memory folds older workspace/thread chat history into a
# deterministic Conversation State Capsule. Auto mode is off by default while
# capsule quality and Agent stability are validated via the manual compact endpoint.
THREAD_COMPACTION_ENABLED=true
THREAD_COMPACTION_AUTO_ENABLED=false
THREAD_COMPACTION_TRIGGER_RATIO=0.65
THREAD_COMPACTION_KEEP_RECENT_MESSAGES=10
THREAD_COMPACTION_MAX_SUMMARY_TOKENS=2500
# Legacy LLM task overrides. Prefer LLM_TASK_ROUGH_PROVIDER / LLM_TASK_ROUGH_MODEL.
# Blank values use the rough task model; compaction does not fall back to the workspace chat model.
THREAD_COMPACTION_PROVIDER=
THREAD_COMPACTION_MODEL=
THREAD_COMPACTION_CONTEXT_WINDOW_TOKENS=400000
THREAD_COMPACTION_TARGET_BASE=
THREAD_COMPACTION_TARGET_ABSOLUTE_TOKENS=150000
THREAD_COMPACTION_MANUAL_TARGET_RATIO=0.2
THREAD_COMPACTION_AUTO_TARGET_RATIO=0.2
THREAD_COMPACTION_TARGET_MIN_SUMMARY_TOKENS=12000
THREAD_COMPACTION_TARGET_MAX_SUMMARY_TOKENS=60000
THREAD_COMPACTION_TARGET_SUMMARY_BUDGET_RATIO=0.5
THREAD_COMPACTION_MIN_KEEP_RECENT_MESSAGES=1
# KNOWLEDGE_GRAPH_REPAIR_PROVIDER_BUDGET=25
# KNOWLEDGE_GRAPH_REPAIR_MAX_DURATION_MS=480000

# Knowledge Graph node importance radar metrics worker.
# Recomputes only stale or missing KnowledgeNodeMetrics rows. It does not call
# an LLM, does not change retrieval behavior, and uses a DB lock to avoid
# duplicate worker writes.
# KNOWLEDGE_NODE_METRICS_RECOMPUTE_ENABLED=true
# KNOWLEDGE_NODE_METRICS_RECOMPUTE_INTERVAL=1hr
# KNOWLEDGE_NODE_METRICS_RECOMPUTE_BATCH_SIZE=200
# KNOWLEDGE_NODE_METRICS_LOCK_TTL_MS=900000

# (optional) Comma-separated list of skills that are auto-approved.
# This will allow the skill to be invoked without user interaction.
# AGENT_AUTO_APPROVED_SKILLS=create-pdf-file,create-word-file

# ZK Login / OPAQUE trusted-device quick login.
# Required in production. Generate with:
# npx @serenity-kit/opaque@latest create-server-setup
# OPAQUE_SERVER_SETUP=""
# P0 request ingress hardening. Set false only for a temporary rollback.
ATHENA_REQUEST_LIMITS_V2='true'
ATHENA_SESSION_V2='true'
ATHENA_GRACEFUL_SHUTDOWN_V2='true'
# P0 continuous realtime authorization. Web clients exchange their REST session
# for a 90-second one-time WS ticket; native clients may keep using an
# Authorization header. Production defaults to authoritative sessions, strict
# readiness, and no raw JWT query compatibility.
# ATHENA_REALTIME_REQUIRE_SESSION='true'
# ATHENA_REALTIME_TICKET_TTL_MS=90000
# ATHENA_REALTIME_TICKET_STORE='database'
# ATHENA_REALTIME_REVALIDATE_MS=5000
# ATHENA_REALTIME_LEGACY_QUERY_TOKEN='false'
# Required only for a bounded legacy rollout; must expire within 30 days.
# ATHENA_REALTIME_LEGACY_QUERY_TOKEN_EXPIRES_AT='2026-08-19T00:00:00.000Z'
# ATHENA_STRICT_READY='true'
# Workspace rag-memory writes always require per-call user approval. Set off to
# disable writes while preserving workspace vector search.
# ATHENA_RAG_MEMORY_STORE='approval' # approval | off
# P1 scale readiness. Production defaults to capability enforcement; development
# defaults to warning mode while existing MCP manifests are upgraded.
# ATHENA_PLUGIN_SECURITY_V2='enforce' # off | warn | enforce
# SYNC_V2_OUTBOX_LEASE_MS=30000
# SYNC_V2_OUTBOX_MAX_ATTEMPTS=8
# SYNC_V2_OUTBOX_LANE_CONCURRENCY=4
# SYNC_V2_OUTBOX_RETRY_BASE_MS=500
# SYNC_V2_OUTBOX_RETRY_MAX_MS=300000
# ATHENA_SECURITY_AUDIT_CHECKPOINT_INTERVAL=100
# ATHENA_SECURITY_AUDIT_CHECKPOINT_MAX_AGE_MS=3600000
# ATHENA_METRICS_TOKEN= # Required for non-loopback production Prometheus scrapes.
# ATHENA_OTEL_ENABLED='false'
# OTEL_SERVICE_NAME=athena-server
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# Distributed cloud runtime. Desktop/offline keeps the sqlite/memory/local defaults.
# ATHENA_RUNTIME_TOPOLOGY=distributed
# ATHENA_DATABASE_PROVIDER=postgresql
# ATHENA_POSTGRES_MAIN_URL=postgresql://role:password@postgresql:5432/athena_main
# ATHENA_POSTGRES_AUTH_URL=postgresql://role:password@postgresql:5432/athena_auth
# ATHENA_DATABASE_MIGRATION_MODE=off # off | shadow | cutover | reverse-shadow
# ATHENA_BROADCAST_TRANSPORT=nats
# ATHENA_NATS_SERVERS=tls://nats:4222
# ATHENA_NATS_CREDENTIALS_FILE=/run/secrets/athena_nats.creds
# ATHENA_NATS_TLS_CA_FILE=/run/secrets/athena_nats_ca.pem
# ATHENA_NATS_TLS_CERT_FILE=/run/secrets/athena_nats_client.pem
# ATHENA_NATS_TLS_KEY_FILE=/run/secrets/athena_nats_client.key
# ATHENA_NATS_TLS_SERVER_NAME=nats.internal
# ATHENA_NATS_CONSUMER_NAME=api-zone-a-1
# AI Operations Plane. Reuses the production NATS workload identity above and
# writes metadata-only Semantic Event v1 records to ClickHouse.
# ATHENA_OPERATIONS_ENABLED=false
# ATHENA_OPERATIONS_NATS_STREAM=ATHENA_OPERATIONS
# ATHENA_OPERATIONS_NATS_SUBJECT=operations.semantic.v1
# ATHENA_OPERATIONS_NATS_CONSUMER=athena-operations-clickhouse
# ATHENA_OPERATIONS_NATS_DLQ_STREAM=ATHENA_OPERATIONS_DLQ
# ATHENA_OPERATIONS_NATS_DLQ_SUBJECT=operations.dead-letter.v1
# ATHENA_OPERATIONS_NATS_MAX_BYTES=4294967296
# ATHENA_OPERATIONS_BATCH_MAX_MESSAGES=256
# ATHENA_OPERATIONS_BATCH_MAX_BYTES=1048576
# ATHENA_OPERATIONS_BATCH_MAX_WAIT_MS=1000
# ATHENA_OPERATIONS_ACK_WAIT_MS=60000
# ATHENA_OPERATIONS_WORKING_INTERVAL_MS=20000
# ATHENA_OPERATIONS_CIRCUIT_BASE_DELAY_MS=5000
# ATHENA_OPERATIONS_CIRCUIT_MAX_DELAY_MS=120000
# Read-only Operations Agents. These emit advisory findings and evaluation
# metrics only; no production action executor is registered.
# ATHENA_OPERATIONS_SHADOW_AGENTS_ENABLED=false
# ATHENA_OPERATIONS_SHADOW_INTERVAL_MS=60000
# ATHENA_OPERATIONS_SHADOW_LOOKBACK_MS=900000
# ATHENA_OPERATIONS_SHADOW_COST_THRESHOLD_MICROS=25000000
# ATHENA_OPERATIONS_SHADOW_TOKEN_THRESHOLD=5000000
# Enables the human-approved Action Catalog. Agents can only propose actions.
# ATHENA_OPERATIONS_ACTIONS_ENABLED=false
# ATHENA_CLICKHOUSE_URL=http://clickhouse:8123
# ATHENA_CLICKHOUSE_DATABASE=athena_operations
# ATHENA_CLICKHOUSE_USER=athena_ops
# ATHENA_CLICKHOUSE_PASSWORD_FILE=/run/secrets/athena_clickhouse_password
# ATHENA_CLICKHOUSE_TIMEOUT_MS=5000
# ATHENA_CLICKHOUSE_ASYNC_INSERT_BUSY_TIMEOUT_MS=250
# ATHENA_CHAT_CONTENT_OBJECTS=off # off | shadow | write | read
# ATHENA_CONTENT_STORE=local # local | s3
# ATHENA_S3_BUCKET=
# ATHENA_S3_REGION=
# ATHENA_S3_ENDPOINT= # Optional MinIO endpoint.
# ATHENA_S3_PREFIX=athena/content-objects
# ATHENA_S3_FORCE_PATH_STYLE=false
# ATHENA_SECURITY_AUDIT_ARCHIVE_ENABLED=false
# ATHENA_SECURITY_AUDIT_ARCHIVE_PROVIDER=s3
# ATHENA_SECURITY_AUDIT_OBJECT_LOCK_DAYS=2555
# ATHENA_SECURITY_SIEM_URL=https://siem.internal/v1/athena/security-audit
# ATHENA_SECURITY_SIEM_HMAC_KEY_FILE=/run/secrets/athena_siem_hmac
# ATHENA_KEY_PROVIDER=vault-agent # vault-agent | kms-sidecar | secret-file
# ATHENA_KEY_LEASE_FILE=/run/secrets/athena_key_lease.json
# ATHENA_KEY_LEASE_MAX_TTL_MS=3600000
# ATHENA_KEY_LEASE_AUDIENCE=spiffe://athena/production/api
# ATHENA_ENTERPRISE_RELEASE_GATE=true
# ATHENA_EDGE_SECURITY_EVIDENCE_FILE=/run/evidence/edge.json
# ATHENA_EDGE_SECURITY_EVIDENCE_PUBLIC_KEY_FILE=/run/evidence/edge-ed25519.pem
# ATHENA_DR_EVIDENCE_FILE=/run/evidence/disaster-recovery.json
# ATHENA_DR_EVIDENCE_PUBLIC_KEY_FILE=/run/evidence/dr-ed25519.pem
# ATHENA_AI_GOVERNANCE=off # off | observe | enforce
# ATHENA_RETENTION_ENABLED=false
# ATHENA_SESSION_V2_REQUIRE_MULTI='true'
# Bounded maintenance is opt-in until retention windows have been reviewed.
ATHENA_RETENTION_ENABLED=false
ATHENA_PATROL_RETENTION_DAYS=30
ATHENA_EVENT_LOG_RETENTION_DAYS=180
ATHENA_CONTENT_STAGING_RETENTION_HOURS=24
ATHENA_CONTENT_DELETE_GRACE_DAYS=7
ATHENA_RETENTION_BATCH_SIZE=100

# Athena 3D Center durable session memory (owned by Chat Runtime)
ATHENA_3D_MEMORY_ENABLED='true'
ATHENA_3D_MEMORY_CONTEXT_BUDGET_TOKENS='950000'
ATHENA_3D_MEMORY_COMPRESSION_TRIGGER_TOKENS='850000'
ATHENA_3D_MEMORY_HARD_GATE_TOKENS='920000'
ATHENA_3D_MEMORY_COMPRESSION_TRIGGER_TURNS='512'
ATHENA_3D_MEMORY_CHECKPOINT_MAX_TOKENS='24000'
ATHENA_3D_MEMORY_STATE_WINDOW_MAX_TOKENS='128000'
ATHENA_3D_MEMORY_JOB_LEASE_MS='120000'
ATHENA_3D_MEMORY_JOB_MAX_ATTEMPTS='5'
ATHENA_3D_LONG_TERM_MEMORY_JOB_MAX_ATTEMPTS='3'
ATHENA_3D_LONG_TERM_MEMORY_CONTEXT_MAX_TOKENS='32000'
ATHENA_3D_MEMORY_MAINTENANCE_INTERVAL_MS='5000'
ATHENA_MODEL_GATEWAY_MAX_REQUEST_BYTES='8388608'
ATHENA_MODEL_GATEWAY_JSON_LIMIT='10mb'
ATHENA_3D_CONTEXT_CACHE_TTL_MS='900000'
ATHENA_3D_CONTEXT_CACHE_MAX_SLOTS='16'
ATHENA_3D_CONTEXT_CACHE_MAX_BYTES='201326592'
ATHENA_3D_CONTEXT_CACHE_SLOT_MAX_BYTES='33554432'
ATHENA_3D_CONTEXT_FAST_LANE_PORT='3118'
ATHENA_3D_CONTEXT_FAST_LANE_URL='http://127.0.0.1:3118'
ATHENA_3D_CONTEXT_FAST_LANE_JSON_LIMIT='48mb'
# Optional read-only target for the edge-owned hybrid TLS evaluation probe.
# The application server never changes TLS negotiation based on this value.
# ATHENA_EDGE_HYBRID_TLS_EVALUATION_HOST='pq-edge.example.test'
# Shared, non-secret counter file written by the edge probe and read by the API.
# Configure it only on the API runtime to avoid duplicate ingestion.
# ATHENA_CRYPTO_OBSERVATION_FILE='/var/lib/athena/crypto-observations.json'
# Fixed names only: ml_kem_768,ml_dsa_65,encapsulation_api,classical_provider_baseline.
# Non-enterprise Node 18/22 compatibility deployments may declare only the
# classical baseline. Enterprise production must declare all four above.
# ATHENA_PQ_RUNTIME_EXPECTED_CAPABILITIES='classical_provider_baseline'
# ATHENA_IOS_PQ_EXPERIMENTS='false'
