# CLOUD DEPLOYMENT VARIRABLES ONLY
# AUTH_TOKEN="hunter2" # This is the password to your application if remote hosting.
# STORAGE_DIR= # absolute base filesystem path with no trailing slash. Runtime data is stored under STORAGE_DIR/APP_ENV.

###########################################
######## PASSWORD COMPLEXITY ##############
###########################################
# Enforce a password schema for your organization users.
# Documentation on how to use https://github.com/kamronbatman/joi-password-complexity
#PASSWORDMINCHAR=8
#PASSWORDMAXCHAR=250
#PASSWORDLOWERCASE=1
#PASSWORDUPPERCASE=1
#PASSWORDNUMERIC=1
#PASSWORDSYMBOL=1
#PASSWORDREQUIREMENTS=4

###########################################
######## EMAIL VERIFICATION SMTP ##########
###########################################
# Official outbound channel for account email binding, password reset codes,
# and security notifications. Tencent Exmail example:
# EMAIL_SMTP_HOST="smtp.exmail.qq.com"
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER="noreply@your-domain.com"
# EMAIL_SMTP_PASSWORD="your-exmail-smtp-password"
# EMAIL_SMTP_FROM="noreply@your-domain.com"
# EMAIL_SMTP_SECURE=true
# EMAIL_VERIFICATION_IP_HOURLY_LIMIT=20
# EMAIL_VERIFICATION_USERNAME_HOURLY_LIMIT=5

###########################################
######## PASSKEY / WEBAUTHN ###############
###########################################
# Optional but recommended for production deployments.
# PASSKEY_RP_NAME="Athena"
# PASSKEY_RP_ID="athena.example.com"
# PASSKEY_ORIGIN="https://athena.example.com"

###########################################
######## ENABLE HTTPS SERVER ##############
###########################################
# By enabling this and providing the path/filename for the key and cert,
# the server will use HTTPS instead of HTTP.
#ENABLE_HTTPS="true"
#HTTPS_CERT_PATH="sslcert/cert.pem"
#HTTPS_KEY_PATH="sslcert/key.pem"

