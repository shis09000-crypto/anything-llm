###########################################
######## PASSWORD COMPLEXITY ##############
###########################################
# Enforce a password schema for your organization users.
# Documentation on how to use https://github.com/kamronbatman/joi-password-complexity
#PASSWORDMINCHAR=8
#PASSWORDMAXCHAR=250
#PASSWORDLOWERCASE=1
#PASSWORDUPPERCASE=1
#PASSWORDNUMERIC=1
#PASSWORDSYMBOL=1
#PASSWORDREQUIREMENTS=4

###########################################
######## EMAIL VERIFICATION SMTP ##########
###########################################
# Official outbound channel for account email binding, password reset codes,
# and security notifications. Tencent Exmail example:
# EMAIL_SMTP_HOST="smtp.exmail.qq.com"
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER="noreply@your-domain.com"
# EMAIL_SMTP_PASSWORD="your-exmail-smtp-password"
# EMAIL_SMTP_FROM="noreply@your-domain.com"
# EMAIL_SMTP_SECURE=true
# EMAIL_VERIFICATION_HMAC_SECRET="generate-a-random-32-byte-secret"
# EMAIL_VERIFICATION_IP_HOURLY_LIMIT=20
# EMAIL_VERIFICATION_USERNAME_HOURLY_LIMIT=5
# EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
# EMAIL_VERIFICATION_DEVICE_HOURLY_LIMIT=10

###########################################
######## PASSKEY / WEBAUTHN ###############
###########################################
# Optional but recommended for production deployments.
# PASSKEY_RP_NAME="Athena"
# PASSKEY_RP_ID="athena.example.com"
# Authentication compatibility changes are explicit. Ordinary releases must
# keep these values stable; raise the minimum only for an incompatible auth
# protocol migration.
# ATHENA_AUTH_EPOCH="1"
# ATHENA_MINIMUM_AUTH_EPOCH="1"
# ATHENA_WEB_PROTOCOL_VERSION="1"
# ATHENA_MINIMUM_WEB_PROTOCOL_VERSION="1"
# ATHENA_AUTH_FORCE_REAUTH="false"
# PASSKEY_ORIGIN="https://athena.example.com"

###########################################
######## ENABLE HTTPS SERVER ##############
###########################################
# By enabling this and providing the path/filename for the key and cert,
# the server will use HTTPS instead of HTTP.
#ENABLE_HTTPS="true"
#HTTPS_CERT_PATH="sslcert/cert.pem"
#HTTPS_KEY_PATH="sslcert/key.pem"

# Production transport safety.
# In production, Athena must either run this Node server directly with HTTPS
# enabled above, or run behind a trusted HTTPS/WSS reverse proxy.
# Direct Node production HTTPS defaults to TLS 1.3. Reverse proxy mode
# trusts X-Forwarded-Proto only when TRUST_PROXY is enabled.
#ATHENA_TLS_MIN_VERSION="TLSv1.3"
#PUBLIC_APP_URL="https://athena.example.com"
#ATHENA_ALLOWED_ORIGINS="https://athena.example.com"
#TRUST_PROXY="true"
#FORCE_HTTPS="true"
#ATHENA_HSTS_HEADER="max-age=15552000; includeSubDomains"

