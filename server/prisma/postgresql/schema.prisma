generator mainClient {
  provider = "prisma-client-js"
  output   = "../../generated/postgresql-main"
}

generator authClient {
  provider = "prisma-client-js"
  output   = "../../generated/postgresql-auth"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_keys {
  id            Int      @id @default(autoincrement())
  name          String?
  secret        String?  @unique
  createdBy     Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model workspace_documents {
  id                    Int                   @id @default(autoincrement())
  docId                 String                @unique
  filename              String
  docpath               String
  workspaceId           Int
  metadata              String?
  pinned                Boolean?              @default(false)
  watched               Boolean?              @default(false)
  embeddingStatus       String                @default("completed")
  embeddingError        String?
  embeddingBatchJobId   String?
  createdAt             DateTime              @default(now())
  lastUpdatedAt         DateTime              @default(now())
  workspace             workspaces            @relation(fields: [workspaceId], references: [id])
  document_sync_queues  document_sync_queues?
  node_supplements      NodeSupplement[]
  workspace_supplements WorkspaceSupplement[]
}

model WorkspaceVisualAsset {
  id           Int       @id @default(autoincrement())
  workspaceId  Int
  scopeType    String    @default("workspace")
  nodeKey      String?
  nodeLabel    String?
  nodeType     String?
  role         String    @default("hero_background")
  filename     String
  mime         String
  size         Int       @default(0)
  metadataJson String    @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, scopeType, role])
}

model WorkspaceOverviewNarrative {
  id              Int       @id @default(autoincrement())
  workspaceId     Int       @unique
  tagline         String?
  sourceHash      String    @default("")
  model           String?
  promptVersion   String    @default("workspace-overview-tagline-v2")
  status          String    @default("empty")
  errorType       String?
  metadataJson    String    @default("{}")
  lastGeneratedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model NodeSupplement {
  id           Int                 @id @default(autoincrement())
  workspaceId  Int
  nodeId       Int?
  nodeKey      String
  nodeLabel    String
  nodeType     String              @default("concept")
  documentId   String
  documentName String
  priority     Int                 @default(0)
  metadata     String              @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  document     workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, nodeKey, documentId])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, nodeId])
}

model WorkspaceSupplement {
  id                Int                 @id @default(autoincrement())
  workspaceId       Int
  scopeType         String              @default("workspace")
  primaryDocumentId String              @default("__workspace__")
  documentId        String
  documentName      String
  supplementKind    String              @default("other")
  priority          Int                 @default(0)
  metadata          String              @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  document          workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, scopeType, primaryDocumentId, documentId])
  @@index([workspaceId, scopeType, supplementKind])
  @@index([workspaceId, documentId])
}

model WorkspaceKnowledgeProfile {
  id                     Int       @id @default(autoincrement())
  workspaceId            Int       @unique
  profileType            String    @default("mixed")
  confidence             Float     @default(0)
  primaryDocumentIdsJson String    @default("[]")
  mainTopic              String?
  detectedStructureJson  String    @default("{}")
  suggestedGraphStrategy String?
  profileVersion         String    @default("workspace-profile-v1")
  manualOverride         Boolean   @default(false)
  overrideSource         String?
  overrideReason         String?
  originalProfileType    String?
  originalConfidence     Float?
  userDescription        String?
  metadataJson           String    @default("{}")
  lastAnalyzedAt         DateTime?
  nextRefreshAfter       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([workspaceId])
  @@index([profileType])
  @@index([nextRefreshAfter])
}

model BookStructureAnalysis {
  id                       Int       @id @default(autoincrement())
  workspaceId              Int       @unique
  structureType            String    @default("mixed_structure")
  confidence               Float     @default(0)
  primaryAxis              String?
  secondaryAxesJson        String    @default("[]")
  recommendedNodeTypesJson String    @default("[]")
  recommendedPathTypesJson String    @default("[]")
  extractionFocusJson      String    @default("[]")
  recommendationFocusJson  String    @default("[]")
  structureVersion         String    @default("book-structure-v1")
  manualOverride           Boolean   @default(false)
  overrideSource           String?
  overrideReason           String?
  originalStructureType    String?
  originalConfidence       Float?
  metadataJson             String    @default("{}")
  lastAnalyzedAt           DateTime?
  nextRefreshAfter         DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([workspaceId])
  @@index([structureType])
  @@index([nextRefreshAfter])
}

model NodeChunkBinding {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  nodeKey        String
  documentId     String
  chunkId        String
  relevanceScore Float    @default(0)
  evidenceType   String   @default("original")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, nodeKey, documentId, chunkId, evidenceType])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, chunkId])
}

model NodeLearningState {
  id                  Int       @id @default(autoincrement())
  workspaceId         Int
  userId              Int       @default(0)
  nodeKey             String
  viewedCount         Int       @default(0)
  lastViewedAt        DateTime?
  quizAttemptCount    Int       @default(0)
  wrongCount          Int       @default(0)
  correctCount        Int       @default(0)
  masteryScore        Float     @default(0)
  confusionScore      Float     @default(0)
  supplementCount     Int       @default(0)
  hasUserSupplement   Boolean   @default(false)
  recommendedCount    Int       @default(0)
  dismissedCount      Int       @default(0)
  lastRecommendedAt   DateTime?
  userMarkedImportant Boolean   @default(false)
  metadataJson        String    @default("{}")
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, userId, nodeKey])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, userId])
}

model invites {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  tokenHash        String?   @unique
  role             String    @default("default")
  status           String    @default("pending")
  claimedBy        Int?
  workspaceIds     String?
  createdAt        DateTime  @default(now())
  createdBy        Int
  createdByAdminId Int?
  expiresAt        DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  usedByUserId     Int?
  lastUpdatedAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([role])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
}

model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model account_deletion_runs {
  runId              String    @id
  targetUserId       Int
  targetAuthUserId   Int?
  actorUserId        Int?
  env                String
  mode               String
  status             String    @default("running")
  currentStep        String?
  completedStepsJson String    @default("[]")
  contextJson        String    @default("{}")
  attempts           Int       @default(1)
  errorJson          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  @@index([targetUserId, status])
  @@index([targetAuthUserId, status])
  @@index([createdAt])
}

model system_patrol_runs {
  id             Int       @id @default(autoincrement())
  mode           String    @default("light")
  status         String    @default("running")
  trigger        String    @default("manual")
  triggeredBy    Int?
  summaryScore   Int       @default(0)
  summaryStatus  String    @default("unknown")
  countsJson     String    @default("{}")
  reportJson     String    @default("{}")
  reportObjectId String?
  error          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([summaryStatus])
  @@index([reportObjectId])
}

model system_patrol_repairs {
  id          Int      @id @default(autoincrement())
  repairId    String   @unique
  runId       Int?
  checkId     String
  action      String
  status      String   @default("previewed")
  previewJson String   @default("{}")
  backupPath  String?
  confirmedBy Int?
  resultJson  String   @default("{}")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([runId])
  @@index([repairId])
  @@index([status])
  @@index([action])
}

model operations_action_runs {
  id              String    @id
  sourceActionId  String    @unique
  actionId        String
  actionVersion   String
  riskLevel       String
  status          String    @default("proposed")
  requestedBy     Int?
  requestedByType String    @default("human")
  scopeJson       String    @default("{}")
  parametersJson  String    @default("{}")
  policyJson      String    @default("{}")
  dryRunJson      String    @default("{}")
  canaryJson      String    @default("{}")
  resultJson      String    @default("{}")
  validationJson  String    @default("{}")
  rollbackJson    String    @default("{}")
  errorCode       String?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  approvedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  rolledBackAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([actionId, status])
  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
}

model operations_action_approvals {
  id             Int      @id @default(autoincrement())
  runId          String
  approverUserId Int
  decision       String
  reasonCode     String?
  createdAt      DateTime @default(now())

  @@unique([runId, approverUserId])
  @@index([runId, decision])
  @@index([approverUserId, createdAt])
}

model module_instances {
  id                  String    @id
  moduleId            String
  runtimeRole         String
  version             String
  manifestFingerprint String
  state               String    @default("registered")
  sequence            Int       @default(0)
  heartbeatAt         DateTime?
  leaseExpiresAt      DateTime?
  lastReasonCode      String?
  metadataJson        String    @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([moduleId, state])
  @@index([leaseExpiresAt])
  @@index([runtimeRole, state])
}

model module_lifecycle_events {
  id           String   @id
  moduleId     String
  instanceId   String
  sequence     Int
  fromState    String
  toState      String
  reasonCode   String
  metadataJson String   @default("{}")
  occurredAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([instanceId, sequence])
  @@index([moduleId, occurredAt])
  @@index([instanceId, occurredAt])
}

model coordination_runs {
  id                  String               @id
  idempotencyKey      String?              @unique
  center              String
  type                String
  status              String               @default("proposed")
  priority            String               @default("P2")
  correlationId       String
  causationId         String?
  ownerUserId         Int?
  ownerAuthUserId     String?
  resourceType        String?
  resourceId          String?
  escalationLevel     Int                  @default(0)
  lowerLevelExhausted Boolean              @default(false)
  evidenceJson        String               @default("[]")
  policyJson          String               @default("{}")
  deadlineAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  steps               coordination_steps[]

  @@index([center, status, createdAt])
  @@index([correlationId])
  @@index([ownerUserId, status])
  @@index([deadlineAt, status])
}

model coordination_steps {
  id             String            @id
  runId          String
  moduleId       String
  capability     String
  status         String            @default("pending")
  dependsOnJson  String            @default("[]")
  attempt        Int               @default(0)
  maxAttempts    Int               @default(1)
  checkpointJson String            @default("{}")
  resultHash     String?
  errorCode      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  run            coordination_runs @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, moduleId, capability])
  @@index([runId, status])
  @@index([moduleId, status])
}

model optimistic_mutation_receipts {
  id                String    @id
  mutationId        String    @unique
  coordinationRunId String?
  ownerUserId       Int?
  ownerAuthUserId   String?
  resourceType      String
  resourceId        String
  status            String    @default("pending")
  revision          Int       @default(0)
  patchHash         String
  authoritativeHash String?
  reasonCode        String?
  expiresAt         DateTime
  confirmedAt       DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerUserId, status, createdAt])
  @@index([resourceType, resourceId, status])
  @@index([expiresAt, status])
}

model users {
  id                             Int                              @id @default(autoincrement())
  authUserId                     Int?                             @unique
  originEnv                      String?
  username                       String?                          @unique
  displayName                    String?
  password                       String
  credentialType                 String                           @default("password")
  pfpFilename                    String?
  role                           String                           @default("default")
  status                         String                           @default("active")
  allowedEnvs                    String                           @default("[]")
  ownerType                      String?
  suspended                      Int                              @default(0)
  previousRole                   String?
  previousAllowedEnvs            String?
  previousOwnerType              String?
  banActorRole                   String?
  banActorOwnerType              String?
  banActorAuthUserId             Int?
  bannedAt                       DateTime?
  seen_recovery_codes            Boolean?                         @default(false)
  email                          String?                          @unique
  email_verified_at              DateTime?
  phone                          String?                          @unique
  phone_verified_at              DateTime?
  createdAt                      DateTime                         @default(now())
  lastUpdatedAt                  DateTime                         @default(now())
  dailyMessageLimit              Int?
  bio                            String?                          @default("")
  web_push_subscription_config   String?
  workspace_chats                workspace_chats[]
  workspace_users                workspace_users[]
  embed_configs                  embed_configs[]
  embed_chats                    embed_chats[]
  threads                        workspace_threads[]
  recovery_codes                 recovery_codes[]
  password_reset_tokens          password_reset_tokens[]
  email_verification_codes       email_verification_codes[]
  email_verification_grants      email_verification_grants[]
  workspace_agent_invocations    workspace_agent_invocations[]
  slash_command_presets          slash_command_presets[]
  browser_extension_api_keys     browser_extension_api_keys[]
  temporary_auth_tokens          temporary_auth_tokens[]
  passkey_credentials            PasskeyCredential[]
  passkey_challenges             PasskeyChallenge[]
  trusted_login_devices          TrustedLoginDevice[]
  zk_login_attempts              ZkLoginAttempt[]
  system_prompt_variables        system_prompt_variables[]
  prompt_history                 prompt_history[]
  desktop_mobile_devices         desktop_mobile_devices[]
  workspace_parsed_files         workspace_parsed_files[]
  workspace_mind_maps            workspace_mind_maps[]
  athena_clients                 athena_clients[]
  athena_sync_events             athena_sync_events[]
  athena_ios_push_tokens         athena_ios_push_tokens[]
  athena_mutation_receipts       athena_mutation_receipts[]
  user_state_preferences         user_state_preferences[]
  reader_library_items           reader_library_items[]
  reader_library_categories      reader_library_categories[]
  vault_items                    vault_items[]
  vault_device_key_envelopes     vault_device_key_envelopes[]
  vault_key_epochs               vault_key_epochs[]
  vault_epoch_acknowledgements   vault_epoch_acknowledgements[]
  vault_recovery_packages        vault_recovery_packages[]
  vault_device_key_registrations vault_device_key_registrations[]
  user_root_key_epochs           user_root_key_epochs[]
  user_root_key_envelopes        user_root_key_envelopes[]
  user_root_key_challenges       user_root_key_challenges[]
  auth_sessions                  auth_sessions[]
  auth_realtime_tickets          auth_realtime_tickets[]

  @@index([originEnv])
  @@index([role])
  @@index([status])
  @@index([ownerType])
  @@index([credentialType])
}

model auth_sessions {
  sessionId          String    @id
  subjectType        String
  authUserId         Int?
  clientId           String?
  authMode           String
  tokenVersion       Int       @default(1)
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  revokedAt          DateTime?
  revokeReason       String?
  recoveryHandleHash String?   @unique
  recoveryEnabledAt  DateTime?
  recoveryLastUsedAt DateTime?
  authUser           users?    @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([authUserId, revokedAt])
  @@index([clientId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model auth_device_recovery_challenges {
  id                 String    @id
  challengeHash      String    @unique
  recoveryTicketHash String?   @unique
  clientId           String
  authUserId         Int?
  shadowUserId       Int?
  status             String    @default("issued")
  failureCount       Int       @default(0)
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId, status, expiresAt])
  @@index([authUserId, status])
  @@index([expiresAt])
}

model auth_realtime_tickets {
  ticketHash String    @id
  purpose    String
  appEnv     String
  resourceId String?
  claimsJson String
  multiUser  Boolean
  clientId   String?
  authUserId Int?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  authUser   users?    @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([appEnv, expiresAt])
  @@index([authUserId, consumedAt])
}

model vault_items {
  id               Int       @id @default(autoincrement())
  itemId           String
  userId           Int
  itemType         String    @default("secret")
  label            String?
  keyId            String
  cryptoVersion    String
  encryptedPayload String
  metadataJson     String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  deletedAt        DateTime?
  user             users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, deletedAt])
  @@index([userId, itemType])
  @@index([updatedAt])
}

model vault_device_key_envelopes {
  id                  String    @id
  userId              Int
  sourceClientId      String
  targetClientId      String
  sourceKeyGeneration Int       @default(1)
  targetKeyGeneration Int       @default(1)
  keyEpoch            Int
  envelopeJson        String
  createdAt           DateTime  @default(now())
  consumedAt          DateTime?
  user                users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetClientId, keyEpoch])
  @@index([userId, targetClientId, consumedAt])
}

model vault_key_epochs {
  id                    String    @id
  userId                Int
  keyEpoch              Int
  status                String    @default("staging")
  createdByClientId     String
  createdAt             DateTime  @default(now())
  activatedAt           DateTime?
  retirementRequestedAt DateTime?
  retiredAt             DateTime?
  user                  users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyEpoch])
  @@index([userId, status, keyEpoch])
}

model vault_device_key_registrations {
  id                 String    @id
  userId             Int
  clientId           String
  keyGeneration      Int
  suiteId            String
  kemPublicKey       String
  p256PublicKey      String
  mlDSA65PublicKey   String
  status             String    @default("active")
  hardwareProtection String?
  createdAt          DateTime  @default(now())
  supersededAt       DateTime?
  revokedAt          DateTime?
  user               users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, keyGeneration])
  @@index([userId, clientId, status])
}

model vault_epoch_acknowledgements {
  id             String   @id
  userId         Int
  clientId       String
  keyEpoch       Int
  keyGeneration  Int
  inventoryHash  String?
  acknowledgedAt DateTime @default(now())
  user           users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, keyEpoch])
  @@index([userId, keyEpoch])
}

model vault_recovery_packages {
  id                   String    @id
  userId               Int
  recoveryKeyId        String
  keyEpoch             Int
  suiteId              String
  encryptedPackageJson String
  status               String    @default("ready")
  createdByClientId    String
  createdAt            DateTime  @default(now())
  lastRecoveredAt      DateTime?
  revokedAt            DateTime?
  user                 users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recoveryKeyId])
  @@index([userId, status, keyEpoch])
}

model user_root_key_epochs {
  id                    String    @id
  authUserId            Int
  rootEpoch             Int
  rootKeyId             String
  derivationSuiteId     String
  transportSuiteId      String
  status                String    @default("active")
  initializedByClientId String
  createdAt             DateTime  @default(now())
  activatedAt           DateTime  @default(now())
  retiredAt             DateTime?
  user                  users     @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@unique([authUserId, rootEpoch])
  @@index([authUserId, status, rootEpoch])
  @@index([rootKeyId])
}

model user_root_key_envelopes {
  id                  String    @id
  authUserId          Int
  sourceClientId      String
  targetClientId      String
  sourceKeyGeneration Int       @default(1)
  targetKeyGeneration Int       @default(1)
  rootEpoch           Int
  rootKeyId           String
  derivationSuiteId   String
  transportSuiteId    String
  envelopeVersion     String
  envelopeJson        String
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?
  user                users     @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@unique([authUserId, targetClientId, targetKeyGeneration, rootEpoch])
  @@index([authUserId, targetClientId, consumedAt, expiresAt])
  @@index([authUserId, rootEpoch, rootKeyId])
}

model user_root_key_challenges {
  id             String    @id
  authUserId     Int
  sourceClientId String
  targetClientId String
  purpose        String
  challengeHash  String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?
  user           users     @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([authUserId, sourceClientId, targetClientId, purpose, consumedAt])
  @@index([expiresAt])
}

model user_domain_key_wraps {
  id                  String    @id
  userId              Int
  authUserId          Int
  resourceType        String
  resourceId          String
  domain              String
  wrapVersion         String
  rootKeyId           String
  rootEpoch           Int
  domainKeyVersion    Int       @default(1)
  platformWrapVersion String?
  platformKeyId       String?
  userWrappedKeyJson  String?
  status              String    @default("pending")
  createdByClientId   String?
  migrationJobId      String?
  idempotencyKey      String    @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now())
  completedAt         DateTime?

  @@unique([authUserId, resourceType, resourceId, domain, rootKeyId, domainKeyVersion], map: "user_domain_key_wraps_resource_key")
  @@index([userId, status, createdAt])
  @@index([authUserId, domain, status])
  @@index([rootKeyId, domainKeyVersion])
}

model user_domain_migration_jobs {
  id                String    @id
  userId            Int
  authUserId        Int
  resourceType      String
  domain            String
  status            String    @default("pending")
  checkpointJson    String    @default("{}")
  batchSize         Int       @default(100)
  scannedCount      Int       @default(0)
