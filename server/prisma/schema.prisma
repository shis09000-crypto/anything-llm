generator client {
  provider = "prisma-client-js"
}

// Uncomment the following lines and comment out the SQLite datasource block above to use PostgreSQL
// Make sure to set the correct DATABASE_URL in your .env file
// After swapping run `yarn prisma:setup` from the root directory to migrate the database
//
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }
datasource db {
  provider = "sqlite"
  url      = "file:../storage/anythingllm.db"
}

model api_keys {
  id            Int      @id @default(autoincrement())
  name          String?
  secret        String?  @unique
  createdBy     Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model workspace_documents {
  id                   Int                   @id @default(autoincrement())
  docId                String                @unique
  filename             String
  docpath              String
  workspaceId          Int
  metadata             String?
  pinned               Boolean?              @default(false)
  watched              Boolean?              @default(false)
  embeddingStatus      String                @default("completed")
  embeddingError       String?
  embeddingBatchJobId  String?
  createdAt            DateTime              @default(now())
  lastUpdatedAt        DateTime              @default(now())
  workspace            workspaces            @relation(fields: [workspaceId], references: [id])
  document_sync_queues document_sync_queues?
  node_supplements     NodeSupplement[]
  workspace_supplements WorkspaceSupplement[]
}

model WorkspaceVisualAsset {
  id           Int      @id @default(autoincrement())
  workspaceId  Int
  scopeType    String   @default("workspace")
  nodeKey      String?
  nodeLabel    String?
  nodeType     String?
  role         String   @default("hero_background")
  filename     String
  mime         String
  size         Int      @default(0)
  metadataJson String   @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, scopeType, role])
}

model WorkspaceOverviewNarrative {
  id              Int       @id @default(autoincrement())
  workspaceId      Int       @unique
  tagline          String?
  sourceHash       String    @default("")
  model            String?
  promptVersion    String    @default("workspace-overview-tagline-v2")
  status           String    @default("empty")
  errorType        String?
  metadataJson     String    @default("{}")
  lastGeneratedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model NodeSupplement {
  id           Int                 @id @default(autoincrement())
  workspaceId  Int
  nodeId       Int?
  nodeKey      String
  nodeLabel    String
  nodeType     String              @default("concept")
  documentId   String
  documentName String
  priority     Int                 @default(0)
  metadata     String              @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  document     workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, nodeKey, documentId])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, nodeId])
}

model WorkspaceSupplement {
  id                Int                 @id @default(autoincrement())
  workspaceId       Int
  scopeType         String              @default("workspace")
  primaryDocumentId String              @default("__workspace__")
  documentId        String
  documentName      String
  supplementKind    String              @default("other")
  priority          Int                 @default(0)
  metadata          String              @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  document          workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, scopeType, primaryDocumentId, documentId])
  @@index([workspaceId, scopeType, supplementKind])
  @@index([workspaceId, documentId])
}

model WorkspaceKnowledgeProfile {
  id                    Int      @id @default(autoincrement())
  workspaceId           Int      @unique
  profileType           String   @default("mixed")
  confidence            Float    @default(0)
  primaryDocumentIdsJson String  @default("[]")
  mainTopic             String?
  detectedStructureJson String   @default("{}")
  suggestedGraphStrategy String?
  profileVersion        String   @default("workspace-profile-v1")
  manualOverride        Boolean  @default(false)
  overrideSource        String?
  overrideReason        String?
  originalProfileType   String?
  originalConfidence    Float?
  userDescription       String?
  metadataJson          String   @default("{}")
  lastAnalyzedAt        DateTime?
  nextRefreshAfter      DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([workspaceId])
  @@index([profileType])
  @@index([nextRefreshAfter])
}

model BookStructureAnalysis {
  id                       Int      @id @default(autoincrement())
  workspaceId              Int      @unique
  structureType            String   @default("mixed_structure")
  confidence               Float    @default(0)
  primaryAxis              String?
  secondaryAxesJson        String   @default("[]")
  recommendedNodeTypesJson String   @default("[]")
  recommendedPathTypesJson String   @default("[]")
  extractionFocusJson      String   @default("[]")
  recommendationFocusJson  String   @default("[]")
  structureVersion         String   @default("book-structure-v1")
  manualOverride           Boolean  @default(false)
  overrideSource           String?
  overrideReason           String?
  originalStructureType    String?
  originalConfidence       Float?
  metadataJson             String   @default("{}")
  lastAnalyzedAt           DateTime?
  nextRefreshAfter         DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([workspaceId])
  @@index([structureType])
  @@index([nextRefreshAfter])
}

model NodeChunkBinding {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  nodeKey        String
  documentId     String
  chunkId        String
  relevanceScore Float    @default(0)
  evidenceType   String   @default("original")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, nodeKey, documentId, chunkId, evidenceType])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, chunkId])
}

model NodeLearningState {
  id                  Int       @id @default(autoincrement())
  workspaceId          Int
  userId              Int       @default(0)
  nodeKey             String
  viewedCount         Int       @default(0)
  lastViewedAt        DateTime?
  quizAttemptCount    Int       @default(0)
  wrongCount          Int       @default(0)
  correctCount        Int       @default(0)
  masteryScore        Float     @default(0)
  confusionScore      Float     @default(0)
  supplementCount     Int       @default(0)
  hasUserSupplement   Boolean   @default(false)
  recommendedCount    Int       @default(0)
  dismissedCount      Int       @default(0)
  lastRecommendedAt   DateTime?
  userMarkedImportant Boolean   @default(false)
  metadataJson        String    @default("{}")
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, userId, nodeKey])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, userId])
}

model invites {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  status        String   @default("pending")
  claimedBy     Int?
  workspaceIds  String?
  createdAt     DateTime @default(now())
  createdBy     Int
  lastUpdatedAt DateTime @default(now())
}

model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model users {
  id                           Int                           @id @default(autoincrement())
  username                     String?                       @unique
  password                     String
  pfpFilename                  String?
  role                         String                        @default("default")
  suspended                    Int                           @default(0)
  seen_recovery_codes          Boolean?                      @default(false)
  createdAt                    DateTime                      @default(now())
  lastUpdatedAt                DateTime                      @default(now())
  dailyMessageLimit            Int?
  bio                          String?                       @default("")
  web_push_subscription_config String?
  workspace_chats              workspace_chats[]
  workspace_users              workspace_users[]
  embed_configs                embed_configs[]
  embed_chats                  embed_chats[]
  threads                      workspace_threads[]
  recovery_codes               recovery_codes[]
  password_reset_tokens        password_reset_tokens[]
  workspace_agent_invocations  workspace_agent_invocations[]
  slash_command_presets        slash_command_presets[]
  browser_extension_api_keys   browser_extension_api_keys[]
  temporary_auth_tokens        temporary_auth_tokens[]
  system_prompt_variables      system_prompt_variables[]
  prompt_history               prompt_history[]
  desktop_mobile_devices       desktop_mobile_devices[]
  workspace_parsed_files       workspace_parsed_files[]
  workspace_mind_maps          workspace_mind_maps[]
}

model workspace_quiz_attempts {
  id                 Int      @id @default(autoincrement())
  workspaceId        Int
  userId             Int?
  cacheUserKey       String   @default("anonymous")
  quizId             String
  quizChatId         Int
  topic              String?
  keywordsJson       String   @default("[]")
  difficulty         String?
  totalQuestions     Int      @default(0)
  completedQuestions Int      @default(0)
  score              Float?
  accuracy           Float?
  analysis           String?
  questionResultsReliable Int      @default(1)
  questionResultsParseError String?
  submittedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())

  @@unique([workspaceId, cacheUserKey, quizChatId])
  @@index([workspaceId])
  @@index([userId])
  @@index([quizChatId])
}

model workspace_quiz_question_results {
  id                Int      @id @default(autoincrement())
  attemptId         Int
  questionId        String
  questionType      String
  difficulty        String?
  question          String
  optionsJson       String   @default("[]")
  userAnswerJson    String?
  correctAnswerJson String?
  isCorrect         Int?
  score             Float?
  analysis          String?
  mistakeReason     String?
  weakConceptsJson  String   @default("[]")
  sourceRefsJson    String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model workspace_quiz_wrong_questions {
  id                Int      @id @default(autoincrement())
  workspaceId       Int
  userId            Int?
  cacheUserKey      String   @default("anonymous")
  attemptId         Int
  questionResultId  Int
  questionId        String
  questionType      String
  topic             String?
  question          String
  optionsJson       String   @default("[]")
  userAnswerJson    String?
  correctAnswerJson String?
  analysis          String?
  mistakeReason     String?
  weakConceptsJson  String   @default("[]")
  sourceRefsJson    String   @default("[]")
  reviewCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([workspaceId, cacheUserKey, questionResultId])
  @@index([workspaceId])
  @@index([attemptId])
}

model workspace_quiz_favorite_questions {
  id                Int      @id @default(autoincrement())
  workspaceId       Int
  userId            Int?
  cacheUserKey      String   @default("anonymous")
  quizId            String
  quizChatId        Int
  attemptId         Int?
  questionResultId  Int?
  questionId        String
  questionType      String
  topic             String?
  difficulty        String?
  question          String
  optionsJson       String   @default("[]")
  correctAnswerJson String?
  userAnswerJson    String?
  analysis          String?
  sourceRefsJson    String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([workspaceId, cacheUserKey, quizId, questionId])
  @@index([workspaceId])
  @@index([questionResultId])
}

model recovery_codes {
  id        Int      @id @default(autoincrement())
  user_id   Int
  code_hash String
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  id        Int      @id @default(autoincrement())
  user_id   Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model document_vectors {
  id            Int      @id @default(autoincrement())
  docId         String
  vectorId      String
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model DocumentIndexStatus {
  id             Int       @id @default(autoincrement())
  workspaceId    Int
  docId          String?
  filePath       String
  fileHash       String    @default("")
  indexStatus    String    @default("pending")
  indexedAt      DateTime?
  errorMessage   String?
  chunkCount     Int       @default(0)
  embeddingCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, filePath])
  @@index([workspaceId])
  @@index([docId])
  @@index([filePath])
  @@index([fileHash])
  @@index([indexStatus])
}

model KnowledgeNode {
  id                       Int      @id @default(autoincrement())
  workspaceId              Int
  canonicalName            String
  canonicalKey             String
  aliases                  String   @default("[]")
  displayNameZh            String?
  displayNameEn            String?
  entityType               String   @default("concept")
  summary                  String?
  globalImportanceScore    Float    @default(0)
  workspaceImportanceScore Float    @default(0)
  recentImportanceScore    Float    @default(0)
  usageCount               Int      @default(0)
  recentUsageCount         Int      @default(0)
  lastReferencedAt         DateTime?
  embedding                String?
  embeddingModel           String?
  embeddingVersion         String?
  mergeLogicVersion        String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([workspaceId, canonicalKey])
  @@index([workspaceId, entityType])
  @@index([workspaceId, canonicalKey])
  @@index([workspaceId, globalImportanceScore])
  @@index([workspaceId, workspaceImportanceScore])
  @@index([workspaceId, recentImportanceScore])
  @@index([workspaceId, lastReferencedAt])
}

model KnowledgeEdge {
  id                       Int      @id @default(autoincrement())
  workspaceId              Int
  sourceNodeId             Int
  targetNodeId             Int
  relationType             String
  relationLabel            String?
  relationLabelZh          String?
  relationLabelEn          String?
  confidence               Float    @default(0)
  weight                   Float    @default(1)
  usageCount               Int      @default(0)
  lastReferencedAt         DateTime?
  extractionPromptVersion  String
  mergeLogicVersion        String
  relationOntologyVersion  String
  graphVersion             String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([workspaceId, sourceNodeId, targetNodeId, relationType])
  @@index([workspaceId, sourceNodeId])
  @@index([workspaceId, targetNodeId])
  @@index([workspaceId, relationType])
  @@index([workspaceId, confidence])
  @@index([workspaceId, weight])
}

model EdgeEvidence {
  id              Int      @id @default(autoincrement())
  workspaceId     Int
  edgeId          Int
  documentId      String
  chunkId         String
  snippet         String?
  confidence      Float    @default(0)
  extractionJobId Int?
  createdAt       DateTime @default(now())

  @@unique([edgeId, chunkId])
  @@index([workspaceId, edgeId])
  @@index([workspaceId, documentId])
  @@index([workspaceId, chunkId])
}

model ConceptChunkMap {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  nodeId         Int
  documentId     String
  chunkId        String
  relevanceScore Float    @default(0)
  mentionCount   Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, nodeId, chunkId])
  @@index([workspaceId, nodeId])
  @@index([workspaceId, chunkId])
  @@index([workspaceId, documentId])
}

model GraphExtractionJob {
  id                       Int       @id @default(autoincrement())
  workspaceId              Int
  chunkId                  String
  documentId               String
  status                   String    @default("pending")
  graphVersion             String
  extractionPromptVersion  String
  promptDomain             String
  mergeLogicVersion        String
  relationOntologyVersion  String
  extractedAt              DateTime?
  errorMessage             String?
  retryCount               Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([workspaceId, chunkId])
  @@index([status])
  @@index([workspaceId, chunkId])
  @@index([workspaceId, documentId])
}

model GraphRetrievalCache {
  id            Int      @id @default(autoincrement())
  workspaceId   Int
  conceptKey    String
  paramsHash    String
  resultJson    String
  hitCount      Int      @default(0)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, conceptKey, paramsHash])
  @@index([workspaceId, conceptKey])
  @@index([workspaceId, expiresAt])
}

model GraphLabelTranslationCache {
  id            Int      @id @default(autoincrement())
  workspaceId   Int
  cacheKey      String
  sourceText    String
  sourceType    String   @default("node")
  displayNameZh String?
  displayNameEn String?
  aliasesJson   String   @default("[]")
  model         String?
  promptVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, cacheKey])
}

model KnowledgeGraphRepairIssue {
  id                       Int       @id @default(autoincrement())
  workspaceId              Int
  documentId               String    @default("")
  chunkId                  String    @default("")
  issueType                String
  status                   String    @default("open")
  priorityScore            Float     @default(0)
  priorityReason           String?
  rootConceptHit           Boolean   @default(false)
  workspaceImportanceScore Float     @default(0)
  traversalUsageCount      Int       @default(0)
  retryCount               Int       @default(0)
  nextRetryAt              DateTime?
  cooldownUntil            DateTime?
  repairMethod             String?
  repairConfidence         String?
  lastError                String?
  explainReason            String?
  quarantineReason         String?
  metadataJson             String    @default("{}")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([workspaceId, issueType, documentId, chunkId])
  @@index([workspaceId, status])
  @@index([workspaceId, priorityScore])
  @@index([workspaceId, nextRetryAt])
  @@index([workspaceId, cooldownUntil])
}

model KnowledgeGraphRepairRun {
  id                         Int      @id @default(autoincrement())
  workspaceId                Int
  trigger                    String   @default("auto")
  scanned                    Int      @default(0)
  repaired                   Int      @default(0)
  failed                     Int      @default(0)
  skipped                    Int      @default(0)
  budgetExhausted            Boolean  @default(false)
  durationMs                 Int      @default(0)
  tokenBudgetUsed            Int      @default(0)
  providerBudgetUsed         Int      @default(0)
  successRate                Float    @default(0)
  avgRepairLatencyMs         Float    @default(0)
  providerFailureRate        Float    @default(0)
  needsReembedCount          Int      @default(0)
  quarantinedCount           Int      @default(0)
  lowConfidenceRelationRatio Float    @default(0)
  relatedToRatio             Float    @default(0)
  malformedExtractionRatio   Float    @default(0)
  abnormalFanoutCount        Int      @default(0)
  timeoutRate                Float    @default(0)
  malformedJsonRate          Float    @default(0)
  avgExtractionLatencyMs     Float    @default(0)
  providerFailureTrend       Float    @default(0)
  metricsJson                String   @default("{}")
  createdAt                  DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, trigger])
}

model KnowledgeGraphEvidenceUsage {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  targetType  String
  targetId    String
  action      String
  count       Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, targetType, targetId, action])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, action])
  @@index([workspaceId, lastUsedAt])
}

model KnowledgeNodeMetrics {
  id                   Int       @id @default(autoincrement())
  workspaceId          Int
  nodeId               Int
  evidenceStrength     Int       @default(0)
  bridgeValue          Int       @default(0)
  knowledgeConnectivity Int      @default(0)
  traversalImportance  Int       @default(0)
  crossDocumentPresence Int      @default(0)
  freshness            Int       @default(0)
  relationDiversity    Int       @default(0)
  sourceAuthority      Int       @default(0)
  stability            Int       @default(0)
  conflictSafety       Int       @default(0)
  reasonsJson          String    @default("{}")
  normalizedInputsJson String    @default("{}")
  formulaVersion       String    @default("metrics-v1")
  stale                Boolean   @default(true)
  warning              String?
  lastError            String?
  lockedAt             DateTime?
  lockedBy             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, nodeId])
  @@index([workspaceId])
  @@index([nodeId])
  @@index([formulaVersion])
  @@index([stale])
  @@index([lockedAt])
  @@index([updatedAt])
}

model KnowledgeNodeMetricsSnapshot {
  id                   Int      @id @default(autoincrement())
  workspaceId          Int
  nodeId               Int
  formulaVersion       String
  scoresJson           String
  normalizedInputsJson String   @default("{}")
  snapshotPeriod       String   @default("daily")
  createdAt            DateTime @default(now())

  @@index([workspaceId, nodeId])
  @@index([formulaVersion])
  @@index([snapshotPeriod])
  @@index([createdAt])
}

model KnowledgeNodeMetricsRecomputeRun {
  id             Int      @id @default(autoincrement())
  workspaceId    Int?
  trigger        String   @default("worker")
  formulaVersion String   @default("metrics-v1")
  batchSize      Int      @default(0)
  processed      Int      @default(0)
  succeeded      Int      @default(0)
  failed         Int      @default(0)
  skipped        Int      @default(0)
  durationMs     Int      @default(0)
  lockedCount    Int      @default(0)
  errorJson      String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([workspaceId])
  @@index([trigger])
  @@index([formulaVersion])
  @@index([createdAt])
}

model WorkspaceOverviewRecommendationUsage {
  id                 Int       @id @default(autoincrement())
  workspaceId        Int
  userId             Int       @default(0)
  recommendationId   String
  type               String
  targetType         String
  targetId           String
  formulaVersion     String
  impressionCount    Int       @default(0)
  clickCount         Int       @default(0)
  dismissCount       Int       @default(0)
  continueCount      Int       @default(0)
  lastShownAt        DateTime?
  lastInteractedAt   DateTime?
  cooldownUntil      DateTime?
  metadata           String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, userId, recommendationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([recommendationId])
  @@index([workspaceId, cooldownUntil])
  @@index([workspaceId, type])
  @@index([workspaceId, targetType, targetId])
}

model workspaces {
  id                           Int                            @id @default(autoincrement())
  name                         String
  slug                         String                         @unique
  vectorTag                    String?
  createdAt                    DateTime                       @default(now())
  openAiTemp                   Float?
  openAiHistory                Int                            @default(20)
  lastUpdatedAt                DateTime                       @default(now())
  // THIS IS THE SYSTEM PROMPT FOR THE WORKSPACE
  openAiPrompt                 String?
  similarityThreshold          Float?                         @default(0.25)
  chatProvider                 String?
  chatModel                    String?
  topN                         Int?                           @default(4)
  chatMode                     String?                        @default("chat")
  pfpFilename                  String?
  agentProvider                String?
  agentModel                   String?
  queryRefusalResponse         String?
  vectorSearchMode             String?                        @default("default")
  workspace_users              workspace_users[]
  documents                    workspace_documents[]
  workspace_suggested_messages workspace_suggested_messages[]
  embed_configs                embed_configs[]
  threads                      workspace_threads[]
  workspace_agent_invocations  workspace_agent_invocations[]
  prompt_history               prompt_history[]
  workspace_parsed_files       workspace_parsed_files[]
  workspace_mind_maps          workspace_mind_maps[]
}

model workspace_threads {
  id                     Int                      @id @default(autoincrement())
  name                   String
  slug                   String                   @unique
  workspace_id           Int
  user_id                Int?
  parent_thread_id       Int?
  thread_type            String?
  created_from           String?
  forked_at_message_id   Int?
  forked_at              DateTime?
  createdAt              DateTime                 @default(now())
  lastUpdatedAt          DateTime                 @default(now())
  workspace              workspaces               @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user                   users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace_parsed_files workspace_parsed_files[]

  @@index([workspace_id])
  @@index([user_id])
}

model workspace_suggested_messages {
  id            Int        @id @default(autoincrement())
  workspaceId   Int
  heading       String
  message       String
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  workspace     workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model workspace_chats {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  prompt         String
  response       String
  include        Boolean  @default(true)
  user_id        Int?
  thread_id      Int? // No relation to prevent whole table migration
  original_thread_id Int?
  original_message_id Int?
  created_from   String?
  api_session_id String? // String identifier for only the dev API to partition chats in any mode.
  createdAt      DateTime @default(now())
  lastUpdatedAt  DateTime @default(now())
  feedbackScore  Boolean?
  users          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model workspace_chat_compactions {
  id                    Int      @id @default(autoincrement())
  workspace_id          Int
  user_id               Int?
  thread_id             Int?
  api_session_id        String?
  summary               String
  summary_format        String   @default("thread-compact-markdown-v1")
  covered_chat_ids      String   @default("[]")
  covered_from_chat_id  Int?
  covered_to_chat_id    Int?
  covered_message_count Int      @default(0)
  token_before          Int      @default(0)
  token_after           Int      @default(0)
  metadata_json         String   @default("{}")
  reason                String?
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  @@index([workspace_id, user_id, thread_id, api_session_id, created_at])
  @@index([workspace_id, thread_id, api_session_id, covered_to_chat_id])
}

model workspace_mind_maps {
  id             Int        @id @default(autoincrement())
  workspaceId    Int
  user_id        Int?
  thread_id      Int?
  cacheUserKey   String     @default("anonymous")
  sourceType     String
  sourceId       String?
  sourceTitle    String?
  sourceHash     String
  title          String
  layout         String
  theme          String
  schema         String
  markdown       String?
  viewport       String?
  promptVersion  String
  schemaVersion  String
  generationModel String?
  suitability    String?
  createdAt      DateTime   @default(now())
  lastUpdatedAt  DateTime   @default(now())
  workspace      workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workspaceId, cacheUserKey, sourceHash])
  @@index([workspaceId])
  @@index([user_id])
  @@index([thread_id])
  @@index([sourceHash])
}

model workspace_agent_invocations {
  id            Int        @id @default(autoincrement())
  uuid          String     @unique
  prompt        String // Contains agent invocation to parse + option additional text for seed.
  closed        Boolean    @default(false)
  user_id       Int?
  thread_id     Int? // No relation to prevent whole table migration
  workspace_id  Int
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  user          users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspace     workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([uuid])
}

model workspace_users {
  id            Int        @id @default(autoincrement())
  user_id       Int
  workspace_id  Int
  createdAt     DateTime   @default(now())
  lastUpdatedAt DateTime   @default(now())
  workspaces    workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users         users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model cache_data {
  id            Int       @id @default(autoincrement())
  name          String
  data          String
  belongsTo     String?
  byId          Int?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUpdatedAt DateTime  @default(now())
}

model embed_configs {
  id                         Int           @id @default(autoincrement())
  uuid                       String        @unique
  enabled                    Boolean       @default(false)
  chat_mode                  String        @default("query")
  allowlist_domains          String?
  allow_model_override       Boolean       @default(false)
  allow_temperature_override Boolean       @default(false)
  allow_prompt_override      Boolean       @default(false)
  max_chats_per_day          Int?
  max_chats_per_session      Int?
  message_limit              Int?          @default(20)
  workspace_id               Int
  createdBy                  Int?
  usersId                    Int?
  createdAt                  DateTime      @default(now())
  workspace                  workspaces    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  embed_chats                embed_chats[]
  users                      users?        @relation(fields: [usersId], references: [id])
}

model embed_chats {
  id                     Int           @id @default(autoincrement())
  prompt                 String
  response               String
  session_id             String
  include                Boolean       @default(true)
  connection_information String?
  embed_id               Int
  usersId                Int?
  createdAt              DateTime      @default(now())
  embed_config           embed_configs @relation(fields: [embed_id], references: [id], onDelete: Cascade)
  users                  users?        @relation(fields: [usersId], references: [id])
}

model event_logs {
  id         Int      @id @default(autoincrement())
  event      String
  metadata   String?
  userId     Int?
  occurredAt DateTime @default(now())

  @@index([event])
}

model embedding_batch_jobs {
  id           Int      @id @default(autoincrement())
  jobId        String   @unique
  workspaceId  Int
  workspaceSlug String
  documentIds  String
  documentPaths String
  status       String   @default("queued")
  provider     String
  model        String
  inputFileId  String?
  batchId      String?
  outputFileId String?
  errorFileId  String?
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  completedAt  DateTime?
  lastError    String?
  retryCount   Int      @default(0)
  nextRetryAt  DateTime?
  lastTransientError String?

  @@index([status])
  @@index([workspaceId])
  @@index([jobId])
}

model embedding_batch_job_events {
  id         Int      @id @default(autoincrement())
  jobId      String
  event      String
  metadata   String?
  occurredAt DateTime @default(now())

  @@index([jobId])
  @@index([event])
}

model slash_command_presets {
  id            Int      @id @default(autoincrement())
  command       String
  prompt        String
  description   String
  uid           Int      @default(0) // 0 is null user
  userId        Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
  user          users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([uid, command])
}

model document_sync_queues {
  id             Int                        @id @default(autoincrement())
  staleAfterMs   Int                        @default(604800000) // 7 days
  nextSyncAt     DateTime
  createdAt      DateTime                   @default(now())
  lastSyncedAt   DateTime                   @default(now())
  workspaceDocId Int                        @unique
  workspaceDoc   workspace_documents?       @relation(fields: [workspaceDocId], references: [id], onDelete: Cascade)
  runs           document_sync_executions[]
}

model document_sync_executions {
  id        Int                  @id @default(autoincrement())
  queueId   Int
  status    String               @default("unknown")
  result    String?
  createdAt DateTime             @default(now())
  queue     document_sync_queues @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model browser_extension_api_keys {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  user_id       Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
  user          users?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model temporary_auth_tokens {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model system_prompt_variables {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?
  description String?
  type        String   @default("system") // system, user, dynamic
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model prompt_history {
  id          Int        @id @default(autoincrement())
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId Int
  prompt      String
  modifiedBy  Int?
  modifiedAt  DateTime   @default(now())
  user        users?     @relation(fields: [modifiedBy], references: [id])

  @@index([workspaceId])
}

// Schema specific to mobile app <> Desktop app connection
model desktop_mobile_devices {
  id         Int      @id @default(autoincrement())
  deviceOs   String
  deviceName String
  token      String   @unique
  approved   Boolean  @default(false)
  userId     Int?
  createdAt  DateTime @default(now())
  user       users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model workspace_parsed_files {
  id                 Int                @id @default(autoincrement())
  filename           String             @unique
  workspaceId        Int
  userId             Int?
  threadId           Int?
  metadata           String?
  tokenCountEstimate Int?               @default(0)
  createdAt          DateTime           @default(now())
  workspace          workspaces         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               users?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread             workspace_threads? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model external_communication_connectors {
  id            Int      @id @default(autoincrement())
  type          String   @unique
  config        String   @default("{}")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model wechat_gateway_threads {
  id             Int      @id @default(autoincrement())
  wxid           String   @unique
  nickname       String?
  workspace_slug String
  thread_slug    String
  createdAt      DateTime @default(now())
  lastUpdatedAt  DateTime @default(now())

  @@index([workspace_slug])
  @@index([thread_slug])
}

model scheduled_jobs {
  id        Int                  @id @default(autoincrement())
  name      String
  prompt    String
  tools     String? // JSON array of tool identifiers (null = use all enabled agent skills)
  schedule  String // Cron expression
  enabled   Boolean              @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now())
  runs      scheduled_job_runs[]
}

model scheduled_job_runs {
  id          Int            @id @default(autoincrement())
  jobId       Int
  status      String         @default("queued") // queued | running | completed | failed | timed_out — model always sets explicitly
  result      String? // JSON execution trace
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  readAt      DateTime? // null = unread
  job         scheduled_jobs @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
