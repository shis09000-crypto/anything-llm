generator client {
  provider = "prisma-client-js"
}

// Uncomment the following lines and comment out the SQLite datasource block above to use PostgreSQL
// Make sure to set the correct DATABASE_URL in your .env file
// After swapping run `yarn prisma:setup` from the root directory to migrate the database
//
// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model api_keys {
  id            Int      @id @default(autoincrement())
  name          String?
  secret        String?  @unique
  createdBy     Int?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model workspace_documents {
  id                    Int                   @id @default(autoincrement())
  docId                 String                @unique
  filename              String
  docpath               String
  workspaceId           Int
  metadata              String?
  pinned                Boolean?              @default(false)
  watched               Boolean?              @default(false)
  embeddingStatus       String                @default("completed")
  embeddingError        String?
  embeddingBatchJobId   String?
  createdAt             DateTime              @default(now())
  lastUpdatedAt         DateTime              @default(now())
  workspace             workspaces            @relation(fields: [workspaceId], references: [id])
  document_sync_queues  document_sync_queues?
  node_supplements      NodeSupplement[]
  workspace_supplements WorkspaceSupplement[]
}

model WorkspaceVisualAsset {
  id           Int       @id @default(autoincrement())
  workspaceId  Int
  scopeType    String    @default("workspace")
  nodeKey      String?
  nodeLabel    String?
  nodeType     String?
  role         String    @default("hero_background")
  filename     String
  mime         String
  size         Int       @default(0)
  metadataJson String    @default("{}")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, scopeType, role])
}

model WorkspaceOverviewNarrative {
  id              Int       @id @default(autoincrement())
  workspaceId     Int       @unique
  tagline         String?
  sourceHash      String    @default("")
  model           String?
  promptVersion   String    @default("workspace-overview-tagline-v2")
  status          String    @default("empty")
  errorType       String?
  metadataJson    String    @default("{}")
  lastGeneratedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model NodeSupplement {
  id           Int                 @id @default(autoincrement())
  workspaceId  Int
  nodeId       Int?
  nodeKey      String
  nodeLabel    String
  nodeType     String              @default("concept")
  documentId   String
  documentName String
  priority     Int                 @default(0)
  metadata     String              @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  document     workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, nodeKey, documentId])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, nodeId])
}

model WorkspaceSupplement {
  id                Int                 @id @default(autoincrement())
  workspaceId       Int
  scopeType         String              @default("workspace")
  primaryDocumentId String              @default("__workspace__")
  documentId        String
  documentName      String
  supplementKind    String              @default("other")
  priority          Int                 @default(0)
  metadata          String              @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  document          workspace_documents @relation(fields: [documentId], references: [docId], onDelete: Cascade)

  @@unique([workspaceId, scopeType, primaryDocumentId, documentId])
  @@index([workspaceId, scopeType, supplementKind])
  @@index([workspaceId, documentId])
}

model WorkspaceKnowledgeProfile {
  id                     Int       @id @default(autoincrement())
  workspaceId            Int       @unique
  profileType            String    @default("mixed")
  confidence             Float     @default(0)
  primaryDocumentIdsJson String    @default("[]")
  mainTopic              String?
  detectedStructureJson  String    @default("{}")
  suggestedGraphStrategy String?
  profileVersion         String    @default("workspace-profile-v1")
  manualOverride         Boolean   @default(false)
  overrideSource         String?
  overrideReason         String?
  originalProfileType    String?
  originalConfidence     Float?
  userDescription        String?
  metadataJson           String    @default("{}")
  lastAnalyzedAt         DateTime?
  nextRefreshAfter       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([workspaceId])
  @@index([profileType])
  @@index([nextRefreshAfter])
}

model BookStructureAnalysis {
  id                       Int       @id @default(autoincrement())
  workspaceId              Int       @unique
  structureType            String    @default("mixed_structure")
  confidence               Float     @default(0)
  primaryAxis              String?
  secondaryAxesJson        String    @default("[]")
  recommendedNodeTypesJson String    @default("[]")
  recommendedPathTypesJson String    @default("[]")
  extractionFocusJson      String    @default("[]")
  recommendationFocusJson  String    @default("[]")
  structureVersion         String    @default("book-structure-v1")
  manualOverride           Boolean   @default(false)
  overrideSource           String?
  overrideReason           String?
  originalStructureType    String?
  originalConfidence       Float?
  metadataJson             String    @default("{}")
  lastAnalyzedAt           DateTime?
  nextRefreshAfter         DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([workspaceId])
  @@index([structureType])
  @@index([nextRefreshAfter])
}

model NodeChunkBinding {
  id             Int      @id @default(autoincrement())
  workspaceId    Int
  nodeKey        String
  documentId     String
  chunkId        String
  relevanceScore Float    @default(0)
  evidenceType   String   @default("original")
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, nodeKey, documentId, chunkId, evidenceType])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, documentId])
  @@index([workspaceId, chunkId])
}

model NodeLearningState {
  id                  Int       @id @default(autoincrement())
  workspaceId         Int
  userId              Int       @default(0)
  nodeKey             String
  viewedCount         Int       @default(0)
  lastViewedAt        DateTime?
  quizAttemptCount    Int       @default(0)
  wrongCount          Int       @default(0)
  correctCount        Int       @default(0)
  masteryScore        Float     @default(0)
  confusionScore      Float     @default(0)
  supplementCount     Int       @default(0)
  hasUserSupplement   Boolean   @default(false)
  recommendedCount    Int       @default(0)
  dismissedCount      Int       @default(0)
  lastRecommendedAt   DateTime?
  userMarkedImportant Boolean   @default(false)
  metadataJson        String    @default("{}")
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, userId, nodeKey])
  @@index([workspaceId, nodeKey])
  @@index([workspaceId, userId])
}

model invites {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  tokenHash        String?   @unique
  role             String    @default("default")
  status           String    @default("pending")
  claimedBy        Int?
  workspaceIds     String?
  createdAt        DateTime  @default(now())
  createdBy        Int
  createdByAdminId Int?
  expiresAt        DateTime?
  consumedAt       DateTime?
  revokedAt        DateTime?
  usedByUserId     Int?
  lastUpdatedAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([role])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
}

model system_settings {
  id            Int      @id @default(autoincrement())
  label         String   @unique
  value         String?
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model system_patrol_runs {
  id            Int       @id @default(autoincrement())
  mode          String    @default("light")
  status        String    @default("running")
  trigger       String    @default("manual")
  triggeredBy   Int?
  summaryScore  Int       @default(0)
  summaryStatus String    @default("unknown")
  countsJson    String    @default("{}")
  reportJson    String    @default("{}")
  error         String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([startedAt])
  @@index([status])
  @@index([summaryStatus])
}

model system_patrol_repairs {
  id          Int       @id @default(autoincrement())
  repairId    String    @unique
  runId       Int?
  checkId     String
  action      String
  status      String    @default("previewed")
  previewJson String    @default("{}")
  backupPath  String?
  confirmedBy Int?
  resultJson  String    @default("{}")
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@index([runId])
  @@index([repairId])
  @@index([status])
  @@index([action])
}

model users {
  id                           Int                           @id @default(autoincrement())
  authUserId                   Int?                          @unique
  originEnv                    String?
  username                     String?                       @unique
  displayName                  String?
  password                     String
  pfpFilename                  String?
  role                         String                        @default("default")
  status                       String                        @default("active")
  allowedEnvs                  String                        @default("[]")
  ownerType                    String?
  suspended                    Int                           @default(0)
  previousRole                 String?
  previousAllowedEnvs          String?
  previousOwnerType            String?
  banActorRole                 String?
  banActorOwnerType            String?
  banActorAuthUserId           Int?
  bannedAt                     DateTime?
  seen_recovery_codes          Boolean?                      @default(false)
  email                        String?                       @unique
  email_verified_at            DateTime?
  phone                        String?                       @unique
  phone_verified_at            DateTime?
  createdAt                    DateTime                      @default(now())
  lastUpdatedAt                DateTime                      @default(now())
  dailyMessageLimit            Int?
  bio                          String?                       @default("")
  web_push_subscription_config String?
  workspace_chats              workspace_chats[]
  workspace_users              workspace_users[]
  embed_configs                embed_configs[]
  embed_chats                  embed_chats[]
  threads                      workspace_threads[]
  recovery_codes               recovery_codes[]
  password_reset_tokens        password_reset_tokens[]
  email_verification_codes     email_verification_codes[]
  email_verification_grants    email_verification_grants[]
  workspace_agent_invocations  workspace_agent_invocations[]
  slash_command_presets        slash_command_presets[]
  browser_extension_api_keys   browser_extension_api_keys[]
  temporary_auth_tokens        temporary_auth_tokens[]
  passkey_credentials          PasskeyCredential[]
  passkey_challenges           PasskeyChallenge[]
  trusted_login_devices        TrustedLoginDevice[]
  zk_login_attempts            ZkLoginAttempt[]
  system_prompt_variables      system_prompt_variables[]
  prompt_history               prompt_history[]
  desktop_mobile_devices       desktop_mobile_devices[]
  workspace_parsed_files       workspace_parsed_files[]
  workspace_mind_maps          workspace_mind_maps[]
  athena_clients               athena_clients[]
  user_state_preferences       user_state_preferences[]
  vault_items                  vault_items[]

  @@index([originEnv])
  @@index([role])
  @@index([status])
  @@index([ownerType])
}

model vault_items {
  id               Int       @id @default(autoincrement())
  itemId           String
  userId           Int
  itemType         String    @default("secret")
  label            String?
  keyId            String
  cryptoVersion    String
  encryptedPayload String
  metadataJson     String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  deletedAt        DateTime?
  user             users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, deletedAt])
  @@index([userId, itemType])
  @@index([updatedAt])
}

model memory_candidates {
  id          Int      @id @default(autoincrement())
  userId      Int
  category    String
  title       String
  detail      String
  source      String
  confidence  String
  fingerprint String
  createdAt   DateTime @default(now())

  @@index([userId, category])
  @@index([fingerprint])
}

model user_memory_blocks {
  id               Int      @id @default(autoincrement())
  userId           Int
  category         String
  title            String
  detail           String
  source           String
  confidence       String
  updatedAt        DateTime @default(now())
  isSensitive      Boolean  @default(false)
  encryptedPayload String?

  @@index([userId, category])
  @@index([userId, isSensitive])
}

model user_memory_archives {
  id         Int      @id @default(autoincrement())
  userId     Int
  category   String
  oldValue   String
  replacedBy Int?
  archivedAt DateTime @default(now())

  @@index([userId, category])
  @@index([replacedBy])
}

model user_profile_overviews {
  id          Int      @id @default(autoincrement())
  userId      Int
  overview    String
  version     Int
  generatedAt DateTime @default(now())

  @@index([userId, version])
}

model AuthEnvironmentDeletion {
  id                  Int      @id @default(autoincrement())
  authUserId          Int
  env                 String
  deletedAt           DateTime @default(now())
  deletedByAuthUserId Int?

  @@unique([authUserId, env])
  @@index([authUserId])
  @@index([env])
  @@index([deletedAt])
}

model workspace_quiz_attempts {
  id                        Int       @id @default(autoincrement())
  workspaceId               Int
  userId                    Int?
  cacheUserKey              String    @default("anonymous")
  quizId                    String
  quizChatId                Int
  topic                     String?
  keywordsJson              String    @default("[]")
  difficulty                String?
  totalQuestions            Int       @default(0)
  completedQuestions        Int       @default(0)
  score                     Float?
  accuracy                  Float?
  analysis                  String?
  questionResultsReliable   Int       @default(1)
  questionResultsParseError String?
  submittedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now())

  @@unique([workspaceId, cacheUserKey, quizChatId])
  @@index([workspaceId])
  @@index([userId])
  @@index([quizChatId])
}

model workspace_quiz_question_results {
  id                Int      @id @default(autoincrement())
  attemptId         Int
  questionId        String
  questionType      String
  difficulty        String?
  question          String
  optionsJson       String   @default("[]")
  userAnswerJson    String?
  correctAnswerJson String?
  isCorrect         Int?
  score             Float?
  analysis          String?
  mistakeReason     String?
  weakConceptsJson  String   @default("[]")
  sourceRefsJson    String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model workspace_quiz_wrong_questions {
  id                Int      @id @default(autoincrement())
  workspaceId       Int
  userId            Int?
  cacheUserKey      String   @default("anonymous")
  attemptId         Int
  questionResultId  Int
  questionId        String
  questionType      String
  topic             String?
  question          String
  optionsJson       String   @default("[]")
  userAnswerJson    String?
  correctAnswerJson String?
  analysis          String?
  mistakeReason     String?
  weakConceptsJson  String   @default("[]")
  sourceRefsJson    String   @default("[]")
  reviewCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([workspaceId, cacheUserKey, questionResultId])
  @@index([workspaceId])
  @@index([attemptId])
}

model workspace_quiz_favorite_questions {
  id                Int      @id @default(autoincrement())
  workspaceId       Int
  userId            Int?
  cacheUserKey      String   @default("anonymous")
  quizId            String
  quizChatId        Int
  attemptId         Int?
  questionResultId  Int?
  questionId        String
  questionType      String
  topic             String?
  difficulty        String?
  question          String
  optionsJson       String   @default("[]")
  correctAnswerJson String?
  userAnswerJson    String?
  analysis          String?
  sourceRefsJson    String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([workspaceId, cacheUserKey, quizId, questionId])
  @@index([workspaceId])
  @@index([questionResultId])
}

model recovery_codes {
  id        Int      @id @default(autoincrement())
  user_id   Int
  code_hash String
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model password_reset_tokens {
  id        Int      @id @default(autoincrement())
  user_id   Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model email_verification_codes {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  challenge_id String? @unique
  email      String
  purpose    String
  code_hash  String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  request_ip String?
  client_id  String?
  device_id  String?
  session_id String?
  createdAt  DateTime  @default(now())
  user       users?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, purpose])
  @@index([email, purpose])
  @@index([request_ip, createdAt])
  @@index([client_id, purpose])
  @@index([device_id, purpose])
}

model email_verification_grants {
  id           Int       @id @default(autoincrement())
  grant_id     String    @unique
  user_id      Int
  purpose      String
  scope        String
  grant_hash   String    @unique
  challenge_id String?
  email        String
  client_id    String?
  device_id    String?
  session_id   String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, scope])
  @@index([challenge_id])
  @@index([client_id, scope])
  @@index([expiresAt])
}

model email_verification_rate_limits {
  id           Int       @id @default(autoincrement())
  bucket_hash  String    @unique
  bucket_type  String
  purpose      String
  window_start DateTime
  count        Int       @default(0)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([bucket_type, purpose])
  @@index([blockedUntil])
  @@index([window_start])
}

model PasskeyCredential {
  id           Int       @id @default(autoincrement())
  userId       Int
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  transports   String    @default("[]")
  deviceType   String    @default("platform")
  deviceName   String    @default("This Device")
  browserName  String?
  platformName String?
  aaguid       String?
  provider     String    @default("unknown")
  providerName String    @default("来源待确认")
  backedUp     Boolean?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model PasskeyChallenge {
  id        Int      @id @default(autoincrement())
  challenge String   @unique
  type      String
  userId    Int?
  requestIp String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      users?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, userId])
  @@index([requestIp, createdAt])
  @@index([expiresAt])
}

model TrustedLoginDevice {
  id               Int       @id @default(autoincrement())
  userId           Int
  deviceId         String
  deviceName       String    @default("This Device")
  verifier         String
  publicCommitment String
  opaqueRegistrationRecord String?
  deviceSalt       String?
  lastChallengeAt  DateTime?
  failureCount     Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  user             users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([userId, revokedAt])
}

model athena_clients {
  id                       Int       @id @default(autoincrement())
  clientId                 String
  userId                   Int
  platform                 String
  deviceName               String?
  appVersion               String?
  trustLevel               String    @default("low")
  capabilities             String?
  capabilitySource         String    @default("unknown")
  publicKey                String?
  deviceFingerprintVersion String?
  signingSecretEncrypted   String?
  signingSecretVersion     String?
  signingSecretIssuedAt    DateTime?
  signingSecretRotatedAt   DateTime?
  createdAt                DateTime  @default(now())
  lastSeenAt               DateTime  @default(now())
  revokedAt                DateTime?
  user                     users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId, revokedAt])
}

model athena_request_nonces {
  id        Int      @id @default(autoincrement())
  clientId  String
  userId    Int?
  nonce     String
  requestId String?
  timestamp DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([clientId, nonce])
  @@index([expiresAt])
  @@index([clientId, createdAt])
}

model user_state_preferences {
  id        Int      @id @default(autoincrement())
  userId    Int
  namespace String
  scope     String   @default("global")
  value     String
  version   String   @default("1")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, namespace, scope])
  @@index([userId, namespace])
  @@index([updatedAt])
}

model ZkLoginAttempt {
  id               String    @id
  userId           Int
  deviceId         String
  serverLoginState String
  requestIp        String?
  userAgent        String?
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  user             users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
  @@index([expiresAt])
}

model document_vectors {
  id            Int      @id @default(autoincrement())
  docId         String
  vectorId      String
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @default(now())
}

model DocumentIndexStatus {
  id             Int       @id @default(autoincrement())
  workspaceId    Int
  docId          String?
  filePath       String
  fileHash       String    @default("")
  indexStatus    String    @default("pending")
  indexedAt      DateTime?
  errorMessage   String?
  chunkCount     Int       @default(0)
  embeddingCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, filePath])
  @@index([workspaceId])
  @@index([docId])
  @@index([filePath])
  @@index([fileHash])
  @@index([indexStatus])
}

model KnowledgeNode {
  id                       Int       @id @default(autoincrement())
  workspaceId              Int
  canonicalName            String
  canonicalKey             String
  aliases                  String    @default("[]")
  displayNameZh            String?
  displayNameEn            String?
  entityType               String    @default("concept")
  summary                  String?
  globalImportanceScore    Float     @default(0)
  workspaceImportanceScore Float     @default(0)
  recentImportanceScore    Float     @default(0)
  usageCount               Int       @default(0)
  recentUsageCount         Int       @default(0)
  lastReferencedAt         DateTime?
  embedding                String?
  embeddingModel           String?
  embeddingVersion         String?
  mergeLogicVersion        String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([workspaceId, canonicalKey])
  @@index([workspaceId, entityType])
  @@index([workspaceId, canonicalKey])
  @@index([workspaceId, globalImportanceScore])
  @@index([workspaceId, workspaceImportanceScore])
  @@index([workspaceId, recentImportanceScore])
  @@index([workspaceId, lastReferencedAt])
}

model KnowledgeEdge {
  id                      Int       @id @default(autoincrement())
  workspaceId             Int
  sourceNodeId            Int
  targetNodeId            Int
  relationType            String
  relationLabel           String?
  relationLabelZh         String?
  relationLabelEn         String?
  confidence              Float     @default(0)
  weight                  Float     @default(1)
  usageCount              Int       @default(0)
  lastReferencedAt        DateTime?
  extractionPromptVersion String
  mergeLogicVersion       String
  relationOntologyVersion String
  graphVersion            String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([workspaceId, sourceNodeId, targetNodeId, relationType])
