{
  "name": "anything-llm-server",
  "version": "2.1.4",
  "description": "Server endpoints to process or create content for chatting",
  "main": "index.js",
  "author": "Timothy Carambat (Mintplex Labs)",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18.12.1"
  },
  "scripts": {
    "auth:repair-foreign-keys": "node scripts/repair-auth-foreign-keys.js",
    "p0:db-audit": "node scripts/p0-database-audit.js",
    "password-credentials:audit": "node scripts/audit-password-credentials.js",
    "gate-credentials:repair": "node scripts/repair-gate-credentials.js",
    "gate-account:migrate": "node scripts/migrate-gate-account-connection.js",
    "primary-owner:transfer": "node scripts/transfer-primary-owner.js",
    "password-pepper:provision": "node scripts/provision-password-pepper.js",
    "user-root-keys:audit": "node scripts/audit-user-root-key-state.js",
    "user-root-keys:e2e-fixture": "node scripts/prepare-user-root-live-fixture.js",
    "user-domain-wraps:migrate": "node scripts/migrate-user-domain-wraps.js",
    "user-domain-wraps:audit": "node scripts/audit-user-domain-wrap-coverage.js",
    "user-domain-wraps:e2e": "node scripts/verify-user-domain-wrap-e2e.js",
    "keyctl": "node scripts/athena-keyctl.js",
    "dev": "cross-env NODE_ENV=development nodemon --ignore documents --ignore vector-cache --ignore storage --ignore swagger --ignore public --trace-warnings index.js",
    "start": "cross-env NODE_ENV=production node index.js",
    "lint": "eslint --fix .",
    "lint:check": "eslint . && yarn data-access:enforce && yarn data-access:error-semantics && yarn data-security:audit && yarn endpoint:error-status && yarn key-custody:audit && yarn crypto-agility:audit && yarn crypto-assets:audit",
    "data-access:audit": "node scripts/data-access-bypass-check.js",
    "data-access:baseline": "node scripts/data-access-bypass-check.js --update-baseline",
    "data-access:enforce": "cross-env DATA_ACCESS_MODE=enforce node scripts/data-access-bypass-check.js",
    "data-access:error-semantics": "node scripts/audit-model-error-semantics.js",
    "data-security:audit": "node scripts/audit-data-security-catalog.js",
    "security:evidence": "node scripts/verify-enterprise-security-evidence.js",
    "security:evidence:sign": "node scripts/sign-enterprise-security-evidence.js",
    "security:drill": "node scripts/disaster-recovery-drill.js",
    "key-closure": "node scripts/finalize-key-closure.js",
    "key-closure:evidence": "node scripts/generate-key-closure-evidence.js",
    "endpoint:error-status": "node scripts/audit-endpoint-error-status.js",
    "key-custody:audit": "node scripts/audit-key-custody-boundaries.js",
    "crypto-agility:audit": "node scripts/audit-crypto-agility-boundaries.js",
    "crypto-assets:audit": "node scripts/audit-crypto-asset-inventory.js",
    "crypto-runtime:verify": "node scripts/verify-crypto-runtime-capabilities.js",
    "crypto-hybrid:verify": "node scripts/verify-pq-hybrid-interoperability.js",
    "crypto-pq:resilience": "node scripts/verify-pq-resilience.js",
    "crypto-pq:provision": "node scripts/provision-pq-signing-keys.js",
    "edge-tls:evaluate": "node scripts/evaluate-hybrid-tls-edge.js",
    "edge-tls:summarize": "node scripts/summarize-hybrid-tls-evidence.js",
    "edge-tls:rollout": "node scripts/manage-hybrid-tls-rollout.js",
    "sync-v2:audit": "node scripts/sync-v2-shadow-audit.js",
    "sync-v2:benchmark": "node scripts/sync-v2-benchmark.js",
    "operations:shadow:evaluate": "node scripts/evaluate-operations-shadow-agents.js",
    "operations:verify": "node scripts/verify-ai-operations-center.js",
    "operations:consumer": "node scripts/manage-operations-consumer.js",
    "operations:reconcile": "node scripts/reconcile-operations-events.js",
    "user-state:drafts:migrate": "node scripts/migrate-user-state-draft-encryption.js",
    "chat-chain:benchmark": "node scripts/chat-chain-incremental-benchmark.js",
    "chat-objects:migrate": "node scripts/migrate-chat-content-objects.js",
    "chat-objects:admin": "node scripts/content-object-admin.js",
    "prisma:postgresql:schema": "node scripts/generate-postgresql-prisma-schema.js",
    "prisma:postgresql:generate": "yarn prisma:postgresql:schema && cross-env DATABASE_URL=postgresql://schema:validation@127.0.0.1:5432/athena prisma generate --schema=./prisma/postgresql/schema.prisma",
    "prisma:postgresql:validate": "yarn prisma:postgresql:schema && cross-env DATABASE_URL=postgresql://schema:validation@127.0.0.1:5432/athena prisma validate --schema=./prisma/postgresql/schema.prisma",
    "prisma:postgresql:runtime": "node scripts/postgresql-prisma-runtime.js",
    "database:postgresql:migrate": "node scripts/migrate-sqlite-to-postgresql.js",
    "sync-v2:materialize": "node scripts/sync-v2-shadow-audit.js --materialize",
    "sync-v2:repair": "node scripts/sync-v2-shadow-audit.js --repair",
    "sync-v2:outbox-admin": "node scripts/sync-v2-outbox-admin.js",
    "security-audit:verify": "node scripts/verify-security-audit-ledger.js",
    "security-audit:resign-checkpoints": "node scripts/resign-security-audit-checkpoints.js",
    "swagger": "node ./swagger/init.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/storage/",
      "<rootDir>/generated/postgresql-main/",
      "<rootDir>/generated/postgresql-auth/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/storage/",
      "<rootDir>/generated/postgresql-main/",
      "<rootDir>/generated/postgresql-auth/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/storage/",
      "<rootDir>/generated/postgresql-main/",
      "<rootDir>/generated/postgresql-auth/"
    ]
  },
