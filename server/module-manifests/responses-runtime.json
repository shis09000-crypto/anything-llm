  "version": "1.0.0",
  "kind": "service",
  "owner": "ai-platform",
  "criticality": "critical",
  "runtimeRole": "responses-runtime",
  "sourcePaths": [
    "server/responses-runtime.js",
    "server/utils/responsesRuntime/"
