{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.2",
  "id": "reader-worker",
  "name": "Reader Worker",
  "version": "2.6.14",
  "kind": "worker",
  "owner": "knowledge",
  "criticality": "medium",
  "runtimeRole": "reader-worker",
  "sourcePaths": [
    "server/reader-worker.js",
    "server/modules/reader/",
    "server/utils/readerWorker/"
  ],
  "capabilities": [
    "preview",
    "thumbnail",
    "classification",
    "postprocess"
  ],
  "routes": {
    "public": [],
    "internal": [
      "/health",
      "/snapshot"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      }
    ]
  },
  "rpc": {
    "provides": [
      "reader.process",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "sync.events.append",
      "operations.ingest-batch",
      "key-custody.audit-descriptor"
    ]
  },
  "events": {
    "publishes": [
      "reader.job.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "reader.requested"
    ]
  },
  "data": {
    "schemas": [
      "knowledge_reader"
    ],
    "objectPrefixes": [
      "knowledge/previews"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/reader-worker",
    "keyDomains": [
      "file"
    ],
    "allowedCallers": [
      "knowledge-ingest",
      "background-worker",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/reader-worker",
    "healthPath": "/health",
    "readinessPath": "/snapshot",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.99,
    "reconnectP95Ms": 0
  },
  "dependsOn": [
    "key-custody",
    "infra:postgresql",
    "infra:object-store",
    "infra:nats"
  ],
  "domain": "knowledge",
  "responsibilities": [
    "preview",
    "thumbnail",
    "classification",
    "postprocess"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "reader.process",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/reader.process/request/1.0",
        "responseSchema": "athena://contracts/reader.process/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "sync.events.append",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/sync.events.append/request/1.0",
        "responseSchema": "athena://contracts/sync.events.append/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "required",
        "dataClassification": "confidential",
        "targetModule": "sync-v2",
        "requiredForReadiness": false
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal",
        "targetModule": "operations-plane",
        "requiredForReadiness": false
      },
      {
        "id": "key-custody.audit-descriptor",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.audit-descriptor/request/1.0",
        "responseSchema": "athena://contracts/key-custody.audit-descriptor/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential",
        "targetModule": "key-custody",
        "requiredForReadiness": true
      }
    ]
  },
  "ownership": {
    "dataSchemas": [
      "knowledge_reader"
    ],
    "objectPrefixes": [
      "knowledge/previews"
    ],
    "keyDomains": [
      "file"
    ],
    "configuration": [
      "runtime:reader-worker"
    ],
    "runtimeState": [
      "module-instance:reader-worker"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery",
      "data",
      "cache"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 180000,
    "rpoMs": 60000,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  },
  "streams": {
    "provides": [],
    "consumes": []
  },
  "eventContracts": {
    "publishes": [
      {
        "subject": "reader.job.*",
        "payloadSchema": "athena://events/reader.job.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "reader.job.*.DLQ"
      },
      {
        "subject": "module.lifecycle.*",
        "payloadSchema": "athena://events/module.lifecycle.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "module.lifecycle.*.DLQ"
      }
    ],
    "subscribes": [
      {
        "subject": "reader.requested",
        "payloadSchema": "athena://events/reader.requested/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "reader.requested.DLQ"
      }
    ]
  }
}
