{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.2",
  "id": "scheduler",
  "name": "Unified Scheduler",
  "version": "2.6.14",
  "kind": "control-plane",
  "owner": "platform",
  "criticality": "high",
  "runtimeRole": "scheduler",
  "sourcePaths": [
    "server/scheduler.js",
    "server/utils/scheduler/",
    "server/endpoints/scheduledJobs.js",
    "server/jobs/run-scheduled-job.js",
    "server/models/scheduledJob.js"
  ],
  "capabilities": [
    "durable-jobs",
    "owner-binding",
    "preapproval",
    "checkpoint",
    "retry"
  ],
  "routes": {
    "public": [
      "/api/scheduled-jobs/"
    ],
    "internal": [
      "/internal/v1/scheduler/jobs/",
      "/internal/drain"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      },
      {
        "method": "POST",
        "path": "/internal/v1/scheduler/jobs/:jobId/sync",
        "capability": "scheduler.create"
      },
      {
        "method": "DELETE",
        "path": "/internal/v1/scheduler/jobs/:jobId",
        "capability": "scheduler.create"
      },
      {
        "method": "POST",
        "path": "/internal/v1/scheduler/jobs/:jobId/trigger",
        "capability": "scheduler.status"
      },
      {
        "method": "POST",
        "path": "/internal/v1/scheduler/jobs/:jobId/runs/:runId/kill",
        "capability": "scheduler.status"
      }
    ]
  },
  "rpc": {
    "provides": [
      "scheduler.create",
      "scheduler.status",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "chat.thread-title.reconcile",
      "responses.background.claim",
      "responses.background.execute",
      "responses.maintenance",
      "agent.submit",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "operations.ingest-batch",
      "tool.invoke",
      "key-custody.audit-descriptor"
    ]
  },
  "events": {
    "publishes": [
      "scheduler.run.*",
      "background.requested",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "agent.run.*",
      "tool.invocation.*"
    ]
  },
  "data": {
    "schemas": [
      "scheduler"
    ],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/scheduler",
    "keyDomains": [
      "agent"
    ],
    "allowedCallers": [
      "athena-api",
      "operations-plane",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/scheduler",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "agent-runtime",
    "responses-runtime",
    "tool-runtime",
    "infra:postgresql",
    "infra:nats",
    "key-custody"
  ],
  "domain": "platform-control",
  "responsibilities": [
    "durable-jobs",
    "owner-binding",
    "preapproval",
    "checkpoint",
    "retry"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "scheduler.create",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/scheduler.create/request/1.0",
        "responseSchema": "athena://contracts/scheduler.create/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
