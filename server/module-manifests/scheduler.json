  "ownership": {
    "dataSchemas": [
      "scheduler"
    ],
    "objectPrefixes": [],
    "keyDomains": [
      "agent"
    ],
    "configuration": [
      "runtime:scheduler"
    ],
    "runtimeState": [
      "module-instance:scheduler"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery",
      "data"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  },
  "streams": {
    "provides": [],
    "consumes": []
  },
  "eventContracts": {
    "publishes": [
      {
        "subject": "scheduler.run.*",
        "payloadSchema": "athena://events/scheduler.run.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "scheduler.run.*.DLQ"
      },
      {
        "subject": "background.requested",
        "payloadSchema": "athena://events/background.requested/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "background.requested.DLQ"
      },
      {
        "subject": "module.lifecycle.*",
        "payloadSchema": "athena://events/module.lifecycle.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "module.lifecycle.*.DLQ"
      }
    ],
    "subscribes": [
      {
        "subject": "agent.run.*",
        "payloadSchema": "athena://events/agent.run.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "agent.run.*.DLQ"
      },
      {
        "subject": "tool.invocation.*",
