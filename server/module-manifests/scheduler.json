{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "scheduler",
  "name": "Unified Scheduler",
  "version": "1.0.0",
  "kind": "control-plane",
  "owner": "platform",
  "criticality": "high",
  "runtimeRole": "scheduler",
  "sourcePaths": [
    "server/scheduler.js",
    "server/utils/scheduler/",
    "server/endpoints/scheduledJobs.js",
    "server/jobs/run-scheduled-job.js",
    "server/models/scheduledJob.js"
  ],
  "capabilities": [
    "durable-jobs",
    "owner-binding",
    "preapproval",
    "checkpoint",
    "retry"
  ],
  "routes": {
    "public": ["/api/scheduled-jobs/"],
    "internal": ["/internal/v1/scheduler/jobs/", "/internal/drain"]
  },
  "rpc": {
    "provides": [
      "scheduler.create",
      "scheduler.status",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "agent.submit",
      "responses.background.claim",
      "responses.background.execute",
      "responses.maintenance",
      "chat.thread-title.reconcile",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "operations.ingest-batch",
      "tool.invoke"
    ]
  },
  "events": {
    "publishes": [
      "scheduler.run.*",
      "background.requested",
      "module.lifecycle.*"
    ],
    "subscribes": ["agent.run.*", "tool.invocation.*"]
  },
  "data": {
    "schemas": ["scheduler"],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/scheduler",
    "keyDomains": ["agent"],
    "allowedCallers": ["athena-api", "operations-plane", "coordination-plane"],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/scheduler",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "agent-runtime",
    "responses-runtime",
    "tool-runtime",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "platform-control",
  "responsibilities": [
    "durable-jobs",
    "owner-binding",
    "preapproval",
    "checkpoint",
    "retry"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "scheduler.create",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/scheduler.create/request/1.0",
        "responseSchema": "athena://contracts/scheduler.create/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "scheduler.status",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/scheduler.status/request/1.0",
        "responseSchema": "athena://contracts/scheduler.status/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "chat.thread-title.reconcile",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/chat.thread-title.reconcile/request/1.0",
        "responseSchema": "athena://contracts/chat.thread-title.reconcile/response/1.0",
        "errorCodes": ["contract_invalid", "deadline_exceeded", "caller_denied", "dependency_unavailable"],
        "timeoutMs": 300000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "responses.background.claim",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/responses.background.claim/request/1.0",
        "responseSchema": "athena://contracts/responses.background.claim/response/1.0",
        "errorCodes": ["caller_denied", "dependency_unavailable"],
        "timeoutMs": 10000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "responses.background.execute",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/responses.background.execute/request/1.0",
        "responseSchema": "athena://contracts/responses.background.execute/response/1.0",
        "errorCodes": [
          "caller_denied",
          "response_not_found",
          "response_state_conflict"
        ],
        "timeoutMs": 900000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "responses.maintenance",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/responses.maintenance/request/1.0",
        "responseSchema": "athena://contracts/responses.maintenance/response/1.0",
        "errorCodes": [
          "caller_denied",
          "response_compaction_unavailable",
          "dependency_unavailable"
        ],
        "timeoutMs": 300000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "agent.submit",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/agent.submit/request/1.0",
        "responseSchema": "athena://contracts/agent.submit/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "tool.invoke",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/tool.invoke/request/1.0",
        "responseSchema": "athena://contracts/tool.invoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ]
  },
  "ownership": {
    "dataSchemas": ["scheduler"],
    "objectPrefixes": [],
    "keyDomains": ["agent"],
    "configuration": ["runtime:scheduler"],
    "runtimeState": ["module-instance:scheduler"]
  },
  "coordination": {
    "centers": ["task", "recovery", "data"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
