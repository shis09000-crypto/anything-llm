        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "browser-egress.route.resolve",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/browser-egress.route.resolve/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.route.resolve/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "browser-egress.grant.issue",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.issue/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.issue/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.grant.renew",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.renew/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.renew/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.grant.revoke",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.revoke/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.revoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.health",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/browser-egress.health/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.health/response/1.0",
        "errorCodes": ["caller_denied", "dependency_unavailable"],
        "timeoutMs": 10000,
        "idempotency": "none",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": ["browser_plane"],
    "objectPrefixes": ["browser/profiles", "browser/artifacts"],
    "keyDomains": ["browser-profile"],
    "configuration": ["runtime:browser-plane"],
    "runtimeState": ["module-instance:browser-plane"]
  },
  "coordination": {
    "centers": ["task", "recovery", "data"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 180000,
    "rpoMs": 60000,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
