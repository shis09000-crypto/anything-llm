{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.0",
  "id": "browser-plane",
  "name": "Browser Plane Control Service",
  "version": "1.0.0",
  "kind": "control-plane",
  "owner": "browser-platform",
  "criticality": "medium",
  "runtimeRole": "browser-plane",
  "sourcePaths": [
    "server/browser-plane.js",
    "server/utils/browserPlane/",
    "server/modules/browser/"
  ],
  "capabilities": [
    "browser-sessions",
    "browser-workspaces",
    "browser-policy",
    "browser-node-routing",
    "browser-audit"
  ],
  "routes": {
    "public": ["/api/browser/"],
    "internal": ["/internal/v1/browser/sessions", "/internal/v1/browser/nodes"]
  },
  "rpc": {
    "provides": [
      "browser.session",
      "browser.task",
      "browser.workspace",
      "browser.node"
    ],
    "consumes": ["browser.worker", "identity.assert"]
  },
  "events": {
    "publishes": ["browser.session.*", "browser.task.*", "browser.node.*"],
    "subscribes": ["approval.*", "sync.client.*"]
  },
  "data": {
    "schemas": ["browser_plane"],
    "objectPrefixes": ["browser/profiles", "browser/artifacts"]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/browser-plane",
    "keyDomains": ["browser-profile"],
    "allowedCallers": [
      "athena-api",
      "tool-runtime",
      "scheduler",
      "operations-plane",
      "sync-v2"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/browser-plane",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "browser-worker",
    "authentication",
    "key-custody",
    "infra:postgresql",
    "infra:nats",
    "infra:object-store"
  ]
}
