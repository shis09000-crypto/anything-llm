{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.0",
  "id": "edge-web",
  "name": "Edge and Web Gateway",
  "version": "1.0.0",
  "kind": "gateway",
  "owner": "platform",
  "criticality": "critical",
  "runtimeRole": "edge-web",
  "sourcePaths": ["frontend/src/", "docker/nginx-web.conf.template"],
  "capabilities": ["static-web", "compatibility-routing", "blue-green"],
  "routes": { "public": ["/", "/api/"], "internal": ["/health", "/ready"] },
  "rpc": { "provides": [], "consumes": ["identity.assert", "control.dispatch"] },
  "events": { "publishes": ["edge.route.*"], "subscribes": ["deployment.slot.*"] },
  "data": { "schemas": [], "objectPrefixes": ["web/releases"] },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/edge-web",
    "keyDomains": [],
    "allowedCallers": ["public-client", "operations-plane"],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/edge-web",
    "healthPath": "/health",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": ["authentication", "athena-api", "sync-v2"]
}
