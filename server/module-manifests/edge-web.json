{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "edge-web",
  "name": "Edge and Web Gateway",
  "version": "1.1.0",
  "kind": "gateway",
  "owner": "platform",
  "criticality": "critical",
  "runtimeRole": "edge-web",
  "sourcePaths": [
    "frontend/src/",
    "docker/nginx-web.conf.template",
    "server/edge-probe.js",
    "server/utils/microModules/edgeRouteProbes.js"
  ],
  "capabilities": [
    "static-web",
    "compatibility-routing",
    "dynamic-service-discovery",
    "public-route-readiness",
    "blue-green"
  ],
  "routes": {
    "public": [
      "/",
      "/api/"
    ],
    "internal": [
      "/health",
      "/ready"
    ]
  },
  "rpc": {
    "provides": [
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "control.dispatch",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": [
      "edge.route.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "deployment.slot.*"
    ]
  },
  "data": {
    "schemas": [],
    "objectPrefixes": [
      "web/releases"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/edge-web",
    "keyDomains": [],
    "allowedCallers": [
      "public-client",
      "operations-plane",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/edge-web",
    "healthPath": "/health",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "athena-api",
    "sync-v2"
  ],
  "domain": "platform-control",
  "responsibilities": [
    "static-web",
    "compatibility-routing",
    "dynamic-service-discovery",
    "public-route-readiness",
    "blue-green"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "control.dispatch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/control.dispatch/request/1.0",
        "responseSchema": "athena://contracts/control.dispatch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "identity.assert",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/identity.assert/request/1.0",
        "responseSchema": "athena://contracts/identity.assert/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": [],
    "objectPrefixes": [
      "web/releases"
    ],
    "keyDomains": [],
    "configuration": [
      "runtime:edge-web"
    ],
    "runtimeState": [
      "module-instance:edge-web"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery",
      "cache"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 30000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
