{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "tool-runtime",
  "name": "Tool Registry and Broker",
  "version": "2.6.14",
  "kind": "control-plane",
  "owner": "ai-platform",
  "criticality": "high",
  "runtimeRole": "tool-broker",
  "sourcePaths": [
    "server/utils/agents/aibitat/plugins/",
    "server/utils/plugins/"
  ],
  "capabilities": [
    "registry",
    "eligibility",
    "approval",
    "capability-broker",
    "worker-routing"
  ],
  "routes": {
    "public": ["/api/agent-skills/"],
    "internal": ["/internal/v1/tools/invoke", "/internal/v1/tools/catalog"]
  },
  "rpc": {
    "provides": [
      "tool.invoke",
      "tool.catalog",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "browser.session",
      "browser.task",
      "browser.workspace",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "crypto.account",
      "crypto.market",
      "identity.assert",
      "key-custody.audit-descriptor",
      "knowledge.ingest",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": ["tool.invocation.*", "tool.registry.*", "module.lifecycle.*"],
    "subscribes": ["approval.*", "crypto.*"]
  },
  "data": {
    "schemas": ["tools"],
    "objectPrefixes": ["tool/results"]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/tool-broker",
    "keyDomains": ["agent"],
    "allowedCallers": [
      "agent-runtime",
      "scheduler",
      "athena-api",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/tool-broker",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "key-custody",
    "crypto-market",
    "crypto-account-access",
    "browser-plane",
    "knowledge-ingest",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "ai-runtime",
  "responsibilities": [
    "registry",
    "eligibility",
    "approval",
    "capability-broker",
    "worker-routing"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "tool.invoke",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/tool.invoke/request/1.0",
        "responseSchema": "athena://contracts/tool.invoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "tool.catalog",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/tool.catalog/request/1.0",
