{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "browser-egress",
  "name": "Browser Egress Control Service",
  "version": "1.0.0",
  "kind": "control-plane",
  "owner": "browser-platform",
  "criticality": "medium",
  "runtimeRole": "browser-egress",
  "sourcePaths": ["server/browser-egress.js", "server/utils/browserEgress/"],
  "capabilities": [
    "browser-egress-route",
    "browser-egress-grants",
    "browser-egress-health"
  ],
  "routes": {
    "public": [],
    "internal": ["/internal/v1/browser-egress/"]
  },
  "rpc": {
    "provides": [
      "browser-egress.route.resolve",
      "browser-egress.grant.issue",
      "browser-egress.grant.renew",
      "browser-egress.grant.revoke",
      "browser-egress.health",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "key-custody.wrap",
      "key-custody.unwrap",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": ["browser.egress.*", "module.lifecycle.*"],
    "subscribes": []
  },
  "data": {
    "schemas": ["browser_egress"],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/browser-egress",
    "keyDomains": ["browser-egress"],
    "allowedCallers": [
      "authentication",
      "browser-plane",
      "coordination-plane",
      "operations-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/browser-egress",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "key-custody",
    "infra:postgresql",
    "infra:nats",
    "infra:browser-egress-gateway"
  ],
  "domain": "browser-egress",
  "responsibilities": [
    "browser-egress-route",
    "browser-egress-grants",
    "browser-egress-health"
  ],
  "nonResponsibilities": [
    "browser-rendering",
    "browser-session-control",
    "foreign-schema-writes",
    "public-vpn-service"
  ],
  "contracts": {
    "provides": [
      {
        "id": "browser-egress.route.resolve",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/browser-egress.route.resolve/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.route.resolve/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "browser-egress.grant.issue",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.issue/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.issue/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.grant.renew",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.renew/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.renew/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.grant.revoke",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/browser-egress.grant.revoke/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.grant.revoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 15000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "browser-egress.health",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/browser-egress.health/request/1.0",
        "responseSchema": "athena://contracts/browser-egress.health/response/1.0",
        "errorCodes": ["caller_denied", "dependency_unavailable"],
        "timeoutMs": 10000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "key-custody.wrap",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.wrap/request/1.0",
        "responseSchema": "athena://contracts/key-custody.wrap/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 10000,
        "idempotency": "supported",
        "dataClassification": "restricted"
      },
      {
        "id": "key-custody.unwrap",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.unwrap/request/1.0",
        "responseSchema": "athena://contracts/key-custody.unwrap/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 10000,
        "idempotency": "supported",
        "dataClassification": "restricted"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": ["browser_egress"],
    "objectPrefixes": [],
    "keyDomains": ["browser-egress"],
    "configuration": ["runtime:browser-egress"],
    "runtimeState": ["module-instance:browser-egress"]
  },
  "coordination": {
    "centers": ["task", "recovery", "data"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": { "defaultMode": "observe", "links": [] }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 180000,
    "rpoMs": 60000,
    "forbiddenDegradations": [
      "security-downgrade",
      "route-fallback",
      "credential-exposure"
    ]
  }
}
