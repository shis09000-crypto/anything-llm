{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "browser-worker",
  "name": "Browser Worker Service",
  "version": "2.6.14",
  "kind": "worker",
  "owner": "browser-platform",
  "criticality": "medium",
  "runtimeRole": "browser-worker",
  "sourcePaths": [
    "server/browser-worker.js",
    "server/utils/browserPlane/workerRuntime.js",
    "server/utils/browserPlane/profileStore.js"
  ],
  "capabilities": [
    "playwright-chromium",
    "browser-driver",
    "profile-checkpoint",
    "capture",
    "downloads"
  ],
  "routes": {
    "public": [
      "/browser-stream"
    ],
    "internal": [
      "/internal/v1/browser/sessions",
      "/internal/v1/browser/profiles"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions",
        "capability": "browser.worker"
      },
      {
        "method": "GET",
        "path": "/internal/v1/browser/sessions/:sessionId",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/stream-ticket",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/actions",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/tabs",
        "capability": "browser.worker"
      },
      {
        "method": "DELETE",
        "path": "/internal/v1/browser/sessions/:sessionId/tabs/:tabId",
        "capability": "browser.worker"
      },
      {
        "method": "GET",
        "path": "/internal/v1/browser/sessions/:sessionId/cookies",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/risk-inspection",
        "capability": "browser.worker"
      },
      {
        "method": "GET",
        "path": "/internal/v1/browser/sessions/:sessionId/downloads/:downloadId",
        "capability": "browser.worker"
      },
      {
        "method": "DELETE",
        "path": "/internal/v1/browser/sessions/:sessionId/downloads/:downloadId",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/cookies/clear",
        "capability": "browser.worker"
      },
      {
        "method": "POST",
        "path": "/internal/v1/browser/sessions/:sessionId/close",
        "capability": "browser.worker"
      },
      {
        "method": "DELETE",
        "path": "/internal/v1/browser/profiles/:profileId",
        "capability": "browser.worker"
      }
    ]
  },
  "rpc": {
    "provides": [
      "browser.worker",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "key-custody.unwrap",
      "key-custody.wrap",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": [
      "browser.worker.*",
      "module.lifecycle.*"
    ],
    "subscribes": []
  },
  "data": {
    "schemas": [],
    "objectPrefixes": [
      "browser/profiles",
      "browser/artifacts"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/browser-worker",
    "keyDomains": [
      "browser-profile"
    ],
    "allowedCallers": [
      "browser-plane",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/browser-worker",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.99,
    "reconnectP95Ms": 5000
  },
  "dependsOn": [
    "key-custody",
    "infra:object-store"
  ],
  "domain": "browser",
  "responsibilities": [
    "playwright-chromium",
    "browser-driver",
    "profile-checkpoint",
    "capture",
    "downloads"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "browser.worker",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/browser.worker/request/1.0",
        "responseSchema": "athena://contracts/browser.worker/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "key-custody.unwrap",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.unwrap/request/1.0",
        "responseSchema": "athena://contracts/key-custody.unwrap/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "key-custody.wrap",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.wrap/request/1.0",
        "responseSchema": "athena://contracts/key-custody.wrap/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": [],
    "objectPrefixes": [
      "browser/profiles",
      "browser/artifacts"
    ],
    "keyDomains": [
      "browser-profile"
    ],
    "configuration": [
      "runtime:browser-worker"
    ],
    "runtimeState": [
      "module-instance:browser-worker"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 180000,
    "rpoMs": 60000,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
