{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "knowledge-ingest",
  "name": "Knowledge Ingest",
  "version": "1.1.0",
  "kind": "service",
  "owner": "knowledge",
  "criticality": "high",
  "runtimeRole": "knowledge-ingest",
  "sourcePaths": [
    "server/knowledge-ingest.js",
    "server/utils/DocumentEmbeddingBatch/",
    "server/services/documentVectorConsistencyService.js"
  ],
  "capabilities": [
    "parse",
    "chunk",
    "embed",
    "index"
  ],
  "routes": {
    "public": [
      "/api/document/"
    ],
    "internal": [
      "/internal/v1/knowledge/browser-ingest"
    ]
  },
  "rpc": {
    "provides": [
      "knowledge.ingest",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "collector.parse",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "operations.ingest-batch",
      "reader.process"
    ]
  },
  "events": {
    "publishes": [
      "knowledge.index.*",
      "reader.requested",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "reader.job.*"
    ]
  },
  "data": {
    "schemas": [
      "knowledge_ingest"
    ],
    "objectPrefixes": [
      "knowledge/documents",
      "knowledge/previews"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/knowledge-ingest",
    "keyDomains": [
      "file"
    ],
    "allowedCallers": [
      "athena-api",
      "background-worker",
      "tool-runtime",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/knowledge-ingest",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "collector",
    "reader-worker",
    "rag",
    "infra:postgresql",
    "infra:object-store",
    "infra:nats"
  ],
  "domain": "knowledge",
  "responsibilities": [
    "parse",
    "chunk",
    "embed",
    "index"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
