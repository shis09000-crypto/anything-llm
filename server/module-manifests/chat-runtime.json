{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "chat-runtime",
  "name": "Chat Runtime",
  "version": "1.0.0",
  "kind": "service",
  "owner": "ai-platform",
  "criticality": "critical",
  "runtimeRole": "chat-runtime",
  "sourcePaths": [
    "server/endpoints/chat.js",
    "server/utils/chats/",
    "server/models/chatStreamRun.js"
  ],
  "capabilities": [
    "context",
    "streaming",
    "durable-runs",
    "resume",
    "thread-memory"
  ],
  "routes": {
    "public": ["/api/workspace/:slug/chat"],
    "internal": [
      "/internal/v1/chat/runs",
      "/internal/v1/chat/runs/:id/drain",
      "/internal/v1/chat/memory/status",
      "/internal/v1/chat/memory/compact",
      "/internal/v1/chat/memory/context/resolve",
      "/internal/v1/chat/agent-turns/reserve",
      "/internal/v1/chat/agent-turns/finalize"
    ]
  },
  "rpc": {
    "provides": [
      "chat.submit",
      "chat.status",
      "chat.memory.status",
      "chat.memory.compact",
      "chat.memory.context.resolve",
      "chat.agent-turn.reserve",
      "chat.agent-turn.finalize",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "identity.audit.append",
      "identity.client.attach",
      "identity.realtime-ticket.consume",
      "identity.request-signing.verify",
      "identity.session.validate",
      "identity.user-domain-wrap.queue",
      "key-custody.wrap",
      "key-custody.unwrap",
      "model.stream",
      "agent.submit",
      "responses.create",
      "responses.stream",
      "sync.events.append",
      "operations.ingest-batch",
      "rag.retrieve"
    ]
  },
  "events": {
    "publishes": ["chat.run.*", "module.lifecycle.*"],
    "subscribes": ["model.stream.*", "rag.result.*"]
  },
  "data": {
    "schemas": ["chat"],
    "objectPrefixes": ["chat/content"]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/chat-runtime",
    "keyDomains": ["data"],
    "allowedCallers": [
      "edge-web",
      "athena-api",
      "agent-runtime",
      "coordination-plane",
      "responses-runtime"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/chat-runtime",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "agent-runtime",
    "key-custody",
    "model-gateway",
    "responses-runtime",
    "rag",
    "sync-v2",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "ai-runtime",
  "responsibilities": ["context", "streaming", "durable-runs", "resume"],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
