{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.2",
  "id": "operations-plane",
  "name": "AI Operations Plane",
  "version": "2.6.14",
  "kind": "control-plane",
  "owner": "sre",
  "criticality": "high",
  "runtimeRole": "operations-plane",
  "sourcePaths": [
    "server/operations-plane.js",
    "server/endpoints/operations.js",
    "server/utils/operations/",
    "server/utils/observability/"
  ],
  "capabilities": [
    "semantic-events",
    "timeline",
    "state-graph",
    "deployment-guard",
    "module-health-probes",
    "cross-module-correlation"
  ],
  "routes": {
    "public": [
      "/api/operations/"
    ],
    "internal": [
      "/internal/v1/operations/"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/ingest",
        "capability": "operations.ingest-batch"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/ingest-batch",
        "capability": "operations.ingest-batch"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/health",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/services",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/agents",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/shadow-agents",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/evaluations/latest",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/evaluations/corpus",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/actions/catalog",
        "capability": "operations.catalog"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/actions/runs/query",
        "capability": "operations.guard"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/actions/runs/:runId",
        "capability": "operations.guard"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/actions/runs",
        "capability": "operations.guard"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/actions/runs/:runId/decide",
        "capability": "operations.guard"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/actions/runs/:runId/execute",
        "capability": "operations.guard"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/actions/runs/:runId/reconcile",
        "capability": "operations.guard"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/timeline",
        "capability": "operations.catalog"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/state-graph",
        "capability": "operations.catalog"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/flows",
        "capability": "operations.catalog"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/explain",
        "capability": "operations.catalog"
      },
      {
        "method": "POST",
        "path": "/internal/v1/operations/module-health/refresh",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/module-health",
        "capability": "operations.catalog"
      },
      {
        "method": "GET",
        "path": "/internal/v1/operations/infrastructure-health",
        "capability": "operations.catalog"
      }
    ]
  },
  "rpc": {
    "provides": [
      "module.describe",
      "module.drain",
      "module.lifecycle.query",
      "module.quiesce",
      "module.resume",
      "module.self-test",
      "operations.catalog",
      "operations.guard",
      "operations.ingest-batch"
    ],
    "consumes": [
      "coordination.status",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "operations.shadow.evaluate"
    ]
  },
  "events": {
    "publishes": [
      "operations.action.*",
      "deployment.slot.*",
      "operations.semantic.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "*"
    ]
  },
  "data": {
    "schemas": [],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/operations-plane",
    "keyDomains": [
      "audit"
    ],
    "allowedCallers": [
      "agent-runtime",
      "athena-api",
      "authentication",
      "background-worker",
      "browser-plane",
      "browser-worker",
      "browser-egress",
      "chat-runtime",
      "collector",
      "coordination-plane",
      "crypto-account-access",
      "crypto-forecast",
      "crypto-market",
      "edge-web",
      "key-custody",
      "knowledge-ingest",
      "model-gateway",
      "operations-shadow-agents",
      "rag",
      "reader-worker",
      "responses-runtime",
      "scheduler",
      "sync-v2",
      "tool-runtime"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/operations-plane",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "infra:nats",
    "infra:clickhouse",
    "infra:otel"
  ],
  "domain": "operations",
  "responsibilities": [
    "semantic-events",
    "timeline",
    "state-graph",
    "deployment-guard",
    "module-health-probes",
    "cross-module-correlation"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "operations.catalog",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/operations.catalog/request/1.0",
        "responseSchema": "athena://contracts/operations.catalog/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "operations.guard",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.guard/request/1.0",
        "responseSchema": "athena://contracts/operations.guard/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ],
    "consumes": [
      {
        "id": "coordination.status",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/coordination.status/request/1.0",
        "responseSchema": "athena://contracts/coordination.status/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "operations.shadow.evaluate",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.shadow.evaluate/request/1.0",
        "responseSchema": "athena://contracts/operations.shadow.evaluate/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal",
        "targetModule": "operations-shadow-agents",
        "requiredForReadiness": false
      }
    ]
  },
  "ownership": {
    "dataSchemas": [],
    "objectPrefixes": [],
    "keyDomains": [
      "audit"
    ],
    "configuration": [
      "runtime:operations-plane"
    ],
    "runtimeState": [
      "module-instance:operations-plane"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": [
        {
          "caller": "*",
          "capability": "operations.ingest-batch",
          "mode": "enforce"
        }
      ]
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  },
  "streams": {
    "provides": [],
    "consumes": []
  },
  "eventContracts": {
    "publishes": [
      {
        "subject": "operations.action.*",
        "payloadSchema": "athena://events/operations.action.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "operations.action.*.DLQ"
      },
      {
        "subject": "deployment.slot.*",
        "payloadSchema": "athena://events/deployment.slot.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "deployment.slot.*.DLQ"
      },
      {
        "subject": "operations.semantic.*",
        "payloadSchema": "athena://events/operations.semantic.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "operations.semantic.*.DLQ"
      },
      {
        "subject": "module.lifecycle.*",
        "payloadSchema": "athena://events/module.lifecycle.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "module.lifecycle.*.DLQ"
      }
    ],
    "subscribes": [
      {
        "subject": "*",
        "payloadSchema": "athena://events/*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "*.DLQ"
      }
    ]
  }
}
