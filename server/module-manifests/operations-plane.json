{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "operations-plane",
  "name": "AI Operations Plane",
  "version": "1.1.0",
  "kind": "control-plane",
  "owner": "sre",
  "criticality": "high",
  "runtimeRole": "operations-plane",
  "sourcePaths": [
    "server/operations-plane.js",
    "server/endpoints/operations.js",
    "server/utils/operations/",
    "server/utils/observability/"
  ],
  "capabilities": [
    "semantic-events",
    "timeline",
    "state-graph",
    "deployment-guard",
    "module-health-probes",
    "cross-module-correlation"
  ],
  "routes": {
    "public": ["/api/operations/"],
    "internal": ["/internal/v1/operations/"]
  },
  "rpc": {
    "provides": [
      "module.describe",
      "module.drain",
      "module.lifecycle.query",
      "module.quiesce",
      "module.resume",
      "module.self-test",
      "operations.catalog",
      "operations.guard",
      "operations.ingest-batch"
    ],
    "consumes": [
      "coordination.status",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat"
    ]
  },
  "events": {
    "publishes": [
      "operations.action.*",
      "deployment.slot.*",
      "operations.semantic.*",
      "module.lifecycle.*"
    ],
    "subscribes": ["*"]
  },
  "data": {
    "schemas": [],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/operations-plane",
    "keyDomains": ["audit"],
    "allowedCallers": [
      "agent-runtime",
      "athena-api",
      "authentication",
      "background-worker",
      "browser-plane",
      "browser-worker",
      "browser-egress",
      "chat-runtime",
      "collector",
      "coordination-plane",
      "crypto-account-access",
      "crypto-forecast",
      "crypto-market",
      "edge-web",
      "key-custody",
      "knowledge-ingest",
      "model-gateway",
      "operations-shadow-agents",
      "rag",
      "reader-worker",
      "responses-runtime",
      "scheduler",
      "sync-v2",
      "tool-runtime"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/operations-plane",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": ["infra:nats", "infra:clickhouse", "infra:otel"],
  "domain": "operations",
  "responsibilities": [
    "semantic-events",
    "timeline",
    "state-graph",
    "deployment-guard",
    "module-health-probes",
    "cross-module-correlation"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "operations.catalog",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/operations.catalog/request/1.0",
        "responseSchema": "athena://contracts/operations.catalog/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "operations.guard",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.guard/request/1.0",
        "responseSchema": "athena://contracts/operations.guard/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ],
    "consumes": [
      {
        "id": "coordination.status",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/coordination.status/request/1.0",
        "responseSchema": "athena://contracts/coordination.status/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": [],
    "objectPrefixes": [],
    "keyDomains": ["audit"],
    "configuration": ["runtime:operations-plane"],
    "runtimeState": ["module-instance:operations-plane"]
  },
  "coordination": {
    "centers": ["task", "recovery"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": [
        {
          "caller": "*",
          "capability": "operations.ingest-batch",
          "mode": "enforce"
        }
      ]
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
