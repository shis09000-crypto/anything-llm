{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "athena-api",
  "name": "Workspace Control API",
  "version": "2.6.14",
  "kind": "compatibility-service",
  "owner": "platform",
  "criticality": "critical",
  "runtimeRole": "api",
  "sourcePaths": [
    "server/index.js",
    "server/endpoints/",
    "server/models/workspace.js"
  ],
  "capabilities": [
    "http",
    "workspace",
    "account",
    "compatibility-api",
    "3d-character-memory-facade",
    "3d-character-memory-developer-inspection"
  ],
  "routes": {
    "public": [
      "/api/system/",
      "/api/workspace/",
      "/api/admin/",
      "/api/3d-center/characters/:instanceId/memory",
      "/api/3d-center/characters/:instanceId/memory/memories",
      "/api/3d-center/characters/:instanceId/memory/growth-nodes",
      "/api/3d-center/characters/:instanceId/memory/milestones"
    ],
    "internal": [
      "/live",
      "/ready",
      "/metrics",
      "/internal/v1/workspace/thread-title/claim",
      "/internal/v1/workspace/thread-title/commit"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/module-readiness/:moduleId",
        "capability": "control.dispatch"
      }
    ]
  },
  "rpc": {
    "provides": [
      "control.dispatch",
      "workspace.thread-title.claim",
      "workspace.thread-title.commit",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "agent.submit",
      "chat.submit",
      "chat.memory.status",
      "chat.memory.compact",
      "chat.memory.context.resolve",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "browser.node",
      "browser.session",
      "browser.workspace",
      "identity.assert",
      "identity.client.attach",
      "identity.request-signing.verify",
      "identity.session.validate",
      "identity.session.touch",
      "identity.audit.append",
      "identity.user-state.read",
      "identity.user-state.upsert",
      "identity.user-state.delete",
      "key-custody.wrap",
      "key-custody.unwrap",
      "key-custody.audit-descriptor",
      "key-custody.audit-sign",
      "operations.ingest-batch",
      "rag.retrieve",
      "responses.create",
      "responses.stream",
      "responses.execution-metadata.resolve",
      "responses.capabilities",
      "responses.quiz.execute",
      "scheduler.create",
      "scheduler.status",
      "sync.events.append",
      "character.v2.conversations.create",
      "character.v2.conversations.retrieve",
      "character.v2.conversations.turns.create",
      "character-performance.sessions.create",
      "character-performance.sessions.retrieve",
      "character-performance.sessions.resolve-scope",
      "character-performance.sessions.link",
      "character-performance.plans.compile",
      "character-performance.events.retrieve",
      "character-performance.feedback.create"
    ]
  },
  "events": {
    "publishes": ["workspace.*", "account.*", "module.lifecycle.*"],
    "subscribes": ["chat.run.*", "agent.run.*"]
  },
  "data": {
    "schemas": ["workspace"],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/api",
    "keyDomains": ["data"],
    "allowedCallers": [
      "edge-web",
      "chat-runtime",
      "scheduler",
      "operations-plane",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/control-api",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "browser-plane",
    "key-custody",
    "chat-runtime",
    "agent-runtime",
    "rag",
    "responses-runtime",
    "scheduler"
  ],
  "domain": "platform-control",
