{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.0",
  "id": "athena-api",
  "name": "Workspace Control API",
  "version": "1.1.0",
  "kind": "compatibility-service",
  "owner": "platform",
  "criticality": "critical",
  "runtimeRole": "api",
  "sourcePaths": [
    "server/index.js",
    "server/endpoints/",
    "server/models/workspace.js"
  ],
  "capabilities": ["http", "workspace", "account", "compatibility-api"],
  "routes": {
    "public": ["/api/system/", "/api/workspace/", "/api/admin/"],
    "internal": ["/live", "/ready", "/metrics"]
  },
  "rpc": {
    "provides": ["control.dispatch"],
    "consumes": [
      "identity.assert",
      "identity.client.attach",
      "chat.submit",
      "agent.submit",
      "key-custody.audit-descriptor",
      "key-custody.audit-sign"
    ]
  },
  "events": {
    "publishes": ["workspace.*", "account.*"],
    "subscribes": ["chat.run.*", "agent.run.*"]
  },
  "data": { "schemas": ["workspace"], "objectPrefixes": [] },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/api",
    "keyDomains": ["data"],
    "allowedCallers": ["edge-web", "scheduler", "operations-plane"],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/control-api",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "chat-runtime",
    "agent-runtime",
    "rag",
    "scheduler"
  ]
}
