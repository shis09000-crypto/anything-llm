{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "sync-v2",
  "name": "Unified Stream and Sync Gateway",
  "version": "1.0.0",
  "kind": "gateway",
  "owner": "platform",
  "criticality": "critical",
  "runtimeRole": "realtime-gateway",
  "sourcePaths": [
    "server/realtime-gateway.js",
    "server/endpoints/syncCenter.js",
    "server/utils/broadcast/",
    "server/utils/syncV2/"
  ],
  "capabilities": ["sse", "websocket", "replay", "cursor", "outbox"],
  "routes": {
    "public": ["/api/sync/", "/api/realtime/"],
    "internal": [
      "/internal/v1/streams/publish",
      "/internal/v1/sync/events/append",
      "/internal/v1/sync/security/clients/reconcile",
      "/internal/v1/sync/user-state/reconcile"
    ]
  },
  "rpc": {
    "provides": [
      "stream.subscribe",
      "stream.replay",
      "sync.events.append",
      "sync.security.clients.reconcile",
      "sync.user-state.reconcile",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "identity.realtime-ticket.consume",
      "identity.request-signing.verify",
      "identity.session.validate",
      "identity.session.touch",
      "identity.audit.append",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": ["stream.connection.*", "sync.client.*", "module.lifecycle.*"],
    "subscribes": [
      "chat.run.*",
      "agent.run.*",
      "tool.invocation.*",
      "crypto.market.*",
      "workspace.*"
    ]
  },
  "data": {
    "schemas": ["sync"],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/realtime-gateway",
    "keyDomains": [],
    "allowedCallers": [
      "edge-web",
      "athena-api",
      "chat-runtime",
      "agent-runtime",
      "authentication",
      "reader-worker",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/realtime-gateway",
    "healthPath": "/health",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": ["authentication", "infra:postgresql", "infra:nats"],
  "domain": "platform-control",
  "responsibilities": ["sse", "websocket", "replay", "cursor", "outbox"],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "stream.subscribe",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/stream.subscribe/request/1.0",
        "responseSchema": "athena://contracts/stream.subscribe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "stream.replay",
        "version": "1.0",
        "callType": "Call",
