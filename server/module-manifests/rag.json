{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.2",
  "id": "rag",
  "name": "Knowledge Retrieval",
  "version": "2.6.14",
  "kind": "service",
  "owner": "knowledge",
  "criticality": "high",
  "runtimeRole": "rag",
  "sourcePaths": [
    "server/rag.js",
    "server/utils/rag/",
    "server/utils/vectorDbProviders/",
    "server/utils/chats/"
  ],
  "capabilities": [
    "retrieval",
    "rerank",
    "citations"
  ],
  "routes": {
    "public": [],
    "internal": [
      "/internal/v1/rag/dependencies",
      "/internal/v1/rag/retrieve"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      },
      {
        "method": "GET",
        "path": "/internal/v1/rag/dependencies",
        "capability": "rag.dependencies"
      },
      {
        "method": "POST",
        "path": "/internal/v1/rag/retrieve",
        "capability": "rag.retrieve"
      }
    ]
  },
  "rpc": {
    "provides": [
      "rag.dependencies",
      "rag.retrieve",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "operations.ingest-batch",
      "key-custody.audit-descriptor"
    ]
  },
  "events": {
    "publishes": [
      "rag.result.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "knowledge.index.*"
    ]
  },
  "data": {
    "schemas": [
      "knowledge_query"
    ],
    "objectPrefixes": [
      "knowledge/index"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/rag",
    "keyDomains": [
      "file"
    ],
    "allowedCallers": [
      "chat-runtime",
      "agent-runtime",
      "athena-api",
      "operations-plane",
      "coordination-plane"
    ],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/rag",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "infra:postgresql",
    "infra:vector-database",
    "infra:embedding-provider",
    "infra:object-store",
    "key-custody"
  ],
  "domain": "knowledge",
  "responsibilities": [
    "retrieval",
    "rerank",
    "citations"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "rag.dependencies",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/rag.dependencies/request/1.0",
        "responseSchema": "athena://contracts/rag.dependencies/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "rag.retrieve",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/rag.retrieve/request/1.0",
        "responseSchema": "athena://contracts/rag.retrieve/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal",
        "targetModule": "coordination-plane",
        "requiredForReadiness": false
      },
      {
        "id": "identity.assert",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/identity.assert/request/1.0",
        "responseSchema": "athena://contracts/identity.assert/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential",
        "targetModule": "authentication",
        "requiredForReadiness": true
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal",
        "targetModule": "operations-plane",
        "requiredForReadiness": false
      },
      {
        "id": "key-custody.audit-descriptor",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/key-custody.audit-descriptor/request/1.0",
        "responseSchema": "athena://contracts/key-custody.audit-descriptor/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential",
        "targetModule": "key-custody",
        "requiredForReadiness": true
      }
    ]
  },
  "ownership": {
    "dataSchemas": [
      "knowledge_query"
    ],
    "objectPrefixes": [
      "knowledge/index"
    ],
    "keyDomains": [
      "file"
    ],
    "configuration": [
      "runtime:rag"
    ],
    "runtimeState": [
      "module-instance:rag"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery",
      "data",
      "cache"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  },
  "streams": {
    "provides": [],
    "consumes": []
  },
  "eventContracts": {
    "publishes": [
      {
        "subject": "rag.result.*",
        "payloadSchema": "athena://events/rag.result.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "rag.result.*.DLQ"
      },
      {
        "subject": "module.lifecycle.*",
        "payloadSchema": "athena://events/module.lifecycle.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "module.lifecycle.*.DLQ"
      }
    ],
    "subscribes": [
      {
        "subject": "knowledge.index.*",
        "payloadSchema": "athena://events/knowledge.index.*/payload/1.1",
        "orderingKey": "subject.id",
        "delivery": "at-least-once",
        "dlq": "knowledge.index.*.DLQ"
      }
    ]
  }
}
