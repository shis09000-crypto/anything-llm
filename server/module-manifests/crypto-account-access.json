{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "crypto-account-access",
  "name": "Crypto Account Access",
  "version": "1.1.0",
  "kind": "security-service",
  "owner": "security",
  "criticality": "high",
  "runtimeRole": "crypto-account",
  "sourcePaths": [
    "server/utils/cryptoAccount/",
    "server/utils/agents/aibitat/plugins/crypto-account/"
  ],
  "capabilities": [
    "gate-read-only",
    "account-scoped-resolution",
    "protected-equity-history",
    "approval-required-tools"
  ],
  "routes": {
    "public": [],
    "internal": ["/internal/v1/crypto/account/read"]
  },
  "rpc": {
    "provides": [
      "crypto.account",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "crypto.market",
      "identity.assert",
      "identity.client.attach",
      "identity.request-signing.verify",
      "identity.session.validate",
      "identity.session.touch",
      "identity.audit.append",
      "key-custody.unwrap",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": [
      "crypto.account.read.*",
      "crypto.connection.*",
      "crypto.account.equity_recording.*",
      "module.lifecycle.*"
    ],
    "subscribes": ["key-custody.rotation.*"]
  },
  "data": {
    "schemas": ["crypto_account"],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/crypto-account",
    "keyDomains": ["agent"],
    "allowedCallers": ["tool-runtime", "scheduler", "coordination-plane"],
    "failureMode": "isolated-degraded",
    "principalFreshnessMs": 10000
  },
  "deployment": {
    "image": "athena/crypto-account",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "key-custody",
    "crypto-market",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "security",
  "responsibilities": [
    "gate-read-only",
    "account-scoped-resolution",
    "protected-equity-history",
    "approval-required-tools"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
