{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.2",
  "id": "agent-runtime",
  "name": "Agent Orchestrator",
  "version": "2.6.14",
  "kind": "service",
  "owner": "ai-platform",
  "criticality": "critical",
  "runtimeRole": "agent-runtime",
  "sourcePaths": [
    "server/agent-runtime.js",
    "server/endpoints/agentWebsocket.js",
    "server/utils/agents/"
  ],
  "capabilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "routes": {
    "public": [
      "/api/agent-invocation/"
    ],
    "internal": [
      "/internal/v1/agent/invocations",
      "/internal/v1/agent/runs",
      "/internal/v1/agent/runs/:id/drain"
    ],
    "bindings": [
      {
        "method": "GET",
        "path": "/internal/v1/describe",
        "capability": "module.describe"
      },
      {
        "method": "GET",
        "path": "/internal/v1/self-test",
        "capability": "module.self-test"
      },
      {
        "method": "GET",
        "path": "/internal/v1/lifecycle",
        "capability": "module.lifecycle.query"
      },
      {
        "method": "POST",
        "path": "/internal/drain",
        "capability": "module.drain"
      },
      {
        "method": "POST",
        "path": "/internal/v1/quiesce",
        "capability": "module.quiesce"
      },
      {
        "method": "POST",
        "path": "/internal/v1/resume",
        "capability": "module.resume"
      },
      {
        "method": "POST",
        "path": "/internal/v1/agent/invocations",
        "capability": "agent.submit"
      },
      {
        "method": "GET",
        "path": "/internal/v1/agent/runs/:invocationId",
        "capability": "agent.status"
      }
    ]
  },
  "rpc": {
    "provides": [
      "agent.submit",
      "agent.status",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "chat.agent-turn.reserve",
      "chat.agent-turn.finalize",
      "identity.audit.append",
      "identity.client.attach",
      "identity.realtime-ticket.consume",
      "identity.request-signing.verify",
      "key-custody.wrap",
      "key-custody.unwrap",
      "sync.events.append",
      "responses.create",
      "responses.stream",
      "responses.retrieve",
      "responses.agent-run.status",
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "identity.session.validate",
      "model.stream",
      "operations.ingest-batch",
      "rag.retrieve",
      "tool.invoke",
      "model.agent.complete",
      "model.agent.stream",
      "key-custody.audit-descriptor"
    ]
  },
  "events": {
    "publishes": [
      "agent.run.*",
      "approval.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "tool.invocation.*",
      "model.stream.*"
    ]
  },
  "data": {
    "schemas": [
      "agent"
    ],
    "objectPrefixes": [
      "agent/results"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/agent-runtime",
    "keyDomains": [
      "agent"
    ],
    "allowedCallers": [
      "edge-web",
      "athena-api",
      "chat-runtime",
      "scheduler",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/agent-runtime",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "model-gateway",
    "responses-runtime",
    "tool-runtime",
    "sync-v2",
    "infra:postgresql",
    "infra:nats",
    "key-custody"
  ],
  "domain": "ai-runtime",
  "responsibilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "nonResponsibilities": [
