{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "agent-runtime",
  "name": "Agent Orchestrator",
  "version": "2.6.14",
  "kind": "service",
  "owner": "ai-platform",
  "criticality": "critical",
  "runtimeRole": "agent-runtime",
  "sourcePaths": [
    "server/agent-runtime.js",
    "server/endpoints/agentWebsocket.js",
    "server/utils/agents/"
  ],
  "capabilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "routes": {
    "public": ["/api/agent-invocation/"],
    "internal": [
      "/internal/v1/agent/invocations",
      "/internal/v1/agent/invocations/:invocationId/actions/:actionId",
      "/internal/v1/agent/invocations/:invocationId/cancel",
      "/internal/v1/agent/invocations/:invocationId/stream",
      "/internal/v1/agent/runs",
      "/internal/v1/agent/runs/:id/drain"
    ]
  },
  "rpc": {
    "provides": [
      "agent.status",
      "agent.submit",
      "agent.turn.action",
      "agent.turn.cancel",
      "agent.turn.stream",
      "module.describe",
      "module.drain",
      "module.lifecycle.query",
      "module.quiesce",
      "module.resume",
      "module.self-test"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "identity.session.validate",
      "identity.user-domain-wrap.queue",
      "key-custody.audit-descriptor",
      "chat.agent-turn.reserve",
      "chat.agent-turn.finalize",
      "model.stream",
      "operations.ingest-batch",
      "rag.retrieve",
      "responses.create",
      "responses.stream",
      "tool.invoke"
    ]
  },
  "events": {
    "publishes": ["agent.run.*", "approval.*", "module.lifecycle.*"],
    "subscribes": ["tool.invocation.*", "model.stream.*"]
  },
  "data": {
    "schemas": ["agent"],
    "objectPrefixes": ["agent/results"]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/agent-runtime",
    "keyDomains": ["agent"],
    "allowedCallers": [
      "athena-api",
      "chat-runtime",
      "coordination-plane",
      "edge-web",
      "scheduler"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/agent-runtime",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "key-custody",
    "model-gateway",
    "responses-runtime",
    "tool-runtime",
    "sync-v2",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "ai-runtime",
  "responsibilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
