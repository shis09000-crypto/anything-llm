  "ownership": {
    "dataSchemas": ["agent"],
    "objectPrefixes": ["agent/results"],
    "keyDomains": ["agent"],
    "configuration": ["runtime:agent-runtime"],
    "runtimeState": ["module-instance:agent-runtime"]
  },
  "coordination": {
    "centers": ["task", "recovery", "data", "optimistic"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 30000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
