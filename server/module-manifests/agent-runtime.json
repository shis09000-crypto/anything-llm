{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "agent-runtime",
  "name": "Agent Orchestrator",
  "version": "1.0.0",
  "kind": "service",
  "owner": "ai-platform",
  "criticality": "critical",
  "runtimeRole": "agent-runtime",
  "sourcePaths": [
    "server/endpoints/agentWebsocket.js",
    "server/utils/agents/"
  ],
  "capabilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "routes": {
    "public": [
      "/api/agent-invocation/"
    ],
    "internal": [
      "/internal/v1/agent/runs",
      "/internal/v1/agent/runs/:id/drain"
    ]
  },
  "rpc": {
    "provides": [
      "agent.submit",
      "agent.status",
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "coordination.lifecycle.event",
      "coordination.lifecycle.heartbeat",
      "identity.assert",
      "model.stream",
      "responses.create",
      "responses.stream",
      "operations.ingest-batch",
      "tool.invoke"
    ]
  },
  "events": {
    "publishes": [
      "agent.run.*",
      "approval.*",
      "module.lifecycle.*"
    ],
    "subscribes": [
      "tool.invocation.*",
      "model.stream.*"
    ]
  },
  "data": {
    "schemas": [
      "agent"
    ],
    "objectPrefixes": [
      "agent/results"
    ]
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/agent-runtime",
    "keyDomains": [
      "agent"
    ],
    "allowedCallers": [
      "edge-web",
      "athena-api",
      "scheduler",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/agent-runtime",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.999,
    "reconnectP95Ms": 3000
  },
  "dependsOn": [
    "authentication",
    "chat-runtime",
    "model-gateway",
    "responses-runtime",
    "tool-runtime",
    "sync-v2",
    "infra:postgresql",
    "infra:nats"
  ],
  "domain": "ai-runtime",
  "responsibilities": [
    "planning",
    "approval",
    "tool-routing",
    "durable-runs",
    "recovery"
  ],
  "nonResponsibilities": [
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "agent.submit",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/agent.submit/request/1.0",
        "responseSchema": "athena://contracts/agent.submit/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "agent.status",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/agent.status/request/1.0",
        "responseSchema": "athena://contracts/agent.status/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "responses.create",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/responses.create/request/1.0",
        "responseSchema": "athena://contracts/responses.create/response/1.0",
        "errorCodes": ["contract_invalid", "caller_denied", "responses_runtime_unavailable"],
        "timeoutMs": 300000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "responses.stream",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/responses.stream/request/1.0",
        "responseSchema": "athena://contracts/responses.stream/response/1.0",
        "errorCodes": ["contract_invalid", "caller_denied", "responses_runtime_unavailable"],
        "timeoutMs": 300000,
        "idempotency": "required",
        "dataClassification": "restricted"
      },
      {
        "id": "coordination.lifecycle.event",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.event/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.event/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "coordination.lifecycle.heartbeat",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/coordination.lifecycle.heartbeat/request/1.0",
        "responseSchema": "athena://contracts/coordination.lifecycle.heartbeat/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "internal"
      },
      {
        "id": "identity.assert",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/identity.assert/request/1.0",
        "responseSchema": "athena://contracts/identity.assert/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "model.stream",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/model.stream/request/1.0",
        "responseSchema": "athena://contracts/model.stream/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      },
      {
        "id": "tool.invoke",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/tool.invoke/request/1.0",
        "responseSchema": "athena://contracts/tool.invoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ]
  },
  "ownership": {
    "dataSchemas": [
      "agent"
    ],
    "objectPrefixes": [
      "agent/results"
    ],
    "keyDomains": [
      "agent"
    ],
    "configuration": [
      "runtime:agent-runtime"
    ],
    "runtimeState": [
      "module-instance:agent-runtime"
    ]
  },
  "coordination": {
    "centers": [
      "task",
      "recovery",
      "data",
      "optimistic"
    ],
    "acceptedCommands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "aicpPolicy": {
      "defaultMode": "observe",
      "links": []
    }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": [
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 30000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
