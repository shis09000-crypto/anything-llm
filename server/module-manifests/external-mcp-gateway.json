{
  "schema": "athena.module.manifest",
  "schemaVersion": "1.1",
  "id": "external-mcp-gateway",
  "name": "Athena External MCP Gateway",
  "version": "2.6.16",
  "kind": "gateway",
  "owner": "ai-platform",
  "criticality": "high",
  "runtimeRole": "external-mcp-gateway",
  "sourcePaths": [
    "server/external-mcp-gateway.js",
    "server/utils/externalMcp/"
  ],
  "capabilities": [
    "streamable-http",
    "oauth-resource-server",
    "grant-filtered-tool-catalog",
    "read-only-tool-broker"
  ],
  "routes": {
    "public": [
      "/mcp",
      "/.well-known/oauth-protected-resource/mcp",
      "/.well-known/oauth-authorization-server"
    ],
    "internal": []
  },
  "rpc": {
    "provides": [
      "module.describe",
      "module.self-test",
      "module.lifecycle.query",
      "module.drain",
      "module.quiesce",
      "module.resume"
    ],
    "consumes": [
      "identity.introspect",
      "tool.invoke",
      "operations.ingest-batch"
    ]
  },
  "events": {
    "publishes": [
      "mcp.oauth.*",
      "mcp.connection.*",
      "mcp.tool.*",
      "module.lifecycle.*"
    ],
    "subscribes": ["mcp.grant.revoked"]
  },
  "data": {
    "schemas": [],
    "objectPrefixes": []
  },
  "security": {
    "serviceIdentity": "spiffe://athena/{environment}/external-mcp-gateway",
    "keyDomains": [],
    "allowedCallers": [
      "public-client",
      "edge-web",
      "operations-plane",
      "coordination-plane"
    ],
    "failureMode": "fail-closed",
    "principalFreshnessMs": 30000
  },
  "deployment": {
    "image": "athena/external-mcp-gateway",
    "healthPath": "/live",
    "readinessPath": "/ready",
    "drainPath": "/internal/drain",
    "availabilityTarget": 0.995,
    "reconnectP95Ms": 3000
  },
  "dependsOn": ["authentication", "tool-runtime", "operations-plane"],
  "domain": "ai-runtime",
  "responsibilities": [
    "streamable-http",
    "oauth-resource-server",
    "grant-filtered-tool-catalog",
    "read-only-tool-broker"
  ],
  "nonResponsibilities": [
    "tool-implementation",
    "business-database-access",
    "foreign-schema-writes",
    "cross-module-business-policy"
  ],
  "contracts": {
    "provides": [
      {
        "id": "module.describe",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.describe/request/1.0",
        "responseSchema": "athena://contracts/module.describe/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.self-test",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.self-test/request/1.0",
        "responseSchema": "athena://contracts/module.self-test/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.lifecycle.query",
        "version": "1.0",
        "callType": "Query",
        "requestSchema": "athena://contracts/module.lifecycle.query/request/1.0",
        "responseSchema": "athena://contracts/module.lifecycle.query/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "none",
        "dataClassification": "internal"
      },
      {
        "id": "module.drain",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.drain/request/1.0",
        "responseSchema": "athena://contracts/module.drain/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.quiesce",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.quiesce/request/1.0",
        "responseSchema": "athena://contracts/module.quiesce/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "module.resume",
        "version": "1.0",
        "callType": "Command",
        "requestSchema": "athena://contracts/module.resume/request/1.0",
        "responseSchema": "athena://contracts/module.resume/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      }
    ],
    "consumes": [
      {
        "id": "identity.introspect",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/identity.introspect/request/1.0",
        "responseSchema": "athena://contracts/identity.introspect/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "confidential"
      },
      {
        "id": "tool.invoke",
        "version": "1.0",
        "callType": "Task",
        "requestSchema": "athena://contracts/tool.invoke/request/1.0",
        "responseSchema": "athena://contracts/tool.invoke/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 30000,
        "idempotency": "required",
        "dataClassification": "confidential"
      },
      {
        "id": "operations.ingest-batch",
        "version": "1.0",
        "callType": "Call",
        "requestSchema": "athena://contracts/operations.ingest-batch/request/1.0",
        "responseSchema": "athena://contracts/operations.ingest-batch/response/1.0",
        "errorCodes": [
          "contract_invalid",
          "deadline_exceeded",
          "caller_denied",
          "dependency_unavailable"
        ],
        "timeoutMs": 5000,
        "idempotency": "supported",
        "dataClassification": "internal"
      }
    ]
  },
  "ownership": {
    "dataSchemas": [],
    "objectPrefixes": [],
    "keyDomains": [],
    "configuration": ["runtime:external-mcp-gateway"],
    "runtimeState": ["module-instance:external-mcp-gateway"]
  },
  "coordination": {
    "centers": ["task", "recovery", "data"],
    "acceptedCommands": ["module.drain", "module.quiesce", "module.resume"],
    "aicpPolicy": { "defaultMode": "enforce", "links": [] }
  },
  "lifecycle": {
    "states": [
      "registered",
      "initializing",
      "ready",
      "degraded",
      "draining",
      "quiesced",
      "stopped",
      "failed"
    ],
    "hooks": [
      "initialize",
      "self-test",
      "ready",
      "checkpoint",
      "drain",
      "quiesce",
      "resume",
      "stop",
      "reconcile"
    ],
    "commands": ["module.drain", "module.quiesce", "module.resume"],
    "heartbeatIntervalMs": 30000,
    "leaseTtlMs": 90000
  },
  "reliability": {
    "rtoMs": 60000,
    "rpoMs": 0,
    "forbiddenDegradations": [
      "security-downgrade",
      "cross-account-data",
      "unsigned-control"
    ]
  }
}
