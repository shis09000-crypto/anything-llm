VITE_API_BASE='/api' # Use Vite dev proxy when developing locally with ./run-development
VITE_DEV_API_PROXY_TARGET='https://localhost:3001'
VITE_SYNC_V2_ENABLED='false' # Enable per Web cohort; server ATHENA_SYNC_V2_ENABLED remains authoritative.
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
# VITE_API_BASE='/api' # Use this URL when production frontend and backend share the same HTTPS origin.
# Production builds reject non-HTTPS Athena API URLs and non-WSS WebSocket URLs.
# Sync V2 durable local persistence must succeed before cursor ACK.
VITE_ATHENA_SYNC_DURABILITY_V2='true'
