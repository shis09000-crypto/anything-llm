#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$ROOT_DIR/.anythingllm-runtime/status.env"
DEFAULT_SERVER_PORT=3001
DEFAULT_COLLECTOR_PORT=8888
DEFAULT_FRONTEND_PORT=3000

pid_status() {
  local pid="${1:-}"
  if [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1; then
    printf 'running'
  else
    printf 'stopped'
  fi
}

listen_pids() {
  local port="${1:-}"
  if [[ -z "$port" ]]; then
    printf '-'
    return
  fi
  local pids
  pids="$(lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
  printf '%s' "${pids:--}"
}

process_status() {
  local pid="${1:-}"
  local port="${2:-}"
  local listeners

  if [[ "$(pid_status "$pid")" == "running" ]]; then
    printf 'running'
    return
  fi

  listeners="$(listen_pids "$port")"
  if [[ "$listeners" != "-" ]]; then
    printf 'stale/orphan'
    return
  fi

  printf 'stopped'
}

if [[ -f "$STATE_FILE" ]]; then
  set +e
  # shellcheck disable=SC1090
  source "$STATE_FILE" >/dev/null 2>&1
  SOURCE_STATUS=$?
  set -e
else
  SOURCE_STATUS=2
  APP_ENV="${APP_ENV:-unknown}"
  SERVER_PORT="${SERVER_PORT:-$DEFAULT_SERVER_PORT}"
  COLLECTOR_PORT="${COLLECTOR_PORT:-$DEFAULT_COLLECTOR_PORT}"
  FRONTEND_PORT="${FRONTEND_PORT:-$DEFAULT_FRONTEND_PORT}"
fi

cat <<EOF
AnythingLLM status
environment: ${APP_ENV:-unknown}
started_at:   ${STARTED_AT:-unknown}
access_url:   ${APP_URL:-unknown}
state_file:   $([[ "$SOURCE_STATUS" == "0" ]] && printf 'ok' || ([[ "$SOURCE_STATUS" == "2" ]] && printf 'missing' || printf 'partially readable'))

process       pid                 status          port      listen_pids
server        ${SERVER_PID:--}    $(process_status "${SERVER_PID:-}" "${SERVER_PORT:-}")    ${SERVER_PORT:--}    $(listen_pids "${SERVER_PORT:-}")
collector     ${COLLECTOR_PID:--}    $(process_status "${COLLECTOR_PID:-}" "${COLLECTOR_PORT:-}")    ${COLLECTOR_PORT:--}    $(listen_pids "${COLLECTOR_PORT:-}")
frontend      ${FRONTEND_PID:--}    $(process_status "${FRONTEND_PID:-}" "${FRONTEND_PORT:-}")    ${FRONTEND_PORT:--}    $(listen_pids "${FRONTEND_PORT:-}")

logs
server:    ${SERVER_LOG:-}
collector: ${COLLECTOR_LOG:-}
frontend:  ${FRONTEND_LOG:-}
EOF
