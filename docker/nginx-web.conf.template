map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${ATHENA_WEB_PORT};
  server_name _;
  # The public edge terminates TLS before forwarding to this internal HTTP
  # listener. Never construct an absolute redirect from the container scheme
  # or port (for example http://athenallm.online:3000/...).
  absolute_redirect off;
  port_in_redirect off;
  root /usr/share/nginx/html;
  index index.html;
  include /etc/nginx/conf.d/athena-proxy-ssl.conf;

  # Docker replaces a module address whenever that module is independently
  # recreated. Resolve service names per request so an unrelated module
  # rollout cannot leave Edge pinned to a dead container IP.
  resolver 127.0.0.11 valid=1s ipv6=off;
  resolver_timeout 2s;
  set $athena_api_upstream "${ATHENA_API_UPSTREAM}";
  set $athena_realtime_upstream "${ATHENA_REALTIME_UPSTREAM}";
  set $athena_chat_upstream "${ATHENA_CHAT_UPSTREAM}";
  set $athena_agent_upstream "${ATHENA_AGENT_UPSTREAM}";
  set $athena_tool_upstream "${ATHENA_TOOL_UPSTREAM}";
  set $athena_crypto_account_upstream "${ATHENA_CRYPTO_ACCOUNT_UPSTREAM}";
  set $athena_crypto_forecast_upstream "${ATHENA_CRYPTO_FORECAST_UPSTREAM}";
  set $athena_identity_upstream "${ATHENA_IDENTITY_UPSTREAM}";
  set $athena_knowledge_ingest_upstream "${ATHENA_KNOWLEDGE_INGEST_UPSTREAM}";
  set $athena_browser_stream_upstream "${ATHENA_BROWSER_STREAM_UPSTREAM}";

  proxy_intercept_errors on;
  error_page 502 503 504 = @athena_module_unavailable;

  location @athena_module_unavailable {
    internal;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    return 503 '{"success":false,"error":"service_temporarily_unavailable","reasonCode":"module_upstream_unavailable"}';
  }

  location = /health {
    access_log off;
    add_header Cache-Control "no-store";
    default_type application/json;
    return 200 '{"success":true,"status":"ready","ready":true,"source":"edge-web-nginx"}';
  }

  location /api/realtime/ {
    proxy_ssl_name anything-llm-realtime-gateway;
    proxy_pass $athena_realtime_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ~ ^/api/(request-token(?:/.*)?|auth(?:/.*)?|vault(?:/.*)?|client-identity(?:/.*)?|sensitive-sessions(?:/.*)?|realtime/ticket|admin/security/keys(?:/.*)?|system/(?:check-token|logout|sessions(?:/.*)?|user-action|refresh-user|recover-account(?:/.*)?|reset-password|update-password|transport-security/status|user(?:/(?:delete.*|email-verification.*|memory/reauth/passkey.*))?))$ {
    proxy_ssl_name anything-llm-identity;
    proxy_pass $athena_identity_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /api/document/ {
    proxy_ssl_name anything-llm-knowledge-ingest;
    proxy_pass $athena_knowledge_ingest_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ~ ^/api/workspace/[^/]+/(upload|upload-link|update-embeddings|embed-progress|embed-queue|remove-and-unembed|reset-vector-db)$ {
    proxy_ssl_name anything-llm-knowledge-ingest;
    proxy_pass $athena_knowledge_ingest_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/sync/ {
    proxy_ssl_name anything-llm-realtime-gateway;
    proxy_pass $athena_realtime_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ~ ^/api/workspace/[^/]+/(stream-chat|tool-approval|chat-runs/) {
    proxy_ssl_name anything-llm-chat-runtime;
    proxy_pass $athena_chat_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ~ ^/api/workspace/[^/]+/thread/[^/]+/(stream-chat|chat-runs/) {
    proxy_ssl_name anything-llm-chat-runtime;
    proxy_pass $athena_chat_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/agent-invocation/ {
    proxy_ssl_name anything-llm-agent-runtime;
    proxy_pass $athena_agent_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location = /browser-stream {
    proxy_ssl_name anything-llm-browser-worker;
    proxy_pass $athena_browser_stream_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/agent-skills/ {
    proxy_ssl_name anything-llm-tool-broker;
    proxy_pass $athena_tool_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /api/crypto-hub/ {
    proxy_ssl_name anything-llm-crypto-account;
    proxy_pass $athena_crypto_account_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /api/crypto-forecasting/ {
    proxy_ssl_name anything-llm-crypto-forecast;
    proxy_pass $athena_crypto_forecast_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location /api/ {
    proxy_ssl_name anything-llm-api-tls;
    proxy_pass $athena_api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # `/login` is both an application route and the name of the directory that
  # contains login artwork. Without these exact matches nginx treats the SPA
  # route as a directory, redirects it to `/login/`, and can leak the internal
  # listener port into Location. Login assets below `/login/<file>` continue to
  # be served by the normal static-file location.
  location = /login {
    try_files /index.html =404;
    add_header Cache-Control "public, max-age=0, must-revalidate";
  }

  location = /login/ {
    try_files /index.html =404;
    add_header Cache-Control "public, max-age=0, must-revalidate";
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "public, max-age=0, must-revalidate";
  }

  location ~* ^/(assets|pdfjs)/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
