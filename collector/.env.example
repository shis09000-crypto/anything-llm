# Placeholder .env file for collector runtime

# This enables HTTP request/response logging in development. Set value to truthy string to enable, leave empty value or comment out to disable
# ENABLE_HTTP_LOGGER=""
# This enables timestamps for the HTTP Logger. Set value to true to enable, leave empty or comment out to disable
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""
# P0 collector isolation and egress guard. Private destinations remain denied
# unless a hostname or CIDR is explicitly listed.
ATHENA_COLLECTOR_GUARD_V2='true'
# COLLECTOR_PRIVATE_NETWORK_ALLOWLIST='intranet.example.com,10.20.0.0/16'
# Development-only escape hatch for explicitly trusted self-signed public TLS.
# Production Chromium always keeps certificate verification enabled.
COLLECTOR_ALLOW_INSECURE_TLS='false'
COLLECTOR_MAX_CONCURRENCY='2'
COLLECTOR_MAX_QUEUE='20'
COLLECTOR_TASK_TIMEOUT_MS='300000'
