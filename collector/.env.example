# Placeholder .env file for collector runtime

# This enables HTTP request/response logging in development. Set value to truthy string to enable, leave empty value or comment out to disable
# ENABLE_HTTP_LOGGER=""
# This enables timestamps for the HTTP Logger. Set value to true to enable, leave empty or comment out to disable
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""
# P0 collector isolation and egress guard. Private destinations remain denied
# unless a hostname or CIDR is explicitly listed.
ATHENA_COLLECTOR_GUARD_V2='true'
# COLLECTOR_PRIVATE_NETWORK_ALLOWLIST='intranet.example.com,10.20.0.0/16'
# Development-only escape hatch for explicitly trusted self-signed public TLS.
# Production Chromium always keeps certificate verification enabled.
COLLECTOR_ALLOW_INSECURE_TLS='false'
COLLECTOR_MAX_CONCURRENCY='2'
# Collector accepts only signed, opaque upload handles. Development integrity
# bypass is opt-in for isolated troubleshooting and must never be used in prod.
# ATHENA_COLLECTOR_DEV_INTEGRITY_BYPASS='false'
# Signed IPC requests expire after five minutes by default. The accepted range
# is clamped to 10 seconds through 15 minutes.
# ATHENA_COLLECTOR_IPC_REPLAY_WINDOW_MS='300000'
# Legacy AES-CBC source URLs are rejected by default. Open this compatibility
# window only for an audited, time-bounded migration; all new payloads use
# HKDF-SHA256 + AES-256-GCM.
ATHENA_COLLECTOR_LEGACY_PAYLOAD_DECRYPT='false'
# COLLECTOR_BIND_HOST='127.0.0.1'
COLLECTOR_MAX_QUEUE='20'
COLLECTOR_TASK_TIMEOUT_MS='300000'
# ATHENA_SERVICE_MTLS_REQUIRED=false
# ATHENA_COLLECTOR_SERVICE_ID=spiffe://athena/production/collector
# ATHENA_API_SERVICE_ID=spiffe://athena/production/api
# COLLECTOR_MTLS_CA_FILE=/run/secrets/athena_service_ca.pem
# COLLECTOR_MTLS_CERT_FILE=/run/secrets/athena_collector_server.pem
# COLLECTOR_MTLS_KEY_FILE=/run/secrets/athena_collector_server.key
# COLLECTOR_MTLS_NEXT_CERT_FILE=/run/secrets/athena_collector_server_next.pem
# COLLECTOR_MTLS_NEXT_KEY_FILE=/run/secrets/athena_collector_server_next.key
# ATHENA_MTLS_MIN_REMAINING_MS=300000
# ATHENA_MTLS_ROTATION_SWITCH_MS=86400000
