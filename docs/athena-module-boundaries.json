{
  "version": 1,
  "description": "Athena module boundary map. These boundaries preserve the current monolith runtime while making future Web/API/Reader Worker/Background Worker/Realtime Gateway splits auditable.",
  "modules": [
    {
      "id": "frontend-web",
      "owner": "Web UI",
      "paths": ["frontend/src/"],
      "runtime": "browser",
      "futureSplit": "web"
    },
    {
      "id": "frontend-centers",
      "owner": "Client runtime centers",
      "paths": [
        "frontend/src/utils/tasks/",
        "frontend/src/utils/serverState/",
        "frontend/src/utils/recovery/",
        "frontend/src/utils/optimistic/",
        "frontend/src/utils/navigationLifecycle/",
        "frontend/src/lib/communication/"
      ],
      "runtime": "browser",
      "futureSplit": "web"
    },
    {
      "id": "reader-ui",
      "owner": "Reader UI",
      "paths": [
        "frontend/src/components/WorkspaceChat/ChatContainer/DocumentReader/",
        "frontend/src/models/readerDocument.js",
        "frontend/src/models/readerLibrary.js",
        "frontend/src/modules/reader/",
        "frontend/src/utils/chat/reader"
      ],
      "runtime": "browser",
      "futureSplit": "web"
    },
    {
      "id": "crypto-ui",
      "owner": "Crypto UI",
      "paths": [
        "frontend/src/modules/crypto/",
        "frontend/src/pages/Admin/CryptoCenter/",
        "frontend/src/pages/GeneralSettings/Settings/CryptoComponentExperiment/",
        "frontend/src/hooks/cryptoHub/",
        "frontend/src/lib/communication/crypto/",
        "frontend/src/utils/serverState/cryptoServerStateStore.js"
      ],
      "runtime": "browser",
      "futureSplit": "web"
    },
    {
      "id": "api-monolith",
      "owner": "Backend API",
      "paths": ["server/index.js", "server/endpoints/"],
      "runtime": "node",
      "futureSplit": "api"
    },
    {
      "id": "data-access",
      "owner": "Data Access Center",
      "paths": ["server/utils/dataAccess/", "server/repositories/"],
      "runtime": "node",
      "futureSplit": "api"
    },
    {
      "id": "storage-providers",
      "owner": "Storage providers",
      "paths": ["server/providers/"],
      "runtime": "node",
      "futureSplit": "api-worker-shared"
    },
    {
      "id": "reader-backend",
      "owner": "Reader API and processing",
      "paths": [
        "server/endpoints/workspaceReaderDocuments.js",
        "server/endpoints/readerLibrary.js",
        "server/modules/reader/",
        "server/services/readerLibraryService.js",
        "server/models/readerDataAuthority.js",
        "server/providers/readerDocumentStorageProvider.js"
      ],
      "runtime": "node",
      "futureSplit": "reader-worker"
    },
    {
      "id": "crypto-backend",
      "owner": "Crypto API and runtime",
      "paths": [
        "server/endpoints/cryptoCenter.js",
        "server/endpoints/cryptoHub.js",
        "server/endpoints/cryptoGateProbe.js",
        "server/modules/crypto/",
        "server/utils/cryptoCenter/",
        "server/utils/cryptoGate/",
        "server/utils/cryptoHub/",
        "server/repositories/cryptoRepository.js"
      ],
      "runtime": "node",
      "futureSplit": "background-worker"
    },
    {
      "id": "reader-worker",
      "owner": "Reader Worker boundary",
      "paths": [
        "server/reader-worker.js",
        "server/utils/readerWorker/",
        "server/utils/readerDocumentRuntime/"
      ],
      "runtime": "node",
      "futureSplit": "reader-worker"
    },
    {
      "id": "background-worker",
      "owner": "Background Worker boundary",
      "paths": ["server/background-worker.js", "server/utils/backgroundWorker/"],
      "runtime": "node",
      "futureSplit": "background-worker"
    },
    {
      "id": "realtime",
      "owner": "Realtime Broadcast Center",
      "paths": [
        "server/endpoints/syncCenter.js",
        "server/utils/broadcast/",
        "server/utils/syncCenter/"
      ],
      "runtime": "node",
      "futureSplit": "realtime-gateway"
    },
    {
      "id": "realtime-gateway",
      "owner": "Realtime Gateway runtime",
      "paths": ["server/realtime-gateway.js", "server/utils/realtimeGateway/"],
      "runtime": "node",
      "futureSplit": "realtime-gateway"
    },
    {
      "id": "developer-control",
      "owner": "Developer Control Center",
      "paths": ["server/endpoints/devControl.js", "server/utils/devControl/"],
      "runtime": "node",
      "futureSplit": "api"
    },
    {
      "id": "collector",
      "owner": "Collector",
      "paths": ["collector/"],
      "runtime": "node",
      "futureSplit": "collector"
    },
    {
      "id": "runtime-role",
      "owner": "Runtime role selection",
      "paths": ["server/utils/runtimeRole/"],
      "runtime": "node",
      "futureSplit": "api-worker-shared"
    }
  ],
  "rules": [
    {
      "id": "frontend-cannot-import-server-or-collector",
      "severity": "error",
      "from": ["frontend/"],
      "deny": ["server/", "collector/"],
      "reason": "The Web bundle must remain deployable as a standalone static artifact."
    },
    {
      "id": "collector-cannot-import-app-internals",
      "severity": "error",
      "from": ["collector/"],
      "deny": ["frontend/", "server/endpoints/", "server/utils/dataAccess/"],
      "reason": "Collector must stay independently deployable and communicate through API/file contracts."
    },
    {
      "id": "data-access-cannot-depend-on-endpoints",
      "severity": "error",
      "from": ["server/utils/dataAccess/", "server/repositories/"],
      "deny": ["server/endpoints/"],
      "reason": "DataAccessCenter and repositories are below the API layer."
    },
    {
      "id": "providers-cannot-depend-on-api-or-devcontrol",
      "severity": "error",
      "from": ["server/providers/"],
      "deny": ["server/endpoints/", "server/utils/devControl/", "server/utils/broadcast/"],
      "reason": "Storage providers must be reusable by API and future workers without reverse dependencies."
    },
    {
      "id": "realtime-cannot-import-heavy-business-endpoints",
      "severity": "warn",
      "from": [
        "server/realtime-gateway.js",
        "server/endpoints/syncCenter.js",
        "server/utils/broadcast/",
        "server/utils/syncCenter/",
        "server/utils/realtimeGateway/"
      ],
      "deny": [
        "server/endpoints/workspaceReaderDocuments.js",
        "server/endpoints/chat.js",
        "server/endpoints/cryptoCenter.js"
      ],
      "reason": "Broadcast should stay a small event center; data loading belongs to API + cache refresh."
    },
    {
      "id": "crypto-runtime-cannot-import-endpoints",
      "severity": "error",
      "from": [
        "server/modules/crypto/",
        "server/utils/cryptoCenter/",
        "server/utils/cryptoGate/",
        "server/utils/cryptoHub/"
      ],
      "deny": [
        "server/endpoints/cryptoCenter.js",
        "server/endpoints/cryptoHub.js",
        "server/endpoints/cryptoGateProbe.js"
      ],
      "reason": "Crypto runtime must stay reusable by API and future workers without depending on HTTP endpoint adapters."
    }
  ]
}
