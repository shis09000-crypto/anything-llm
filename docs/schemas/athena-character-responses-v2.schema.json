{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-character-responses-v2.schema.json",
  "title": "Athena Character Responses API v2",
  "description": "Engine-neutral multi-track face, body, action, and speech performance protocol.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/streamEvent" },
    { "$ref": "#/$defs/eventStream" },
    { "$ref": "#/$defs/executionEvent" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "capabilityId": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*:[a-z][a-z0-9_-]*/[a-z][a-z0-9_.-]*$"
    },
    "manifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "characterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "instance_id", "capability_manifest"],
      "properties": {
        "character_id": { "$ref": "#/$defs/identifier" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "capability_manifest": { "$ref": "#/$defs/manifestRef" }
      }
    },
    "conversationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "previous_response_id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "previous_response_id": {
          "oneOf": [
            { "type": "string", "pattern": "^chr_resp_[A-Za-z0-9_-]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "inputItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "user_message" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "input_text" },
              "text": { "type": "string", "minLength": 1, "maxLength": 200000 }
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "character",
        "conversation",
        "input",
        "generation"
      ],
      "properties": {
        "protocol_version": { "const": "2.0" },
        "character": { "$ref": "#/$defs/characterRef" },
        "conversation": { "$ref": "#/$defs/conversationRef" },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/inputItem" }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "channels",
            "latency_class",
            "performance_profile"
          ],
          "properties": {
            "mode": { "enum": ["main_agent", "realtime_reaction"] },
            "channels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "performance",
                  "face",
                  "gaze",
                  "body",
                  "action",
                  "speech"
                ]
              }
            },
            "latency_class": {
              "enum": ["realtime", "interactive", "deliberate"]
            },
            "performance_profile": {
              "const": "athena.cold_tsundere.expressive.v2"
            }
          }
        },
        "metadata": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "intensity", "valence", "arousal"],
      "properties": {
        "primary": { "$ref": "#/$defs/capabilityId" },
        "secondary": {
          "oneOf": [{ "$ref": "#/$defs/capabilityId" }, { "type": "null" }]
        },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "arousal": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "duration_ms"],
      "properties": {
        "style": {
          "enum": [
            "cut",
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "blend"
          ]
        },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "performanceIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "required",
        "affect",
        "source",
        "channel_modulation",
        "transition",
        "persistence",
        "revision",
        "interruptibility"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^perf_[A-Za-z0-9_-]+$" },
        "type": { "const": "performance_intent" },
        "status": {
          "enum": ["in_progress", "completed", "failed", "cancelled"]
        },
        "required": { "const": true },
        "affect": { "$ref": "#/$defs/affect" },
        "source": {
          "enum": [
            "runtime_default",
            "local_reaction",
            "main_agent",
            "high_priority_event"
          ]
        },
        "channel_modulation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "face": { "$ref": "#/$defs/affect" },
            "voice": { "$ref": "#/$defs/affect" },
            "body": { "$ref": "#/$defs/affect" },
            "gaze": { "$ref": "#/$defs/affect" }
          }
        },
        "transition": { "$ref": "#/$defs/transition" },
        "persistence": {
          "enum": ["transient", "until_replaced", "response_lifetime"]
        },
        "revision": { "type": "integer", "minimum": 0 },
        "interruptibility": {
          "enum": ["immediate", "blend_out", "at_boundary", "finish"]
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "planned_start_ms", "planned_duration_ms"],
      "properties": {
        "id": { "enum": ["reaction", "orientation", "delivery", "recovery"] },
        "planned_start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "planned_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      }
    },
    "faceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "side", "state", "intensity"],
      "properties": {
        "region": {
          "enum": [
            "brow",
            "eyelid",
            "eye_shape",
            "pupil",
            "cheek",
            "nose",
            "lip",
            "jaw"
          ]
        },
        "side": { "enum": ["left", "right", "both", "center"] },
        "state": { "$ref": "#/$defs/capabilityId" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "semantic" },
        "value": { "enum": ["player", "away", "none", "current_focus"] }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotion",
        "emotion_source",
        "intensity",
        "rate",
        "volume",
        "style",
        "pause_before_ms",
        "pause_after_ms"
      ],
      "properties": {
        "emotion": { "$ref": "#/$defs/capabilityId" },
        "emotion_source": { "const": "performance_intent" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "style": { "$ref": "#/$defs/capabilityId" },
        "pause_before_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 30000 }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cue_id",
        "phase_id",
        "planned_start_ms",
        "planned_duration_ms",
        "easing",
        "intensity",
        "amplitude",
        "required"
      ],
      "properties": {
        "cue_id": { "type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$" },
        "phase_id": {
          "enum": ["reaction", "orientation", "delivery", "recovery"]
        },
        "planned_start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "planned_duration_ms": {
          "type": "integer",
          "minimum": 40,
          "maximum": 360000
        },
        "easing": {
          "enum": [
            "cut",
            "linear",
            "ease_in",
            "ease_out",
            "ease_in_out",
            "blend"
          ]
        },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "amplitude": { "enum": ["micro", "small", "medium", "large"] },
        "required": { "type": "boolean" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/faceState" }
        },
        "gaze": { "$ref": "#/$defs/capabilityId" },
        "motion": { "$ref": "#/$defs/capabilityId" },
        "action": { "$ref": "#/$defs/capabilityId" },
        "target": { "$ref": "#/$defs/target" },
        "direction": { "type": "string", "maxLength": 80 },
        "arguments": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": true
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "language": { "const": "zh-CN" },
        "delivery": { "$ref": "#/$defs/delivery" }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled", "cues"],
      "properties": {
        "name": {
          "enum": [
            "face",
            "gaze",
            "head_neck",
            "shoulders",
            "torso",
            "left_arm",
            "right_arm",
            "left_hand",
            "right_hand",
            "left_leg",
            "right_leg",
            "action",
            "speech"
          ]
        },
        "enabled": { "type": "boolean" },
        "baseline": {
          "type": "array",
          "minItems": 8,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/faceState" }
        },
        "cues": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/cue" }
        }
      }
    },
    "performanceSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "intent_id",
        "required",
        "planned_duration_ms",
        "phases",
        "tracks"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^sequence_[A-Za-z0-9_-]+$" },
        "type": { "const": "performance_sequence" },
        "status": {
          "enum": ["in_progress", "completed", "failed", "cancelled"]
        },
        "intent_id": { "type": "string", "pattern": "^perf_[A-Za-z0-9_-]+$" },
        "required": { "const": true },
        "planned_duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "phases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/phase" },
                { "properties": { "id": { "const": "reaction" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/phase" },
                { "properties": { "id": { "const": "orientation" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/phase" },
                { "properties": { "id": { "const": "delivery" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/phase" },
                { "properties": { "id": { "const": "recovery" } } }
              ]
            }
          ],
          "items": false
        },
        "tracks": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                {
                  "properties": { "name": { "const": "face" } },
                  "required": ["baseline"]
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "gaze" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "head_neck" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "shoulders" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "torso" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "left_arm" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "right_arm" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "left_hand" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "right_hand" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "left_leg" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "right_leg" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "action" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/track" },
                { "properties": { "name": { "const": "speech" } } }
              ]
            }
          ],
          "items": false
        },
        "deliberate_stillness": { "type": "boolean" },
        "interruptibility": {
          "enum": ["immediate", "blend_out", "at_boundary", "finish"]
        },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "timelineCueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cue_id", "cue_ref"],
      "properties": {
        "cue_id": { "type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$" },
        "cue_ref": {
          "oneOf": [
            { "type": "string", "pattern": "^/output/1/tracks/[0-9]+/cues/[0-9]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "timelineModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "entering", "active", "exiting"],
      "properties": {
        "state": { "enum": ["idle", "active"] },
        "entering": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/timelineCueRef" }
        },
        "active": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/timelineCueRef" }
        },
        "exiting": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/timelineCueRef" }
        }
      }
    },
    "timelineModules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face",
        "gaze",
        "head_neck",
        "shoulders",
        "torso",
        "left_arm",
        "right_arm",
        "left_hand",
        "right_hand",
        "left_leg",
        "right_leg",
        "action",
        "speech"
      ],
      "properties": {
        "face": { "$ref": "#/$defs/timelineModule" },
        "gaze": { "$ref": "#/$defs/timelineModule" },
        "head_neck": { "$ref": "#/$defs/timelineModule" },
        "shoulders": { "$ref": "#/$defs/timelineModule" },
        "torso": { "$ref": "#/$defs/timelineModule" },
        "left_arm": { "$ref": "#/$defs/timelineModule" },
        "right_arm": { "$ref": "#/$defs/timelineModule" },
        "left_hand": { "$ref": "#/$defs/timelineModule" },
        "right_hand": { "$ref": "#/$defs/timelineModule" },
        "left_leg": { "$ref": "#/$defs/timelineModule" },
        "right_leg": { "$ref": "#/$defs/timelineModule" },
        "action": { "$ref": "#/$defs/timelineModule" },
        "speech": { "$ref": "#/$defs/timelineModule" }
      }
    },
    "timelineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "index",
        "start_ms",
        "end_ms",
        "duration_ms",
        "phase_ids",
        "modules"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^(planned|resolved)_block_[0-9]{4}$"
        },
        "index": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "end_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "phase_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["reaction", "orientation", "delivery", "recovery"] }
        },
        "modules": { "$ref": "#/$defs/timelineModules" }
      }
    },
    "compiledTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "time_blocks"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
        "time_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/timelineBlock" }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "clock",
        "module_order",
        "conflict_policy",
        "planned",
        "resolved"
      ],
      "properties": {
        "schema": { "const": "athena.character.presentation" },
        "version": { "const": "1.0" },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "origin", "planned_authority", "resolved_authority"],
          "properties": {
            "unit": { "const": "ms" },
            "origin": { "const": "response_start" },
            "planned_authority": { "const": "model" },
            "resolved_authority": { "const": "performance_runtime" }
          }
        },
        "module_order": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            { "const": "face" },
            { "const": "gaze" },
            { "const": "head_neck" },
            { "const": "shoulders" },
            { "const": "torso" },
            { "const": "left_arm" },
            { "const": "right_arm" },
            { "const": "left_hand" },
            { "const": "right_hand" },
            { "const": "left_leg" },
            { "const": "right_leg" },
            { "const": "action" },
            { "const": "speech" }
          ],
          "items": false
        },
        "conflict_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exclusive_resource", "planned_evidence", "suppression_evidence"],
          "properties": {
            "exclusive_resource": { "const": "first_wins" },
            "planned_evidence": { "const": "preserved" },
            "suppression_evidence": { "const": "warnings_and_resolved_event" }
          }
        },
        "planned": { "$ref": "#/$defs/compiledTimeline" },
        "resolved": {
          "oneOf": [
            { "$ref": "#/$defs/compiledTimeline" },
            { "type": "null" }
          ]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "item_id": { "type": "string" },
        "capability": { "$ref": "#/$defs/capabilityId" },
        "cue_id": { "type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$" },
        "kept_cue_id": { "type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$" },
        "track": {
          "enum": [
            "face",
            "gaze",
            "head_neck",
            "shoulders",
            "torso",
            "left_arm",
            "right_arm",
            "left_hand",
            "right_hand",
            "left_leg",
            "right_leg",
            "action",
            "speech"
          ]
        },
        "policy": { "enum": ["first_wins"] }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "latency_ms"
      ],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object",
        "protocol_version",
        "status",
        "created_at",
        "completed_at",
        "character",
        "conversation",
        "capability_manifest",
        "output",
        "warnings",
        "usage",
        "safety_assessment",
        "error"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^chr_resp_[A-Za-z0-9_-]+$" },
        "object": { "const": "character.response" },
        "protocol_version": { "const": "2.0" },
        "status": {
          "enum": [
            "queued",
            "in_progress",
            "completed",
            "incomplete",
            "failed",
            "cancelled"
          ]
        },
        "created_at": { "type": "integer", "minimum": 0 },
        "completed_at": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "character": { "$ref": "#/$defs/characterRef" },
        "conversation": { "$ref": "#/$defs/conversationRef" },
        "capability_manifest": { "$ref": "#/$defs/manifestRef" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "output": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/performanceIntent" },
            { "$ref": "#/$defs/performanceSequence" }
          ],
          "items": false
        },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/warning" }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "safety_assessment": {
          "enum": ["normal", "possible_immediate_danger"]
        },
        "error": {
          "oneOf": [
            { "type": "object", "additionalProperties": true },
            { "type": "null" }
          ]
        }
      }
    },
    "streamEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "event_id",
        "sequence_number",
        "created_at",
        "response_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "character.response.created",
            "character.response.in_progress",
            "character.response.output_item.added",
            "character.response.output_item.done",
            "character.performance.sequence.phase.added",
            "character.performance.sequence.phase.done",
            "character.performance.sequence.track.added",
            "character.performance.sequence.cue.added",
            "character.performance.sequence.cue.updated",
            "character.performance.sequence.cue.done",
            "character.performance.sequence.speech_text.append",
            "character.performance.sequence.resolved",
            "character.response.completed",
            "character.response.incomplete",
            "character.response.failed",
            "character.response.cancelled",
            "character.stream.ping"
          ]
        },
        "event_id": { "type": "string", "pattern": "^chr_evt_[A-Za-z0-9_-]+$" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "integer", "minimum": 0 },
        "response_id": {
          "type": "string",
          "pattern": "^chr_resp_[A-Za-z0-9_-]+$"
        }
      }
    },
    "eventStream": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/streamEvent" }
    },
    "executionEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "event_id",
        "sequence_number",
        "created_at",
        "response_id",
        "item_id",
        "cue_id",
        "track"
      ],
      "properties": {
        "type": {
          "enum": [
            "character.execution.started",
            "character.execution.completed",
            "character.execution.failed",
            "character.execution.cancelled"
          ]
        },
        "event_id": { "type": "string", "pattern": "^chr_evt_[A-Za-z0-9_-]+$" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "integer", "minimum": 0 },
        "response_id": {
          "type": "string",
          "pattern": "^chr_resp_[A-Za-z0-9_-]+$"
        },
        "item_id": { "type": "string", "pattern": "^sequence_[A-Za-z0-9_-]+$" },
        "cue_id": { "type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$" },
        "track": {
          "enum": [
            "face",
            "gaze",
            "head_neck",
            "shoulders",
            "torso",
            "left_arm",
            "right_arm",
            "left_hand",
            "right_hand",
            "left_leg",
            "right_leg",
            "action",
            "speech"
          ]
        },
        "resolved_start_ms": { "type": "integer", "minimum": 0 },
        "resolved_duration_ms": { "type": "integer", "minimum": 0 },
        "actual_start_ms": { "type": "integer", "minimum": 0 },
        "actual_duration_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
