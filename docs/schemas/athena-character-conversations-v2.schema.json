{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-character-conversations-v2.schema.json",
  "title": "Athena Character Conversation API v2",
  "description": "Persistent Character Conversation, Turn, handoff, horizon, state and soft-close contract.",
  "oneOf": [
    { "$ref": "#/$defs/createRequest" },
    { "$ref": "#/$defs/conversation" },
    { "$ref": "#/$defs/turnRequest" },
    { "$ref": "#/$defs/turnResult" },
    { "$ref": "#/$defs/eventStream" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "athenaScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": { "type": ["integer", "null"] },
        "threadId": { "type": ["integer", "null"] },
        "userId": { "type": ["integer", "null"] },
        "agentRunId": { "type": ["string", "null"] }
      }
    },
    "characterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "instance_id", "capability_manifest"],
      "properties": {
        "character_id": { "$ref": "#/$defs/identifier" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "capability_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sha256"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "version": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "channels", "latency_class", "performance_profile"],
      "properties": {
        "mode": { "enum": ["main_agent", "realtime_reaction"] },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "latency_class": { "enum": ["realtime", "interactive", "deliberate"] },
        "performance_profile": { "const": "athena.cold_tsundere.expressive.v2" }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "character", "generation", "athena"],
      "properties": {
        "protocol_version": { "const": "2.0" },
        "character": { "$ref": "#/$defs/characterRef" },
        "generation": { "$ref": "#/$defs/generation" },
        "previous_activity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "metadata": { "type": "object" },
        "athena": { "$ref": "#/$defs/athenaScope" }
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "intensity", "valence", "arousal"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": ["string", "null"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "arousal": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "characterState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "affect",
        "attention",
        "gaze",
        "posture",
        "activity",
        "performance_state",
        "decay",
        "source_turn_id",
        "updated_at"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "affect": { "$ref": "#/$defs/affect" },
        "attention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "intensity"],
          "properties": {
            "target": { "type": "string" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "gaze": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "style"],
          "properties": {
            "target": { "type": "string" },
            "style": { "type": "string" }
          }
        },
        "posture": { "type": "string" },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "previous"],
          "properties": {
            "current": { "type": "string" },
            "previous": { "type": ["string", "null"] }
          }
        },
        "performance_state": { "type": "string" },
        "decay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "target", "duration_ms"],
          "properties": {
            "mode": { "enum": ["hold", "gradual", "to_ambient"] },
            "target": { "type": "string" },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            }
          }
        },
        "source_turn_id": { "type": ["string", "null"] },
        "updated_at": { "type": "integer", "minimum": 0 }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object",
        "protocol_version",
        "status",
        "character_id",
        "character_instance_id",
        "current_turn_id",
        "last_response_id",
        "state_revision",
        "previous_activity",
        "soft_close_due_at",
        "suspended_at",
        "ended_at",
        "created_at",
        "updated_at",
        "character_state"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ath_conv_" },
        "object": { "const": "character.conversation" },
        "protocol_version": { "const": "2.0" },
        "status": {
          "enum": [
            "created",
            "active",
            "awaiting_user",
            "close_ready",
            "soft_closing",
            "soft_closed",
            "suspended",
            "resuming",
            "closing",
            "ended",
            "cancelled",
            "failed"
          ]
        },
        "character_id": { "$ref": "#/$defs/identifier" },
        "character_instance_id": { "$ref": "#/$defs/identifier" },
        "current_turn_id": { "type": ["string", "null"] },
        "last_response_id": { "type": ["string", "null"] },
        "state_revision": { "type": "integer", "minimum": 0 },
        "previous_activity": { "type": "string" },
        "soft_close_due_at": { "type": ["integer", "null"] },
        "suspended_at": { "type": ["integer", "null"] },
        "ended_at": { "type": ["integer", "null"] },
        "created_at": { "type": ["integer", "null"] },
        "updated_at": { "type": ["integer", "null"] },
        "character_state": { "$ref": "#/$defs/characterState" }
      }
    },
    "inputItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "user_message" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "input_text" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "turnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object", "input", "idempotency_key", "athena"],
      "properties": {
        "object": { "const": "character.turn.request" },
        "input": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputItem" }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "athena": { "$ref": "#/$defs/athenaScope" }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depth",
        "continuation_probability",
        "closure_readiness",
        "basis"
      ],
      "properties": {
        "depth": { "enum": ["brief", "normal", "extended"] },
        "continuation_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "closure_readiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "soft_close_wait_ms": {},
        "basis": { "type": "string" }
      }
    },
    "handoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["target", "mode"],
      "properties": {
        "target": { "const": "user" },
        "mode": { "enum": ["question", "open", "passive", "close_ready"] }
      }
    },
    "softCloseTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_wait_ms", "effective_wait_ms", "source", "depth"],
      "properties": {
        "model_wait_ms": {},
        "effective_wait_ms": {
          "type": "integer",
          "minimum": 3000,
          "maximum": 120000
        },
        "source": { "enum": ["model", "depth_default"] },
        "depth": { "enum": ["brief", "normal", "extended"] }
      }
    },
    "turnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "conversation",
        "turn",
        "response",
        "conversation_horizon",
        "model_handoff",
        "effective_handoff",
        "soft_close_timing",
        "character_state",
        "warnings"
      ],
      "properties": {
        "object": { "const": "character.turn.result" },
        "conversation": { "$ref": "#/$defs/conversation" },
        "turn": { "type": "object" },
        "response": { "type": "object" },
        "conversation_horizon": { "$ref": "#/$defs/horizon" },
        "model_handoff": { "$ref": "#/$defs/handoff" },
        "effective_handoff": { "$ref": "#/$defs/handoff" },
        "soft_close_timing": { "$ref": "#/$defs/softCloseTiming" },
        "character_state": { "$ref": "#/$defs/characterState" },
        "persistent_state_window": {
          "$ref": "athena-3d-session-memory-v1.schema.json#/$defs/stateWindow"
        },
        "memory_status": {
          "enum": ["preparing", "pending", "committed", "not_required"]
        },
        "memory_commit": { "type": ["object", "null"] },
        "warnings": { "type": "array", "items": { "type": "object" } }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "event_id",
        "sequence_number",
        "created_at",
        "conversation_id"
      ],
      "properties": {
        "type": { "type": "string", "pattern": "^character\\." },
        "event_id": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "integer", "minimum": 0 },
        "conversation_id": { "type": "string", "pattern": "^ath_conv_" },
        "turn_id": { "type": "string" },
        "response_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "eventStream": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  }
}
