{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-character-responses-v1.schema.json",
  "title": "Athena Character Responses API v1",
  "description": "Provider-neutral semantic character request, response, stream event, and execution feedback contract.",
  "oneOf": [
    { "$ref": "#/$defs/characterRequest" },
    { "$ref": "#/$defs/characterResponse" },
    { "$ref": "#/$defs/streamEvent" },
    { "$ref": "#/$defs/eventStream" },
    { "$ref": "#/$defs/executionEvent" }
  ],
  "$defs": {
    "protocolVersion": {
      "const": "1.0"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "responseId": {
      "type": "string",
      "pattern": "^chr_resp_[A-Za-z0-9_-]+$",
      "maxLength": 160
    },
    "itemId": {
      "type": "string",
      "pattern": "^(?:chr_item|perf|exp|gaze|gesture|posture|action|speech|ext)_[A-Za-z0-9_-]+$",
      "maxLength": 160
    },
    "eventId": {
      "type": "string",
      "pattern": "^chr_evt_[A-Za-z0-9_-]+$",
      "maxLength": 160
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*:[a-z][a-z0-9_-]*/[a-z][a-z0-9_.-]*$",
      "maxLength": 240
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "characterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "instance_id", "capability_manifest"],
      "properties": {
        "character_id": { "$ref": "#/$defs/identifier" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "capability_manifest": { "$ref": "#/$defs/manifestRef" }
      }
    },
    "conversationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "previous_response_id": {
          "oneOf": [
            { "$ref": "#/$defs/responseId" },
            { "type": "null" }
          ]
        }
      }
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entity_id"],
      "properties": {
        "type": { "const": "entity" },
        "entity_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["actor", "character", "object", "location", "world"]
        }
      }
    },
    "semanticTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "semantic" },
        "value": { "enum": ["player", "away", "none", "current_focus"] }
      }
    },
    "targetRef": {
      "oneOf": [
        { "$ref": "#/$defs/entityRef" },
        { "$ref": "#/$defs/semanticTarget" }
      ]
    },
    "inputText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "input_text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200000 }
      }
    },
    "inputAudioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "audio_ref"],
      "properties": {
        "type": { "const": "input_audio_ref" },
        "audio_ref": { "$ref": "#/$defs/identifier" },
        "mime_type": {
          "type": "string",
          "pattern": "^audio/[A-Za-z0-9.+-]+$"
        },
        "transcript": { "type": "string", "maxLength": 200000 }
      }
    },
    "userMessageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "user_message" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/inputText" },
              { "$ref": "#/$defs/inputAudioRef" }
            ]
          }
        }
      }
    },
    "worldEventInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "occurred_at"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "world_event" },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 160
        },
        "occurred_at": { "type": "integer", "minimum": 0 },
        "actor": { "$ref": "#/$defs/entityRef" },
        "target": { "$ref": "#/$defs/targetRef" },
        "data": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    },
    "interactionPredictionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "actor",
        "target",
        "interaction",
        "confidence",
        "eta_ms"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "interaction_prediction" },
        "actor": { "$ref": "#/$defs/entityRef" },
        "target": { "$ref": "#/$defs/entityRef" },
        "interaction": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "body_region": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "eta_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "inputItem": {
      "oneOf": [
        { "$ref": "#/$defs/userMessageInput" },
        { "$ref": "#/$defs/worldEventInput" },
        { "$ref": "#/$defs/interactionPredictionInput" }
      ]
    },
    "requestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "character_state_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "revision": { "type": "integer", "minimum": 0 }
          }
        },
        "world_snapshot_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "revision": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "generationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "channels", "latency_class"],
      "properties": {
        "mode": { "enum": ["main_agent", "realtime_reaction"] },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "performance",
              "expression",
              "gaze",
              "gesture",
              "posture",
              "action",
              "speech"
            ]
          }
        },
        "latency_class": {
          "enum": ["realtime", "interactive", "deliberate"]
        },
        "tool_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$",
          "maxLength": 120
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      }
    },
    "characterRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "character",
        "input",
        "generation"
      ],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "character": { "$ref": "#/$defs/characterRef" },
        "conversation": { "$ref": "#/$defs/conversationRef" },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/inputItem" }
        },
        "context": { "$ref": "#/$defs/requestContext" },
        "generation": { "$ref": "#/$defs/generationConfig" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "itemTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "after_item_id", "offset_ms", "duration_hint_ms"],
      "properties": {
        "start": {
          "enum": ["immediate", "after_item", "with_item", "at_offset"]
        },
        "after_item_id": {
          "oneOf": [
            { "$ref": "#/$defs/itemId" },
            { "type": "null" }
          ]
        },
        "offset_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
        "duration_hint_ms": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 3600000 },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "start": { "const": "after_item" } } },
          "then": { "properties": { "after_item_id": { "$ref": "#/$defs/itemId" } } }
        }
      ]
    },
    "itemCommon": {
      "type": "object",
      "required": [
        "id",
        "type",
        "status",
        "required",
        "timing",
        "interruptibility"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "type": {
          "enum": [
            "performance_intent",
            "expression",
            "gaze",
            "gesture",
            "posture",
            "action",
            "speech",
            "extension"
          ]
        },
        "status": {
          "enum": ["in_progress", "completed", "failed", "cancelled"]
        },
        "intent_id": { "$ref": "#/$defs/itemId" },
        "required": { "type": "boolean" },
        "timing": { "$ref": "#/$defs/itemTiming" },
        "interruptibility": {
          "enum": ["immediate", "blend_out", "at_boundary", "finish"]
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_capability", "resolved_capability", "fallback_depth"],
          "properties": {
            "requested_capability": { "$ref": "#/$defs/capabilityId" },
            "resolved_capability": { "$ref": "#/$defs/capabilityId" },
            "fallback_depth": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "duration_ms"],
      "properties": {
        "style": { "enum": ["cut", "blend", "ease_in", "ease_out"] },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "affect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "intensity", "valence", "arousal"],
      "properties": {
        "primary": { "$ref": "#/$defs/capabilityId" },
        "secondary": {
          "oneOf": [
            { "$ref": "#/$defs/capabilityId" },
            { "type": "null" }
          ]
        },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "arousal": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "channelModulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "face": { "$ref": "#/$defs/affect" },
        "voice": { "$ref": "#/$defs/affect" },
        "body": { "$ref": "#/$defs/affect" },
        "gaze": { "$ref": "#/$defs/affect" }
      }
    },
    "performanceIntentItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": [
            "affect",
            "source",
            "transition",
            "persistence",
            "revision"
          ],
          "properties": {
            "type": { "const": "performance_intent" },
            "affect": { "$ref": "#/$defs/affect" },
            "source": {
              "enum": [
                "runtime_default",
                "local_reaction",
                "main_agent",
                "high_priority_event"
              ]
            },
            "channel_modulation": { "$ref": "#/$defs/channelModulation" },
            "transition": { "$ref": "#/$defs/transition" },
            "persistence": {
              "enum": ["transient", "until_replaced", "response_lifetime"]
            },
            "revision": { "type": "integer", "minimum": 0 }
          },
          "not": { "required": ["intent_id"] }
        }
      ],
      "unevaluatedProperties": false
    },
    "expressionItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "expression", "intensity"],
          "properties": {
            "type": { "const": "expression" },
            "expression": { "$ref": "#/$defs/capabilityId" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gazeItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "target", "style", "intensity", "tracking"],
          "properties": {
            "type": { "const": "gaze" },
            "target": { "$ref": "#/$defs/targetRef" },
            "style": { "$ref": "#/$defs/capabilityId" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
            "tracking": { "type": "boolean" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gestureItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "gesture", "intensity", "handedness"],
          "properties": {
            "type": { "const": "gesture" },
            "gesture": { "$ref": "#/$defs/capabilityId" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
            "handedness": { "enum": ["auto", "left", "right", "both"] },
            "target": { "$ref": "#/$defs/targetRef" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "postureItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "posture", "transition"],
          "properties": {
            "type": { "const": "posture" },
            "posture": { "$ref": "#/$defs/capabilityId" },
            "transition": { "$ref": "#/$defs/transition" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "actionItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "action", "arguments"],
          "properties": {
            "type": { "const": "action" },
            "action": { "$ref": "#/$defs/capabilityId" },
            "target": { "$ref": "#/$defs/targetRef" },
            "arguments": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": true
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "speechDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotion",
        "emotion_source",
        "intensity",
        "rate",
        "volume",
        "style",
        "pause_before_ms",
        "pause_after_ms"
      ],
      "properties": {
        "emotion": { "$ref": "#/$defs/capabilityId" },
        "emotion_source": { "const": "performance_intent" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "style": { "$ref": "#/$defs/capabilityId" },
        "pause_before_ms": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 30000 }
      }
    },
    "speechItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "text", "language", "delivery"],
          "properties": {
            "type": { "const": "speech" },
            "text": { "type": "string", "maxLength": 200000 },
            "language": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "delivery": { "$ref": "#/$defs/speechDelivery" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "extensionItem": {
      "allOf": [
        { "$ref": "#/$defs/itemCommon" },
        {
          "type": "object",
          "required": ["intent_id", "namespace", "name", "version", "payload"],
          "properties": {
            "type": { "const": "extension" },
            "namespace": { "$ref": "#/$defs/namespace" },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "maxLength": 120
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
            },
            "payload": { "type": "object", "additionalProperties": true }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "outputItem": {
      "oneOf": [
        { "$ref": "#/$defs/performanceIntentItem" },
        { "$ref": "#/$defs/expressionItem" },
        { "$ref": "#/$defs/gazeItem" },
        { "$ref": "#/$defs/gestureItem" },
        { "$ref": "#/$defs/postureItem" },
        { "$ref": "#/$defs/actionItem" },
        { "$ref": "#/$defs/speechItem" },
        { "$ref": "#/$defs/extensionItem" }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "item_id": { "$ref": "#/$defs/itemId" },
        "capability": { "$ref": "#/$defs/capabilityId" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message", "param", "retryable", "details"],
      "properties": {
        "type": {
          "enum": [
            "invalid_request_error",
            "capability_error",
            "permission_error",
            "state_conflict_error",
            "provider_error",
            "runtime_error",
            "safety_error"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 120
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "param": {
          "oneOf": [
            { "type": "string", "maxLength": 240 },
            { "type": "null" }
          ]
        },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "first_semantic_item_ms": { "type": "integer", "minimum": 0 },
        "first_speech_delta_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "incompleteDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "enum": [
            "max_output",
            "provider_interrupted",
            "client_disconnected",
            "capability_rejected",
            "safety_blocked",
            "interrupted"
          ]
        }
      }
    },
    "characterResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "object",
        "protocol_version",
        "status",
        "character",
        "conversation",
        "capability_manifest",
        "output",
        "warnings",
        "usage",
        "error"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/responseId" },
        "object": { "const": "character.response" },
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "status": {
          "enum": [
            "queued",
            "in_progress",
            "completed",
            "incomplete",
            "failed",
            "cancelled"
          ]
        },
        "created_at": { "type": "integer", "minimum": 0 },
        "completed_at": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "character": { "$ref": "#/$defs/characterRef" },
        "conversation": { "$ref": "#/$defs/conversationRef" },
        "capability_manifest": { "$ref": "#/$defs/manifestRef" },
        "output": {
          "type": "array",
          "maxItems": 128,
          "prefixItems": [
            { "$ref": "#/$defs/performanceIntentItem" }
          ],
          "items": { "$ref": "#/$defs/outputItem" }
        },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/warning" }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        },
        "incomplete_details": { "$ref": "#/$defs/incompleteDetails" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["completed", "incomplete"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "output": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "incomplete" } },
            "required": ["status"]
          },
          "then": { "required": ["incomplete_details"] }
        }
      ]
    },
    "eventCommon": {
      "type": "object",
      "required": ["type", "event_id", "sequence_number", "created_at"],
      "properties": {
        "type": { "type": "string" },
        "event_id": { "$ref": "#/$defs/eventId" },
        "sequence_number": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "integer", "minimum": 0 },
        "response_id": { "$ref": "#/$defs/responseId" },
        "output_index": { "type": "integer", "minimum": 0 },
        "item_id": { "$ref": "#/$defs/itemId" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "responseStateEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": ["response_id", "response"],
          "properties": {
            "type": {
              "enum": [
                "character.response.created",
                "character.response.in_progress"
              ]
            },
            "response": { "$ref": "#/$defs/characterResponse" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemSnapshotEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": [
            "response_id",
            "output_index",
            "item_id",
            "revision",
            "item"
          ],
          "properties": {
            "type": {
              "enum": [
                "character.response.output_item.added",
                "character.response.output_item.updated",
                "character.response.output_item.done"
              ]
            },
            "item": { "$ref": "#/$defs/outputItem" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemDelta": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "speech_text_append" },
            "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "affect"],
          "properties": {
            "kind": { "const": "performance_intent_patch" },
            "affect": { "$ref": "#/$defs/affect" },
            "channel_modulation": { "$ref": "#/$defs/channelModulation" },
            "transition": { "$ref": "#/$defs/transition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delivery"],
          "properties": {
            "kind": { "const": "speech_delivery_patch" },
            "delivery": { "$ref": "#/$defs/speechDelivery" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item"],
          "properties": {
            "kind": {
              "enum": [
                "expression_patch",
                "gaze_patch",
                "gesture_patch",
                "posture_patch",
                "action_patch",
                "extension_patch"
              ]
            },
            "item": { "$ref": "#/$defs/outputItem" }
          }
        }
      ]
    },
    "itemDeltaEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": [
            "response_id",
            "output_index",
            "item_id",
            "revision",
            "delta"
          ],
          "properties": {
            "type": { "const": "character.response.output_item.delta" },
            "delta": { "$ref": "#/$defs/itemDelta" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemErrorEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": [
            "response_id",
            "output_index",
            "item_id",
            "revision",
            "error"
          ],
          "properties": {
            "type": {
              "enum": [
                "character.response.output_item.failed",
                "character.response.output_item.cancelled"
              ]
            },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "responseTerminalEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": ["response_id", "response"],
          "properties": {
            "type": {
              "enum": [
                "character.response.completed",
                "character.response.incomplete",
                "character.response.failed",
                "character.response.cancelled"
              ]
            },
            "response": { "$ref": "#/$defs/characterResponse" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "streamErrorEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "required": ["error"],
          "properties": {
            "type": { "const": "character.error" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pingEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventCommon" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "character.stream.ping" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "streamEvent": {
      "oneOf": [
        { "$ref": "#/$defs/responseStateEvent" },
        { "$ref": "#/$defs/itemSnapshotEvent" },
        { "$ref": "#/$defs/itemDeltaEvent" },
        { "$ref": "#/$defs/itemErrorEvent" },
        { "$ref": "#/$defs/responseTerminalEvent" },
        { "$ref": "#/$defs/streamErrorEvent" },
        { "$ref": "#/$defs/pingEvent" }
      ]
    },
    "eventStream": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/streamEvent" }
    },
    "executionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "type",
        "event_id",
        "response_id",
        "item_id",
        "character_instance_id",
        "occurred_at",
        "runtime"
      ],
      "properties": {
        "object": { "const": "character.execution_event" },
        "type": {
          "enum": [
            "character.execution.started",
            "character.execution.completed",
            "character.execution.failed",
            "character.execution.cancelled"
          ]
        },
        "event_id": { "$ref": "#/$defs/eventId" },
        "response_id": { "$ref": "#/$defs/responseId" },
        "item_id": { "$ref": "#/$defs/itemId" },
        "character_instance_id": { "$ref": "#/$defs/identifier" },
        "occurred_at": { "type": "integer", "minimum": 0 },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
            }
          }
        },
        "error": { "$ref": "#/$defs/error" },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
