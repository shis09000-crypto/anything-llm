{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/athena-character-capability-manifest-v2.schema.json",
  "title": "Athena Character Capability Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "namespace",
    "character_id",
    "performance_profile",
    "minimum_runtime_version",
    "face_regions",
    "track_order",
    "capabilities",
    "fallbacks",
    "fallback_policy",
    "permissions",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "athena.character.capability_manifest" },
    "schema_version": { "const": "2.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "character_id": { "type": "string", "minLength": 1 },
    "performance_profile": { "const": "athena.cold_tsundere.expressive.v2" },
    "minimum_runtime_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "face_regions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "brow" },
        { "const": "eyelid" },
        { "const": "eye_shape" },
        { "const": "pupil" },
        { "const": "cheek" },
        { "const": "nose" },
        { "const": "lip" },
        { "const": "jaw" }
      ],
      "items": false
    },
    "track_order": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        { "const": "face" },
        { "const": "gaze" },
        { "const": "head_neck" },
        { "const": "shoulders" },
        { "const": "torso" },
        { "const": "left_arm" },
        { "const": "right_arm" },
        { "const": "left_hand" },
        { "const": "right_hand" },
        { "const": "left_leg" },
        { "const": "right_leg" },
        { "const": "action" },
        { "const": "speech" }
      ],
      "items": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "version",
          "available",
          "channels",
          "resource_claims",
          "parameters",
          "safety_class",
          "interruptibility",
          "minimum_runtime_version",
          "timing",
          "allowed_sides"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*:[a-z][a-z0-9_-]*/[a-z][a-z0-9_.-]*$"
          },
          "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "available": { "type": "boolean" },
          "channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "face",
                "gaze",
                "body.upper",
                "body.lower",
                "locomotion",
                "voice",
                "world.interaction"
              ]
            }
          },
          "resource_claims": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
          },
          "parameters": { "type": "object", "additionalProperties": true },
          "fallback": { "type": "string" },
          "safety_class": {
            "enum": ["cosmetic", "locomotion", "interaction", "privileged"]
          },
          "interruptibility": {
            "enum": ["immediate", "blend_out", "at_boundary", "finish"]
          },
          "minimum_runtime_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_duration_ms",
              "maximum_duration_ms",
              "blendable"
            ],
            "properties": {
              "minimum_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 360000
              },
              "maximum_duration_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 360000
              },
              "blendable": { "type": "boolean" }
            }
          },
          "allowed_sides": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["left", "right", "both", "center"] }
          }
        }
      }
    },
    "fallbacks": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "fallback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_optional", "unknown_required", "max_depth"],
      "properties": {
        "unknown_optional": { "const": "warn" },
        "unknown_required": { "const": "reject" },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "requested", "denied_data_domains"],
      "properties": {
        "default": { "const": "deny" },
        "requested": { "type": "array" },
        "denied_data_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "signature_algorithm"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signature_algorithm": { "enum": ["none", "ed25519"] }
      }
    }
  }
}
