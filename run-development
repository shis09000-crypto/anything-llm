  log "starting development supervisor..."
  : >"$SUPERVISOR_LOG"
  local https_enabled_value="false"
  local enable_https_value=""
  local vite_dev_https_value="false"
  if https_enabled; then
    https_enabled_value="true"
    enable_https_value="true"
    vite_dev_https_value="true"
  fi
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid env \
      APP_ENV=development \
      SERVER_PORT="$SERVER_PORT" \
      COLLECTOR_PORT="$COLLECTOR_PORT" \
      FRONTEND_PORT="$FRONTEND_PORT" \
      PUBLIC_DEV_HOST="$DEV_PUBLIC_HOST" \
