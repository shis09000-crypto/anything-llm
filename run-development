#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$ROOT_DIR/.anythingllm-runtime"
LOG_DIR="$RUNTIME_DIR/logs"
STATE_FILE="$RUNTIME_DIR/status-development.env"
SERVER_PORT="${SERVER_PORT:-3002}"
COLLECTOR_PORT="${COLLECTOR_PORT:-8889}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"
STORAGE_BASE="${STORAGE_DIR:-$ROOT_DIR/server/storage}"
ENV_STORAGE_ROOT="$STORAGE_BASE/development"
OPEN_BROWSER=1
LAN_MODE=0
HTTPS_MODE="${HTTPS_MODE:-1}"
DEV_PUBLIC_HOST="${PUBLIC_DEV_HOST:-localhost}"
FRONTEND_URL=""
API_URL=""
DEV_SSL_DIR="$ROOT_DIR/.dev-ssl"
HTTPS_CA_KEY_PATH="$DEV_SSL_DIR/athena-dev-ca.key"
HTTPS_CA_CERT_PATH="$DEV_SSL_DIR/athena-dev-ca.crt"
HTTPS_KEY_PATH="$DEV_SSL_DIR/athena-dev.key"
HTTPS_CSR_PATH="$DEV_SSL_DIR/athena-dev.csr"
HTTPS_CERT_PATH="$DEV_SSL_DIR/athena-dev.crt"
HTTPS_OPENSSL_CONF="$DEV_SSL_DIR/athena-dev.openssl.cnf"
HTTPS_PUBLIC_CA_PATH="$ROOT_DIR/frontend/public/athena-mobile-dev-ca.crt"
HTTPS_BACKEND_URL="https://localhost:${SERVER_PORT}"
DEV_LOCAL_HOST=""
DEV_LAN_HOST=""

mkdir -p "$LOG_DIR"

log() {
  printf '[run-development] %s\n' "$*" >&2
}

usage() {
  cat <<EOF
Usage: bash ./run-development [--no-open] [--lan] [--http]

Options:
  --no-open   Start services without opening or refreshing a browser tab.
  --lan       Use this Mac's LAN IP for the frontend URL.
  --http      Use the legacy HTTP dev transport instead of default HTTPS.

Environment:
  PUBLIC_DEV_HOST  Override the host advertised to browser clients.
EOF
}

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

https_enabled() {
  truthy "$HTTPS_MODE"
}

detect_lan_host() {
  local candidate
  local iface

  for iface in en0 en1; do
    candidate="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    if [[ -n "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  candidate="$(ifconfig 2>/dev/null | awk '
    $1 == "inet" && $2 !~ /^127\\./ && $2 != "0.0.0.0" {
      print $2
      exit
    }
  ')"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

detect_local_host() {
  local candidate
  candidate="$(scutil --get LocalHostName 2>/dev/null || true)"
  if [[ -z "$candidate" ]]; then
    candidate="$(hostname -s 2>/dev/null || true)"
  fi
  candidate="${candidate%%.*}"
  if [[ -n "$candidate" && "$candidate" != "localhost" ]]; then
    printf '%s.local\n' "$candidate"
    return 0
  fi
  printf 'localhost\n'
}

write_https_openssl_config() {
  local local_host="$1"
  local lan_host="$2"
  local dns_index=1
  local ip_index=1

  {
    cat <<EOF
[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req

[dn]
CN = ${local_host}

[v3_req]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
EOF
    printf 'DNS.%s = localhost\n' "$dns_index"
    dns_index=$((dns_index + 1))
    if [[ -n "$local_host" && "$local_host" != "localhost" ]]; then
      printf 'DNS.%s = %s\n' "$dns_index" "$local_host"
      dns_index=$((dns_index + 1))
    fi
    if [[ -n "$DEV_PUBLIC_HOST" && "$DEV_PUBLIC_HOST" != "localhost" && ! "$DEV_PUBLIC_HOST" =~ ^[0-9.]+$ ]]; then
      printf 'DNS.%s = %s\n' "$dns_index" "$DEV_PUBLIC_HOST"
      dns_index=$((dns_index + 1))
    fi
    printf 'IP.%s = 127.0.0.1\n' "$ip_index"
    ip_index=$((ip_index + 1))
    if [[ -n "$lan_host" ]]; then
      printf 'IP.%s = %s\n' "$ip_index" "$lan_host"
    fi
  } >"$HTTPS_OPENSSL_CONF"
}

ensure_https_certs() {
  if ! command -v openssl >/dev/null 2>&1; then
    log "error: openssl is required to start the HTTPS development server."
    exit 1
  fi

  mkdir -p "$DEV_SSL_DIR" "$(dirname "$HTTPS_PUBLIC_CA_PATH")"

  DEV_LOCAL_HOST="$(detect_local_host)"
  DEV_LAN_HOST="$(detect_lan_host 2>/dev/null || true)"

  if [[ ! -f "$HTTPS_CA_KEY_PATH" || ! -f "$HTTPS_CA_CERT_PATH" ]]; then
    log "creating local Athena development CA in $DEV_SSL_DIR"
    openssl genrsa -out "$HTTPS_CA_KEY_PATH" 4096 >/dev/null 2>&1
    openssl req \
      -x509 \
      -new \
      -nodes \
      -key "$HTTPS_CA_KEY_PATH" \
      -sha256 \
      -days 3650 \
      -subj "/CN=Athena Dev CA" \
      -out "$HTTPS_CA_CERT_PATH" >/dev/null 2>&1
  fi

  write_https_openssl_config "$DEV_LOCAL_HOST" "$DEV_LAN_HOST"

  openssl genrsa -out "$HTTPS_KEY_PATH" 2048 >/dev/null 2>&1
  openssl req \
    -new \
    -key "$HTTPS_KEY_PATH" \
    -out "$HTTPS_CSR_PATH" \
    -config "$HTTPS_OPENSSL_CONF" >/dev/null 2>&1
  openssl x509 \
    -req \
    -in "$HTTPS_CSR_PATH" \
    -CA "$HTTPS_CA_CERT_PATH" \
    -CAkey "$HTTPS_CA_KEY_PATH" \
    -CAcreateserial \
    -out "$HTTPS_CERT_PATH" \
    -days 825 \
    -sha256 \
    -extensions v3_req \
    -extfile "$HTTPS_OPENSSL_CONF" >/dev/null 2>&1

  cp "$HTTPS_CA_CERT_PATH" "$HTTPS_PUBLIC_CA_PATH"
}

configure_public_urls() {
  if [[ -n "${PUBLIC_DEV_HOST:-}" ]]; then
    DEV_PUBLIC_HOST="$PUBLIC_DEV_HOST"
  elif [[ "$LAN_MODE" == "1" ]]; then
    if ! DEV_PUBLIC_HOST="$(detect_lan_host)"; then
      log "error: unable to detect a LAN IP. Set PUBLIC_DEV_HOST=<ip-or-host> and retry."
      exit 1
    fi
  else
    DEV_PUBLIC_HOST="localhost"
  fi

  if https_enabled; then
    FRONTEND_URL="https://${DEV_PUBLIC_HOST}:${FRONTEND_PORT}"
    API_URL="/api"
    HTTPS_BACKEND_URL="https://localhost:${SERVER_PORT}"
  else
    FRONTEND_URL="http://${DEV_PUBLIC_HOST}:${FRONTEND_PORT}"
    API_URL="http://${DEV_PUBLIC_HOST}:${SERVER_PORT}/api"
    HTTPS_BACKEND_URL=""
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open)
      OPEN_BROWSER=0
      ;;
    --lan)
      LAN_MODE=1
      ;;
    --http)
      HTTPS_MODE=0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

configure_public_urls
if https_enabled; then
  ensure_https_certs
fi

is_port_open() {
  nc -z localhost "$1" >/dev/null 2>&1
}

wait_for_port() {
  local name="$1"
  local port="$2"
  local attempts="${3:-90}"
  local count=0
  while (( count < attempts )); do
    if is_port_open "$port"; then
      log "$name is listening on port $port"
      return 0
    fi
    sleep 1
    count=$((count + 1))
  done
  log "warning: $name did not open port $port within ${attempts}s"
  return 1
}

start_process() {
  local pid_var="$1"
  local name="$2"
  local dir="$3"
  local logfile="$4"
  local pid_file
  local pid
  shift 4

  log "starting $name..."
  pid_file="$(mktemp "${TMPDIR:-/tmp}/anythingllm-${name}-pid.XXXXXX")"
  pushd "$dir" >/dev/null
  nohup env \
    APP_ENV=development \
    NODE_ENV=development \
    SERVER_PORT="$SERVER_PORT" \
    COLLECTOR_PORT="$COLLECTOR_PORT" \
    ANYTHINGLLM_STORAGE_BASE_DIR="$STORAGE_BASE" \
    ANYTHINGLLM_ENV_STORAGE_APPLIED=true \
    STORAGE_DIR="$ENV_STORAGE_ROOT" \
    VITE_API_BASE="$API_URL" \
    "$@" </dev/null >"$logfile" 2>&1 &
  pid=$!
  disown "$pid" >/dev/null 2>&1 || true
  popd >/dev/null
  printf '%s' "$pid" >"$pid_file"
  pid="$(cat "$pid_file")"
  rm -f "$pid_file"
  printf -v "$pid_var" '%s' "$pid"
}

ensure_process_alive() {
  local name="$1"
  local pid="$2"
  local logfile="$3"

  sleep 0.5
  if kill -0 "$pid" >/dev/null 2>&1; then
    return 0
  fi

  log "error: $name exited during startup. Last log lines:"
  tail -n 80 "$logfile" >&2 2>/dev/null || true
  return 1
}

listen_pids_for_port() {
  local port="$1"
  lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
}

assert_single_listener() {
  local name="$1"
  local port="$2"
  local pids
  local count

  pids="$(listen_pids_for_port "$port" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
  if [[ -z "$pids" ]]; then
    log "warning: $name has no listener on port $port"
    return 1
  fi

  count="$(printf '%s\n' "$pids" | wc -w | tr -d ' ')"
  if [[ "$count" != "1" ]]; then
    log "warning: $name has multiple listeners on port $port: $pids"
    return 1
  fi
  return 0
}

prepare_storage_dirs() {
  mkdir -p \
    "$ENV_STORAGE_ROOT/documents" \
    "$ENV_STORAGE_ROOT/direct-uploads" \
    "$ENV_STORAGE_ROOT/reader-documents" \
    "$ENV_STORAGE_ROOT/vector-cache" \
    "$ENV_STORAGE_ROOT/lancedb" \
    "$ENV_STORAGE_ROOT/models" \
    "$ENV_STORAGE_ROOT/tmp"
}

database_has_core_schema() {
  local db_path="$1"
  local table_count

  if [[ ! -f "$db_path" ]] || ! command -v sqlite3 >/dev/null 2>&1; then
    return 1
  fi

  table_count="$(sqlite3 "$db_path" "select count(*) from sqlite_master where type='table' and name in ('_prisma_migrations','system_settings','workspaces','workspace_documents','event_logs');" 2>/dev/null || printf '0')"
  [[ "$table_count" == "5" ]]
}

sqlite_quote() {
  printf "%s" "$1" | sed "s/'/''/g"
}

migration_id() {
  node -e 'console.log(require("crypto").randomUUID())'
}

sqlite_scalar() {
  local db_path="$1"
  local sql="$2"
  sqlite3 "$db_path" "$sql" 2>/dev/null || printf '0'
}

migration_applied() {
  local db_path="$1"
  local migration_name="$2"
  local applied

  applied="$(sqlite_scalar "$db_path" "select count(*) from \"_prisma_migrations\" where migration_name = '$(sqlite_quote "$migration_name")' and rolled_back_at is null;")"
  [[ "$applied" != "0" ]]
}

record_sqlite_migration() {
  local db_path="$1"
  local migration_name="$2"
  local migration_sql="$3"
  local id
  local checksum

  id="$(migration_id)"
  checksum="$(shasum -a 256 "$migration_sql" | awk '{print $1}')"
  sqlite3 "$db_path" "insert into \"_prisma_migrations\" (id, checksum, finished_at, migration_name, started_at, applied_steps_count) values ('$(sqlite_quote "$id")', '$(sqlite_quote "$checksum")', datetime('now'), '$(sqlite_quote "$migration_name")', datetime('now'), 1);"
}

email_verification_schema_exists() {
  local db_path="$1"
  local table_count
  local user_column_count

  table_count="$(sqlite_scalar "$db_path" "select count(*) from sqlite_master where type='table' and name='email_verification_codes';")"
  user_column_count="$(sqlite_scalar "$db_path" "select count(*) from pragma_table_info('users') where name in ('email','email_verified_at');")"
  [[ "$table_count" == "1" && "$user_column_count" == "2" ]]
}

user_state_preferences_schema_exists() {
  local db_path="$1"
  local table_count
  local column_count

  table_count="$(sqlite_scalar "$db_path" "select count(*) from sqlite_master where type='table' and name='user_state_preferences';")"
  column_count="$(sqlite_scalar "$db_path" "select count(*) from pragma_table_info('user_state_preferences') where name in ('userId','namespace','scope','value','version','createdAt','updatedAt');")"
  [[ "$table_count" == "1" && "$column_count" == "7" ]]
}

sync_v2_schema_exists() {
  local db_path="$1"
  local table_count
  local receipt_column_count
  local chat_column_count

  table_count="$(sqlite_scalar "$db_path" "select count(*) from sqlite_master where type='table' and name in ('sync_nodes','sync_outbox','sync_client_cursors');")"
  receipt_column_count="$(sqlite_scalar "$db_path" "select count(*) from pragma_table_info('athena_mutation_receipts') where name in ('baseVersion','resultVersion','requestHash','resultJson','expiresAt');")"
  chat_column_count="$(sqlite_scalar "$db_path" "select count(*) from pragma_table_info('workspace_chats') where name in ('messageVersion','deletedAt');")"
  [[ "$table_count" == "3" && "$receipt_column_count" == "5" && "$chat_column_count" == "2" ]]
}

reconcile_known_sqlite_migration() {
  local db_path="$1"
  local migration_name="$2"
  local migration_sql="$3"

  case "$migration_name" in
    20260612090000_add_email_verification)
      if email_verification_schema_exists "$db_path"; then
        log "recording already-applied migration $migration_name"
        record_sqlite_migration "$db_path" "$migration_name" "$migration_sql"
        return 0
      fi
      ;;
    20260624100000_add_user_state_preferences)
      if user_state_preferences_schema_exists "$db_path"; then
        log "recording already-applied migration $migration_name"
        record_sqlite_migration "$db_path" "$migration_name" "$migration_sql"
        return 0
      fi
      ;;
    20260717120000_add_sync_v2_state_tree)
      if sync_v2_schema_exists "$db_path"; then
        log "recording already-applied migration $migration_name"
        record_sqlite_migration "$db_path" "$migration_name" "$migration_sql"
        return 0
      fi
      ;;
  esac

  return 1
}

apply_sqlite_migrations() {
  local db_path="$1"
  local migrations_dir="$ROOT_DIR/server/prisma/migrations"
  local migration_dir
  local migration_name
  local migration_sql

  sqlite3 "$db_path" <<'SQL'
CREATE TABLE IF NOT EXISTS "_prisma_migrations" (
  "id" TEXT PRIMARY KEY NOT NULL,
  "checksum" TEXT NOT NULL,
  "finished_at" DATETIME,
  "migration_name" TEXT NOT NULL,
  "logs" TEXT,
  "rolled_back_at" DATETIME,
  "started_at" DATETIME NOT NULL DEFAULT current_timestamp,
  "applied_steps_count" INTEGER UNSIGNED NOT NULL DEFAULT 0
);
SQL

  for migration_dir in "$migrations_dir"/*; do
    [[ -d "$migration_dir" ]] || continue
    migration_name="$(basename "$migration_dir")"
    migration_sql="$migration_dir/migration.sql"
    [[ -f "$migration_sql" ]] || continue

    if migration_applied "$db_path" "$migration_name"; then
      continue
    fi

    if reconcile_known_sqlite_migration "$db_path" "$migration_name" "$migration_sql"; then
      continue
    fi

    log "applying migration $migration_name"
    sqlite3 "$db_path" <"$migration_sql"
    record_sqlite_migration "$db_path" "$migration_name" "$migration_sql"
  done
}

ensure_env_database() {
  local db_path="$ENV_STORAGE_ROOT/anythingllm.db"

  if database_has_core_schema "$db_path"; then
    apply_sqlite_migrations "$db_path"
    log "development database schema is ready"
    return 0
  fi

  log "development database schema missing or incomplete; running env-aware SQLite migrations/seed..."
  apply_sqlite_migrations "$db_path"

  (
    cd "$ROOT_DIR/server"
    APP_ENV=development STORAGE_DIR="$STORAGE_BASE" node prisma/seed.js
  )

  if ! database_has_core_schema "$db_path"; then
    log "error: development database schema is still incomplete after migration"
    exit 1
  fi
}

ensure_auth_database() {
  local db_path="$STORAGE_BASE/shared/auth.db"

  mkdir -p "$(dirname "$db_path")"
  apply_sqlite_migrations "$db_path"
  log "shared authentication database schema is ready"
}

run_key_custody_preflight() {
  log "running Athena key custody bootstrap and preflight..."
  (
    cd "$ROOT_DIR"
    NODE_ENV=development \
      APP_ENV=development \
      STORAGE_DIR="$STORAGE_BASE" \
      node server/scripts/athena-keyctl.js bootstrap --apply
  )
}

write_state() {
  {
    printf 'APP_ENV=%q\n' "development"
    printf 'SERVER_PORT=%q\n' "$SERVER_PORT"
    printf 'COLLECTOR_PORT=%q\n' "$COLLECTOR_PORT"
    printf 'FRONTEND_PORT=%q\n' "$FRONTEND_PORT"
    printf 'SERVER_PID=%q\n' "$SERVER_PID"
    printf 'COLLECTOR_PID=%q\n' "$COLLECTOR_PID"
    printf 'FRONTEND_PID=%q\n' "$FRONTEND_PID"
    printf 'SERVER_LOG=%q\n' "$SERVER_LOG"
    printf 'COLLECTOR_LOG=%q\n' "$COLLECTOR_LOG"
    printf 'FRONTEND_LOG=%q\n' "$FRONTEND_LOG"
    printf 'APP_URL=%q\n' "$FRONTEND_URL"
    printf 'STARTED_AT=%q\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  } >"$STATE_FILE"
}

refresh_browser_tab() {
  local browser="$1"
  local url="$2"
  local result
  local status
  local output_file
  local status_file
  local script_pid

  if ! command -v osascript >/dev/null 2>&1; then
    return 1
  fi

  output_file="$(mktemp "${TMPDIR:-/tmp}/anythingllm-osascript-output.XXXXXX")"
  status_file="$(mktemp "${TMPDIR:-/tmp}/anythingllm-osascript-status.XXXXXX")"

  # AppleScript can block on macOS automation permissions; keep it best-effort.
  (
    osascript - "$browser" "$url" >"$output_file" 2>/dev/null <<'OSA'
on normalizeUrl(rawUrl)
  set normalizedUrl to rawUrl as text
  repeat while normalizedUrl ends with "/"
    if (length of normalizedUrl) <= 1 then exit repeat
    set normalizedUrl to text 1 thru -2 of normalizedUrl
  end repeat
  return normalizedUrl
end normalizeUrl

on run argv
  set browserName to item 1 of argv
  set targetUrl to item 2 of argv
  set normalizedTargetUrl to my normalizeUrl(targetUrl)

  if browserName is "Google Chrome" then
    if application "Google Chrome" is not running then return "not-running"
    tell application "Google Chrome"
      repeat with windowIndex from 1 to count of windows
        set candidateWindow to window windowIndex
        repeat with tabIndex from 1 to count of tabs of candidateWindow
          set candidateTab to tab tabIndex of candidateWindow
          if my normalizeUrl(URL of candidateTab) is normalizedTargetUrl then
            set active tab index of candidateWindow to tabIndex
            set index of candidateWindow to 1
            activate
            reload candidateTab
            return "reloaded"
          end if
        end repeat
      end repeat
    end tell
  else if browserName is "Safari" then
    if application "Safari" is not running then return "not-running"
    tell application "Safari"
      repeat with windowIndex from 1 to count of windows
        set candidateWindow to window windowIndex
        repeat with tabIndex from 1 to count of tabs of candidateWindow
          set candidateTab to tab tabIndex of candidateWindow
          if my normalizeUrl(URL of candidateTab) is normalizedTargetUrl then
            set current tab of candidateWindow to candidateTab
            set index of candidateWindow to 1
            activate
            do JavaScript "window.location.reload()" in candidateTab
            return "reloaded"
          end if
        end repeat
      end repeat
    end tell
  end if

  return "not-found"
end run
OSA
    printf '%s' "$?" >"$status_file"
  ) &
  script_pid=$!

  for _ in {1..40}; do
    if [[ -s "$status_file" ]]; then break; fi
    sleep 0.1
  done

  if [[ ! -s "$status_file" ]]; then
    kill "$script_pid" >/dev/null 2>&1 || true
    wait "$script_pid" >/dev/null 2>&1 || true
    rm -f "$output_file" "$status_file"
    return 1
  fi

  wait "$script_pid" >/dev/null 2>&1 || true
  status="$(cat "$status_file" 2>/dev/null || printf '1')"
  result="$(cat "$output_file" 2>/dev/null || true)"
  rm -f "$output_file" "$status_file"

  [[ "$status" == "0" && "$result" == "reloaded" ]]
}

open_or_refresh_frontend() {
  local app_env="$1"
  local url="$2"

  printf '\nAPP_ENV=%s\nURL=%s\n' "$app_env" "$url"

  if [[ "$OPEN_BROWSER" != "1" ]]; then
    log "browser open skipped (--no-open)"
    return 0
  fi

  if [[ "$(uname -s)" != "Darwin" ]] || ! command -v open >/dev/null 2>&1; then
    log "automatic browser open is only supported on macOS with open; visit $url"
    return 0
  fi

  if refresh_browser_tab "Google Chrome" "$url"; then
    log "refreshed existing Google Chrome tab: $url"
    return 0
  fi

  if refresh_browser_tab "Safari" "$url"; then
    log "refreshed existing Safari tab: $url"
    return 0
  fi

  log "opening browser: $url"
  open "$url" >/dev/null 2>&1 || log "warning: failed to open browser for $url"
}

SUPERVISOR_LOCK_DIR="$RUNTIME_DIR/supervisor-development.lock"
SUPERVISOR_LOG="$LOG_DIR/development-supervisor.log"
SERVER_LOG="$LOG_DIR/development-server.log"
COLLECTOR_LOG="$LOG_DIR/development-collector.log"
FRONTEND_LOG="$LOG_DIR/development-frontend.log"

supervisor_pid_from_lock() {
  cat "$SUPERVISOR_LOCK_DIR/pid" 2>/dev/null || true
}

supervisor_alive() {
  local pid
  pid="$(supervisor_pid_from_lock)"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

supervisor_urls_match() {
  local state_output
  local state_frontend_url
  local state_api_url
  local state_https_enabled
  local state_https_key_path
  local state_https_cert_path
  local desired_https_enabled

  [[ -f "$STATE_FILE" ]] || return 1
  state_output="$(bash -c 'source "$1" >/dev/null 2>&1 || exit 1; printf "%s\n%s\n%s\n%s\n%s\n" "${APP_URL:-}" "${API_URL:-}" "${HTTPS_ENABLED:-false}" "${HTTPS_KEY_PATH:-}" "${HTTPS_CERT_PATH:-}"' _ "$STATE_FILE" 2>/dev/null || true)"
  state_frontend_url="$(printf '%s\n' "$state_output" | sed -n '1p')"
  state_api_url="$(printf '%s\n' "$state_output" | sed -n '2p')"
  state_https_enabled="$(printf '%s\n' "$state_output" | sed -n '3p')"
  state_https_key_path="$(printf '%s\n' "$state_output" | sed -n '4p')"
  state_https_cert_path="$(printf '%s\n' "$state_output" | sed -n '5p')"
  desired_https_enabled="false"
  if https_enabled; then desired_https_enabled="true"; fi

  [[ "$state_frontend_url" == "$FRONTEND_URL" &&
    "$state_api_url" == "$API_URL" &&
    "$state_https_enabled" == "$desired_https_enabled" &&
    "$state_https_key_path" == "$HTTPS_KEY_PATH" &&
    "$state_https_cert_path" == "$HTTPS_CERT_PATH" ]]
}

cleanup_stale_supervisor_lock() {
  if [[ -d "$SUPERVISOR_LOCK_DIR" ]] && ! supervisor_alive; then
    log "removing stale supervisor lock: $SUPERVISOR_LOCK_DIR"
    rm -rf "$SUPERVISOR_LOCK_DIR"
  fi
}

