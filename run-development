      HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      HTTPS_CA_CERT_PATH="$HTTPS_CA_CERT_PATH" \
      HTTPS_PUBLIC_CA_PATH="$HTTPS_PUBLIC_CA_PATH" \
      HTTPS_BACKEND_URL="$HTTPS_BACKEND_URL" \
      VITE_DEV_HTTPS="$vite_dev_https_value" \
      VITE_HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      VITE_HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      VITE_DEV_API_PROXY_TARGET="$HTTPS_BACKEND_URL" \
      MOBILE_HTTPS_API_BASE="/api" \
      STORAGE_DIR="$STORAGE_BASE" \
      bash "$ROOT_DIR/scripts/runtime-supervisor.sh" --env development \
      >/dev/null 2>&1 &
  elif command -v perl >/dev/null 2>&1; then
    nohup perl -MPOSIX=setsid -e 'setsid() or die "setsid failed: $!"; exec @ARGV' \
      env \
      APP_ENV=development \
      SERVER_PORT="$SERVER_PORT" \
      COLLECTOR_PORT="$COLLECTOR_PORT" \
      FRONTEND_PORT="$FRONTEND_PORT" \
      PUBLIC_DEV_HOST="$DEV_PUBLIC_HOST" \
      APP_URL="$FRONTEND_URL" \
      API_URL="$API_URL" \
      MOBILE_HTTPS="$https_enabled_value" \
      ENABLE_HTTPS="$enable_https_value" \
      HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      HTTPS_CA_CERT_PATH="$HTTPS_CA_CERT_PATH" \
      HTTPS_PUBLIC_CA_PATH="$HTTPS_PUBLIC_CA_PATH" \
      HTTPS_BACKEND_URL="$HTTPS_BACKEND_URL" \
      VITE_DEV_HTTPS="$vite_dev_https_value" \
      VITE_HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      VITE_HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      VITE_DEV_API_PROXY_TARGET="$HTTPS_BACKEND_URL" \
      MOBILE_HTTPS_API_BASE="/api" \
      STORAGE_DIR="$STORAGE_BASE" \
      bash "$ROOT_DIR/scripts/runtime-supervisor.sh" --env development \
      >/dev/null 2>&1 &
  else
    nohup env \
      APP_ENV=development \
      SERVER_PORT="$SERVER_PORT" \
      COLLECTOR_PORT="$COLLECTOR_PORT" \
      FRONTEND_PORT="$FRONTEND_PORT" \
      PUBLIC_DEV_HOST="$DEV_PUBLIC_HOST" \
      APP_URL="$FRONTEND_URL" \
      API_URL="$API_URL" \
      MOBILE_HTTPS="$https_enabled_value" \
      ENABLE_HTTPS="$enable_https_value" \
      HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      HTTPS_CA_CERT_PATH="$HTTPS_CA_CERT_PATH" \
      HTTPS_PUBLIC_CA_PATH="$HTTPS_PUBLIC_CA_PATH" \
      HTTPS_BACKEND_URL="$HTTPS_BACKEND_URL" \
      VITE_DEV_HTTPS="$vite_dev_https_value" \
      VITE_HTTPS_KEY_PATH="$HTTPS_KEY_PATH" \
      VITE_HTTPS_CERT_PATH="$HTTPS_CERT_PATH" \
      VITE_DEV_API_PROXY_TARGET="$HTTPS_BACKEND_URL" \
      MOBILE_HTTPS_API_BASE="/api" \
      STORAGE_DIR="$STORAGE_BASE" \
      bash "$ROOT_DIR/scripts/runtime-supervisor.sh" --env development \
      >/dev/null 2>&1 &
  fi
  SUPERVISOR_PID="$!"
  disown "$SUPERVISOR_PID" >/dev/null 2>&1 || true
  sleep 0.75
  if ! kill -0 "$SUPERVISOR_PID" >/dev/null 2>&1; then
    log "error: development supervisor exited during startup. Last log lines:"
    tail -n 80 "$SUPERVISOR_LOG" >&2 2>/dev/null || true
    exit 1
  fi
}

wait_for_supervisor_state() {
  local attempts=20
  local count=0
  while (( count < attempts )); do
    if [[ -f "$STATE_FILE" ]] && grep -q '^SUPERVISOR_PID=' "$STATE_FILE"; then
      return 0
    fi
    sleep 0.25
    count=$((count + 1))
  done
  log "warning: supervisor state file was not written within 5s"
  return 1
}

wait_for_running_components() {
  local attempts=90
  local count=0
  local server_status
  local collector_status
  local frontend_status

  while (( count < attempts )); do
    if [[ -f "$STATE_FILE" ]]; then
      # shellcheck disable=SC1090
      source "$STATE_FILE" >/dev/null 2>&1 || true
      server_status="${SERVER_STATUS:-}"
      collector_status="${COLLECTOR_STATUS:-}"
      frontend_status="${FRONTEND_STATUS:-}"
      if [[ "$server_status" == "running" &&
        "$collector_status" == "running" &&
        "$frontend_status" == "running" ]]; then
        return 0
      fi
    fi
    sleep 1
    count=$((count + 1))
  done

  log "warning: development components did not all report running within ${attempts}s"
  return 1
}

warn_degraded_components() {
  local component
  local label
  local status
  local reason

  [[ -f "$STATE_FILE" ]] || return 0
  for component in SERVER COLLECTOR FRONTEND; do
    label="$(printf '%s' "$component" | tr '[:upper:]' '[:lower:]')"
    status="$(sed -n "s/^${component}_STATUS=//p" "$STATE_FILE" | tail -1 | tr -d "'\"")"
    reason="$(sed -n "s/^${component}_LAST_RESTART_REASON=//p" "$STATE_FILE" | tail -1 | sed 's/\\ / /g' | tr -d "'\"")"
    if [[ "$status" == "degraded" ]]; then
      log "warning: $label is degraded: ${reason:-unknown}"
    fi
  done
}

cleanup_stale_supervisor_lock
if supervisor_alive && supervisor_urls_match; then
  SUPERVISOR_PID="$(supervisor_pid_from_lock)"
  log "reusing existing development supervisor pid=$SUPERVISOR_PID"
else
  if supervisor_alive; then
    log "restarting development supervisor for URL change: $FRONTEND_URL"
  else
    log "stopping existing development AnythingLLM processes..."
  fi
  SERVER_PORT="$SERVER_PORT" COLLECTOR_PORT="$COLLECTOR_PORT" FRONTEND_PORT="$FRONTEND_PORT" bash "$ROOT_DIR/stop-all" --env development --quiet || true
  prepare_storage_dirs
  ensure_env_database
  ensure_auth_database
  run_key_custody_preflight
  launch_supervisor
fi

wait_for_supervisor_state || true

wait_for_port server "$SERVER_PORT" 90 || true
wait_for_port collector "$COLLECTOR_PORT" 60 || true
wait_for_port frontend "$FRONTEND_PORT" 90 || true
wait_for_running_components || true
assert_single_listener server "$SERVER_PORT" || true
assert_single_listener collector "$COLLECTOR_PORT" || true
assert_single_listener frontend "$FRONTEND_PORT" || true
warn_degraded_components

open_or_refresh_frontend "development" "$FRONTEND_URL"

