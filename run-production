#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$ROOT_DIR/.anythingllm-runtime"
LOG_DIR="$RUNTIME_DIR/logs"
STATE_FILE="$RUNTIME_DIR/status-production.env"
SERVER_PORT="${SERVER_PORT:-3001}"
COLLECTOR_PORT="${COLLECTOR_PORT:-8888}"
APP_URL="http://localhost:${SERVER_PORT}"
STORAGE_BASE="${STORAGE_DIR:-$ROOT_DIR/server/storage}"
ENV_STORAGE_ROOT="$STORAGE_BASE/production"
BUILD_STAMP_FILE="$ROOT_DIR/server/public/.anythingllm-build"
OPEN_BROWSER=1

mkdir -p "$LOG_DIR"

log() {
  printf '[run-production] %s\n' "$*" >&2
}

usage() {
  cat <<EOF
Usage: bash ./run-production [--no-open]

Options:
  --no-open   Start services without opening or refreshing a browser tab.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open)
      OPEN_BROWSER=0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

is_port_open() {
  nc -z localhost "$1" >/dev/null 2>&1
}

wait_for_port() {
  local name="$1"
  local port="$2"
  local attempts="${3:-90}"
  local count=0
  while (( count < attempts )); do
    if is_port_open "$port"; then
      log "$name is listening on port $port"
      return 0
    fi
    sleep 1
    count=$((count + 1))
  done
  log "warning: $name did not open port $port within ${attempts}s"
  return 1
}

build_frontend_if_needed() {
  local current_commit
  local bundle_commit

  current_commit="$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || printf 'unknown')"
  bundle_commit="$(sed -n 's/^commit=//p' "$BUILD_STAMP_FILE" 2>/dev/null | head -1 || true)"

  if [[ -f "$ROOT_DIR/server/public/_index.html" ]] &&
    [[ "${FORCE_FRONTEND_BUILD:-0}" != "1" ]] &&
    [[ "$bundle_commit" == "$current_commit" ]]; then
    log "frontend build is current for commit $current_commit"
    return 0
  fi

  if [[ "${FORCE_FRONTEND_BUILD:-0}" == "1" ]]; then
    log "FORCE_FRONTEND_BUILD=1; rebuilding production frontend..."
  elif [[ ! -f "$ROOT_DIR/server/public/_index.html" ]]; then
    log "frontend build not found; building production frontend..."
  elif [[ -z "$bundle_commit" ]]; then
    log "frontend build stamp missing; rebuilding production frontend for commit $current_commit..."
  else
    log "frontend build commit is $bundle_commit; rebuilding for current commit $current_commit..."
  fi

  (
    cd "$ROOT_DIR/frontend"
    VITE_API_BASE=/api yarn build
  )

  log "copying frontend/dist to server/public..."
  rm -rf "$ROOT_DIR/server/public"
  mkdir -p "$ROOT_DIR/server/public"
  rsync -a "$ROOT_DIR/frontend/dist/" "$ROOT_DIR/server/public/"
  {
    printf 'commit=%s\n' "$current_commit"
    printf 'built_at=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'app_env=production\n'
  } >"$BUILD_STAMP_FILE"
  log "production frontend bundle is now stamped for commit $current_commit"
}

prepare_storage_dirs() {
  mkdir -p \
    "$ENV_STORAGE_ROOT/documents" \
    "$ENV_STORAGE_ROOT/direct-uploads" \
    "$ENV_STORAGE_ROOT/reader-documents" \
    "$ENV_STORAGE_ROOT/vector-cache" \
    "$ENV_STORAGE_ROOT/lancedb" \
    "$ENV_STORAGE_ROOT/models" \
    "$ENV_STORAGE_ROOT/tmp"
}

database_has_core_schema() {
  local db_path="$1"
  local table_count

  if [[ ! -f "$db_path" ]] || ! command -v sqlite3 >/dev/null 2>&1; then
    return 1
  fi

  table_count="$(sqlite3 "$db_path" "select count(*) from sqlite_master where type='table' and name in ('_prisma_migrations','system_settings','workspaces','workspace_documents','event_logs');" 2>/dev/null || printf '0')"
  [[ "$table_count" == "5" ]]
}

sqlite_quote() {
  printf "%s" "$1" | sed "s/'/''/g"
}

migration_id() {
  node -e 'console.log(require("crypto").randomUUID())'
}

apply_sqlite_migrations() {
  local db_path="$1"
  local migrations_dir="$ROOT_DIR/server/prisma/migrations"
  local migration_dir
  local migration_name
  local migration_sql
  local applied
  local id
  local checksum

  sqlite3 "$db_path" <<'SQL'
CREATE TABLE IF NOT EXISTS "_prisma_migrations" (
  "id" TEXT PRIMARY KEY NOT NULL,
  "checksum" TEXT NOT NULL,
  "finished_at" DATETIME,
  "migration_name" TEXT NOT NULL,
  "logs" TEXT,
  "rolled_back_at" DATETIME,
  "started_at" DATETIME NOT NULL DEFAULT current_timestamp,
  "applied_steps_count" INTEGER UNSIGNED NOT NULL DEFAULT 0
);
SQL

  for migration_dir in "$migrations_dir"/*; do
    [[ -d "$migration_dir" ]] || continue
    migration_name="$(basename "$migration_dir")"
    migration_sql="$migration_dir/migration.sql"
    [[ -f "$migration_sql" ]] || continue

    applied="$(sqlite3 "$db_path" "select count(*) from \"_prisma_migrations\" where migration_name = '$(sqlite_quote "$migration_name")' and rolled_back_at is null;" 2>/dev/null || printf '0')"
    if [[ "$applied" != "0" ]]; then
      continue
    fi

    log "applying migration $migration_name"
    sqlite3 "$db_path" <"$migration_sql"
    id="$(migration_id)"
    checksum="$(shasum -a 256 "$migration_sql" | awk '{print $1}')"
    sqlite3 "$db_path" "insert into \"_prisma_migrations\" (id, checksum, finished_at, migration_name, started_at, applied_steps_count) values ('$(sqlite_quote "$id")', '$(sqlite_quote "$checksum")', datetime('now'), '$(sqlite_quote "$migration_name")', datetime('now'), 1);"
  done
}

ensure_env_database() {
  local db_path="$ENV_STORAGE_ROOT/anythingllm.db"

  if database_has_core_schema "$db_path"; then
    log "production database schema is ready"
    return 0
  fi

  log "production database schema missing or incomplete; running env-aware SQLite migrations/seed..."
  apply_sqlite_migrations "$db_path"

  (
    cd "$ROOT_DIR/server"
    APP_ENV=production STORAGE_DIR="$STORAGE_BASE" node prisma/seed.js
  )

  if ! database_has_core_schema "$db_path"; then
    log "error: production database schema is still incomplete after migration"
    exit 1
  fi
}

write_state() {
  {
    printf 'APP_ENV=%q\n' "production"
    printf 'SERVER_PORT=%q\n' "$SERVER_PORT"
    printf 'COLLECTOR_PORT=%q\n' "$COLLECTOR_PORT"
    printf 'FRONTEND_PORT=%q\n' ""
    printf 'SERVER_PID=%q\n' "$SERVER_PID"
    printf 'COLLECTOR_PID=%q\n' "$COLLECTOR_PID"
    printf 'FRONTEND_PID=%q\n' ""
    printf 'SERVER_LOG=%q\n' "$SERVER_LOG"
    printf 'COLLECTOR_LOG=%q\n' "$COLLECTOR_LOG"
    printf 'FRONTEND_LOG=%q\n' ""
    printf 'APP_URL=%q\n' "$APP_URL"
    printf 'STARTED_AT=%q\n' "$(date '+%Y-%m-%d %H:%M:%S')"
  } >"$STATE_FILE"
}

start_process() {
  local name="$1"
  local dir="$2"
  local logfile="$3"
  shift 3

  log "starting $name..."
  (
    cd "$dir"
    nohup env \
      APP_ENV=production \
      SERVER_PORT="$SERVER_PORT" \
      COLLECTOR_PORT="$COLLECTOR_PORT" \
      ANYTHINGLLM_STORAGE_BASE_DIR="$STORAGE_BASE" \
      ANYTHINGLLM_ENV_STORAGE_APPLIED=true \
      STORAGE_DIR="$ENV_STORAGE_ROOT" \
      "$@" >"$logfile" 2>&1 &
    echo $!
  )
}

refresh_browser_tab() {
  local browser="$1"
  local url="$2"
  local result
  local status
  local output_file
  local status_file
  local script_pid

  if ! command -v osascript >/dev/null 2>&1; then
    return 1
  fi

  output_file="$(mktemp "${TMPDIR:-/tmp}/anythingllm-osascript-output.XXXXXX")"
  status_file="$(mktemp "${TMPDIR:-/tmp}/anythingllm-osascript-status.XXXXXX")"

  # AppleScript can block on macOS automation permissions; keep it best-effort.
  (
    osascript - "$browser" "$url" >"$output_file" 2>/dev/null <<'OSA'
on normalizeUrl(rawUrl)
  set normalizedUrl to rawUrl as text
  repeat while normalizedUrl ends with "/"
    if (length of normalizedUrl) <= 1 then exit repeat
    set normalizedUrl to text 1 thru -2 of normalizedUrl
  end repeat
  return normalizedUrl
end normalizeUrl

on run argv
  set browserName to item 1 of argv
  set targetUrl to item 2 of argv
  set normalizedTargetUrl to my normalizeUrl(targetUrl)

  if browserName is "Google Chrome" then
    if application "Google Chrome" is not running then return "not-running"
    tell application "Google Chrome"
      repeat with windowIndex from 1 to count of windows
        set candidateWindow to window windowIndex
        repeat with tabIndex from 1 to count of tabs of candidateWindow
          set candidateTab to tab tabIndex of candidateWindow
          if my normalizeUrl(URL of candidateTab) is normalizedTargetUrl then
            set active tab index of candidateWindow to tabIndex
            set index of candidateWindow to 1
            activate
            reload candidateTab
            return "reloaded"
          end if
        end repeat
      end repeat
    end tell
  else if browserName is "Safari" then
    if application "Safari" is not running then return "not-running"
    tell application "Safari"
      repeat with windowIndex from 1 to count of windows
        set candidateWindow to window windowIndex
        repeat with tabIndex from 1 to count of tabs of candidateWindow
          set candidateTab to tab tabIndex of candidateWindow
          if my normalizeUrl(URL of candidateTab) is normalizedTargetUrl then
            set current tab of candidateWindow to candidateTab
            set index of candidateWindow to 1
            activate
            do JavaScript "window.location.reload()" in candidateTab
            return "reloaded"
          end if
        end repeat
      end repeat
    end tell
  end if

  return "not-found"
end run
OSA
    printf '%s' "$?" >"$status_file"
  ) &
  script_pid=$!

  for _ in {1..40}; do
    if [[ -s "$status_file" ]]; then break; fi
    sleep 0.1
  done

  if [[ ! -s "$status_file" ]]; then
    kill "$script_pid" >/dev/null 2>&1 || true
    wait "$script_pid" >/dev/null 2>&1 || true
    rm -f "$output_file" "$status_file"
    return 1
  fi

  wait "$script_pid" >/dev/null 2>&1 || true
  status="$(cat "$status_file" 2>/dev/null || printf '1')"
  result="$(cat "$output_file" 2>/dev/null || true)"
  rm -f "$output_file" "$status_file"

  [[ "$status" == "0" && "$result" == "reloaded" ]]
}

open_or_refresh_frontend() {
  local app_env="$1"
  local url="$2"

  printf '\nAPP_ENV=%s\nURL=%s\n' "$app_env" "$url"

  if [[ "$OPEN_BROWSER" != "1" ]]; then
    log "browser open skipped (--no-open)"
    return 0
  fi

  if [[ "$(uname -s)" != "Darwin" ]] || ! command -v open >/dev/null 2>&1; then
    log "automatic browser open is only supported on macOS with open; visit $url"
    return 0
  fi

  if refresh_browser_tab "Google Chrome" "$url"; then
    log "refreshed existing Google Chrome tab: $url"
    return 0
  fi

  if refresh_browser_tab "Safari" "$url"; then
    log "refreshed existing Safari tab: $url"
    return 0
  fi

  log "opening browser: $url"
  open "$url" >/dev/null 2>&1 || log "warning: failed to open browser for $url"
}

SUPERVISOR_LOCK_DIR="$RUNTIME_DIR/supervisor-production.lock"
SUPERVISOR_LOG="$LOG_DIR/production-supervisor.log"
SERVER_LOG="$LOG_DIR/production-server.log"
COLLECTOR_LOG="$LOG_DIR/production-collector.log"

supervisor_pid_from_lock() {
  cat "$SUPERVISOR_LOCK_DIR/pid" 2>/dev/null || true
}

supervisor_alive() {
  local pid
  pid="$(supervisor_pid_from_lock)"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

cleanup_stale_supervisor_lock() {
  if [[ -d "$SUPERVISOR_LOCK_DIR" ]] && ! supervisor_alive; then
    log "removing stale supervisor lock: $SUPERVISOR_LOCK_DIR"
    rm -rf "$SUPERVISOR_LOCK_DIR"
  fi
}

launch_supervisor() {
  log "starting production supervisor..."
  : >"$SUPERVISOR_LOG"
  nohup env \
    APP_ENV=production \
    SERVER_PORT="$SERVER_PORT" \
    COLLECTOR_PORT="$COLLECTOR_PORT" \
    STORAGE_DIR="$STORAGE_BASE" \
    bash "$ROOT_DIR/scripts/runtime-supervisor.sh" --env production \
    >/dev/null 2>&1 &
  SUPERVISOR_PID="$!"
  sleep 0.75
  if ! kill -0 "$SUPERVISOR_PID" >/dev/null 2>&1; then
    log "error: production supervisor exited during startup. Last log lines:"
    tail -n 80 "$SUPERVISOR_LOG" >&2 2>/dev/null || true
    exit 1
  fi
}

wait_for_supervisor_state() {
  local attempts=20
  local count=0
  while (( count < attempts )); do
    if [[ -f "$STATE_FILE" ]] && grep -q '^SUPERVISOR_PID=' "$STATE_FILE"; then
      return 0
    fi
    sleep 0.25
    count=$((count + 1))
  done
  log "warning: supervisor state file was not written within 5s"
  return 1
}

warn_degraded_components() {
  local component
  local label
  local status
  local reason

  [[ -f "$STATE_FILE" ]] || return 0
  for component in SERVER COLLECTOR; do
    label="$(printf '%s' "$component" | tr '[:upper:]' '[:lower:]')"
    status="$(sed -n "s/^${component}_STATUS=//p" "$STATE_FILE" | tail -1 | tr -d "'\"")"
    reason="$(sed -n "s/^${component}_LAST_RESTART_REASON=//p" "$STATE_FILE" | tail -1 | sed 's/\\ / /g' | tr -d "'\"")"
    if [[ "$status" == "degraded" ]]; then
      log "warning: $label is degraded: ${reason:-unknown}"
    fi
  done
}

cleanup_stale_supervisor_lock
if supervisor_alive; then
  SUPERVISOR_PID="$(supervisor_pid_from_lock)"
  log "reusing existing production supervisor pid=$SUPERVISOR_PID"
else
  log "stopping existing production AnythingLLM processes..."
  SERVER_PORT="$SERVER_PORT" COLLECTOR_PORT="$COLLECTOR_PORT" bash "$ROOT_DIR/stop-all" --env production --quiet || true
  build_frontend_if_needed
  prepare_storage_dirs
  ensure_env_database
  launch_supervisor
fi

wait_for_supervisor_state || true

wait_for_port server "$SERVER_PORT" 90 || true
wait_for_port collector "$COLLECTOR_PORT" 60 || true
warn_degraded_components

open_or_refresh_frontend "production" "$APP_URL"

cat <<EOF

Production environment is running.
APP_ENV: production
URL:     $APP_URL
Bundle:  $(sed -n 's/^commit=//p' "$BUILD_STAMP_FILE" 2>/dev/null | head -1 || printf 'unknown')

Logs:
supervisor: $SUPERVISOR_LOG
server:    $SERVER_LOG
collector: $COLLECTOR_LOG

Useful commands:
bash ./status
bash ./stop-all --env production
EOF
