{
  "name": "vector-knowledge-desktop",
  "version": "2.1.2",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:browser-egress-core": "node scripts/run-browser-egress-core-prep.cjs",
    "prepare:desktop": "node prepare-desktop.cjs",
    "icon:generate": "python3 scripts/generate-icon-assets.py",
    "test": "node --test tests/*.test.cjs",
    "security:audit": "node scripts/security-config-audit.cjs",
    "start": "electron .",
    "dist:win": "npm run prepare:browser-egress-core -- --platforms=win32-x64 && npm run prepare:desktop && electron-builder --win nsis --x64",
    "dist:mac": "npm run prepare:browser-egress-core -- --platforms=darwin-arm64,darwin-x64 && npm run prepare:desktop && electron-builder --mac dmg zip --arm64 --x64"
  },
  "devDependencies": {
    "electron": "42.7.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.shijie.vector-knowledge",
    "productName": "向量知识库",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "**/*",
          "!build/**/*"
        ]
      },
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!storage/**/*",
          "!*.env",
          "!*.env.*",
          "!node_modules/.cache/**/*"
        ]
      },
      {
        "from": "../collector",
        "to": "collector",
        "filter": [
          "**/*",
          "!hotdir/**/*",
          "!*.env",
          "!*.env.*",
          "!node_modules/.cache/**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "向量知识库",
      "differentialPackage": true
    }
  }
}
